+    view.sync_live_activity(&[], vec!["live".to_owned()]);
+    view.sync_live_activity_tail(60, key, false, lines);
+    view.jump_to_entry(&[], 0);
+    view.disclosure.focused = Some(vec!["live".to_owned()]);
+    for _ in 0..3 {
+        view.handle_disclosure_key(KeyCode::Enter.into(), &[]);
+        let expanded = view.sync_live_activity(&[], vec!["live".to_owned()]);
