+#[test]
+fn codux_batched_scroll_matches_individually_painted_rows() {
+    crate::mycodx_ui::with_settings(Settings::comparison(), || {
+        let cells = vec![user("Question"), answer(&"answer line\n".repeat(60))];
+        let area = Rect::new(0, 0, 80, 16);
+        let mut painted = TranscriptView::default();
+        let mut batched = TranscriptView::default();
+        let mut expected = Buffer::empty(area);
+        let mut actual = Buffer::empty(area);
+        for view in [&mut painted, &mut batched] {
+            view.render(area, &mut actual, &cells);
+            view.handle_key(KeyCode::F(4).into(), &cells);
+            view.handle_key(KeyCode::Home.into(), &cells);
+            view.render(area, &mut actual, &cells);
+        }
+        for code in [KeyCode::Down, KeyCode::Up] {
+            for _ in 0..8 {
+                painted.handle_key(code.into(), &cells);
+                painted.render(area, &mut expected, &cells);
+                batched.handle_key(code.into(), &cells);
+            }
+            batched.render(area, &mut actual, &cells);
+            assert_eq!(actual, expected, "{code:?} coalesced rendering");
+            assert_eq!(batched.position, painted.position);
+            let bookmark = batched.bookmark(&cells);
+            let focused = batched.disclosure.focused.clone();
+            batched.jump_to_latest();
+            batched.render(area, &mut actual, &cells);
+            batched.restore_bookmark(bookmark);
+            // Bookmarks restore reading geometry; the navigation owner retains focus.
+            batched.disclosure.focused = focused;
+            batched.render(area, &mut actual, &cells);
+            assert_eq!(actual, expected, "{code:?} restored scroll origin");
+        }
+    });
+}
