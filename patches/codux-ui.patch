+fn codux_working_wheel_reaches_old_questions_while_live_progress_grows() {
+    use crossterm::event::{MouseEvent, MouseEventKind};
+    for (joined, changing_height) in [(false, false), (true, false), (false, true), (true, true)] {
+        crate::mycodx_ui::with_settings(Settings::web(), || {
+            let mut cells = vec![
+                user("Oldest question"),
+                answer(&"old answer paragraph\n\n".repeat(25)),
+                user("Current question"),
+            ];
+            if joined {
+                cells.push(progress(&"retained progress paragraph\n\n".repeat(25)));
+            }
+            let mut area = Rect::new(0, 0, 60, 20);
+            let mut view = TranscriptView::default();
+            let mut buf = Buffer::empty(area);
+            view.set_mycodx_stream(true);
+            view.set_mycodx_stream_section(Section::Intermediate);
+            view.set_mycodx_stream_id(Some("mycodx-message:growing".into()));
+            for step in 0..350 {
+                // Working/status rows can grow or shrink while an input-triggered
+                // redraw refreshes the transcript above the composer.
+                area.height = if changing_height && step % 2 == 0 {
+                    16
+                } else {
+                    20
+                };
+                view.sync_mycodx_turn(&cells, true);
+                let expanded = view.sync_live_activity(&cells, vec![]);
+                view.sync_live_activity_tail(
+                    60,
+                    Some(ActiveCellTranscriptKey {
+                        cacheable: true,
+                        revision: step + 1,
+                        is_stream_continuation: false,
+                        animation_tick: None,
+                    }),
+                    expanded,
+                    |_| {
+                        Some(ActivityTranscriptLines {
+                            activity: (0..30 + step as usize / 5)
+                                .map(|n| format!("live progress row {n}").into())
+                                .collect(),
+                            auxiliary: vec![],
+                            disclosure: None,
+                        })
+                    },
+                );
+                view.render(area, &mut buf, &cells);
+                if step > 0 && view.visible.first().is_some_and(|row| row.index == 0) {
+                    return;
+                }
+                view.handle_mouse(
+                    MouseEvent {
+                        kind: MouseEventKind::ScrollUp,
