+#[test]
+fn preview_drag_copies_on_release_and_failure_keeps_selection() {
+    use crate::transcript_view::ViewAction;
+    use crate::transcript_view::tests::{cell, render};
+    use crossterm::event::{KeyEvent, MouseButton, MouseEvent, MouseEventKind};
+    let cells = vec![cell("selected text")];
+    let mut view = TranscriptView {
+        copy_on_select: true,
+        ..Default::default()
+    };
+    render(&mut view, &cells, 30, 2);
+    let mouse = |kind, column| MouseEvent {
+        kind,
+        column,
+        row: 0,
+        modifiers: KeyModifiers::NONE,
+    };
+    for event in [
+        mouse(MouseEventKind::Down(MouseButton::Left), 0),
+        mouse(MouseEventKind::Drag(MouseButton::Left), 5),
+    ] {
+        let action = view.handle_mouse(event, &cells).unwrap();
+        assert!(
+            preview_copy(&mut view, &cells, &action, |_| panic!(
+                "copy only on release"
+            ))
+            .is_none()
+        );
+    }
+    let action = view
+        .handle_mouse(mouse(MouseEventKind::Up(MouseButton::Left), 8), &cells)
+        .unwrap();
+    let mut copied = String::new();
+    let status = preview_copy(&mut view, &cells, &action, |text| {
+        copied = text.into();
+        Ok(())
+    })
+    .unwrap();
+    std::assert_eq!(copied, "selected");
+    assert!(status.starts_with("Copied"));
+    assert!(view.has_selection_range());
+    let key = KeyEvent::new(KeyCode::Char('c'), KeyModifiers::CONTROL);
+    assert!(!preview_exit_key(key, view.has_selection_range()));
+    let action = ViewAction::Copy(view.selected_text(&cells).unwrap());
+    let status = preview_copy(&mut view, &cells, &action, |_| {
+        Err("clipboard locked".into())
+    })
+    .unwrap();
+    assert!(status.contains("Copy failed"));
+    assert!(view.has_selection_range());
+    preview_copy(&mut view, &cells, &action, |_| Ok(())).unwrap();
+    assert!(!view.has_selection_range());
+    assert!(preview_exit_key(key, false));
+}
