 use crossterm::event::MouseEvent;
 use crossterm::event::MouseEventKind;
 use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn codux_working_body_wheel_reaches_previous_turn_through_composer_routing() -> Result<()> {
+    let mut app = crate::app::test_support::make_test_app().await;
+    let thread_id = ThreadId::new();
+    attach_thread(&mut app, thread_id);
+    app.chat_widget.handle_server_notification(
+        ServerNotification::TurnStarted(TurnStartedNotification {
+            thread_id: thread_id.to_string(),
+            turn: Turn {
+                id: "scrolling-turn".into(),
+                root_turn_id: None,
+                items_view: TurnItemsView::Full,
+                items: vec![],
+                status: TurnStatus::InProgress,
+                error: None,
+                started_at: None,
+                completed_at: None,
+                duration_ms: None,
+            },
+        }),
+        None,
+    );
+    app.transcript_cells = vec![
+        super::tests::user_cell("Oldest visible question"),
+        Arc::new(crate::history_cell::AgentMarkdownCell::new(
+            "previous answer paragraph\n\n".repeat(30),
+            std::path::Path::new("."),
+        )),
+        super::tests::user_cell("Current question"),
+    ];
+    crate::chatwidget::tests::helpers::set_active_cell(
+        &mut app.chat_widget,
+        Box::new(
+            crate::history_cell::AgentMarkdownCell::new(
+                "current intermediate paragraph\n\n".repeat(30),
+                std::path::Path::new("."),
+            )
+            .with_mycodx_final_answer(false)
+            .with_mycodx_id(Some("mycodx-message:working-wheel".into())),
+        ),
+    );
+    let mut server = Box::pin(crate::start_embedded_app_server_for_picker(&app.config)).await?;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    tui.set_owned_screen(true)?;
+    let size = Size::new(80, 24);
+    app.render_owned_transcript(&mut tui, size)?;
+    let mut reached_oldest = false;
+    for _ in 0..250 {
+        assert!(app.chat_widget.is_agent_turn_running());
+        app.handle_owned_transcript_event(
+            &mut tui,
+            &mut server,
+            &TuiEvent::Mouse(MouseEvent {
+                kind: MouseEventKind::ScrollUp,
+                column: 30,
+                row: 6,
+                modifiers: KeyModifiers::NONE,
+            }),
+        )?;
+        app.render_owned_transcript(&mut tui, size)?;
+        let buffer = crate::custom_terminal::test_support::last_rendered_buffer(&tui.terminal);
+        if super::tests::buffer_text(buffer).contains("Oldest visible question") {
+            reached_oldest = true;
+            break;
+        }
+    }
+    server.shutdown().await?;
+    tui.set_owned_screen(false)?;
+    assert!(
+        reached_oldest,
+        "working body scroll never reached the previous turn"
+    );
+    Ok(())
+}
