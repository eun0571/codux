--- /dev/null
+++ b/codex-rs/tui/src/transcript_view/search_scope.rs
@@ -0,0 +1,81 @@
+//! Find filters use the same message classification as cards, independently of visibility.
+use super::*;
+use crate::mycodx_ui::Section;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(super) enum SearchScope {
+    All,
+    Questions,
+    Tools,
+    Intermediate,
+    Answers,
+}
+
+impl SearchScope {
+    pub(super) fn cycle(self, backwards: bool) -> Self {
+        const ORDER: [SearchScope; 5] = [
+            SearchScope::All,
+            SearchScope::Questions,
+            SearchScope::Tools,
+            SearchScope::Intermediate,
+            SearchScope::Answers,
+        ];
+        let index = ORDER.iter().position(|scope| *scope == self).unwrap_or(0);
+        ORDER[(index + if backwards { ORDER.len() - 1 } else { 1 }) % ORDER.len()]
+    }
+
+    pub(super) fn label(self) -> &'static str {
+        match self {
+            Self::All => "All",
+            Self::Questions => "Questions/replies",
+            Self::Tools => "Tools",
+            Self::Intermediate => "Intermediate",
+            Self::Answers => "Final answers",
+        }
+    }
+
+    fn includes(self, section: Option<Section>) -> bool {
+        match self {
+            Self::All => true,
+            Self::Questions => matches!(section, Some(Section::Questions | Section::Replies)),
+            Self::Tools => section == Some(Section::Tools),
+            Self::Intermediate => section == Some(Section::Intermediate),
+            Self::Answers => section == Some(Section::Answers),
+        }
+    }
+}
+
+impl TranscriptView {
+    pub(in crate::transcript_view) fn live_search_section(&self) -> Section {
+        if self.mycodx_stream {
+            self.mycodx_stream_section
+        } else {
+            Section::Tools
+        }
+    }
+
+    pub(super) fn matches_search_scope(
+        &self,
+        cells: &[Arc<dyn HistoryCell>],
+        anchor: Anchor,
+    ) -> bool {
+        if self.search.scope == SearchScope::All {
+            return true;
+        }
+        let section = if anchor.key == EntryKey::Live {
+            Some(self.snapshot().map_or_else(
+                || self.live_search_section(),
+                |snapshot| snapshot.search_live_section,
+            ))
+        } else {
+            // This also handles plan answers and earlier final candidates that have
+            // become intermediate messages after a later final answer arrives.
+            mycodx::section_at(cells, anchor.index)
+        };
+        self.search.scope.includes(section)
+    }
+}
+
+#[cfg(test)]
