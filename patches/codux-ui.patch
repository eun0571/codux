+            let frame = painted(&layout, 40);
+            // Half-row padding is drawn with source-free lower/upper block glyphs.
+            let rows: Vec<_> = frame.split('\n').collect();
+            assert_eq!(rows.len(), layout.row_count());
+            let top = rows[0].trim_end();
+            let bottom = rows.last().unwrap().trim_end();
+            assert!(!top.is_empty());
+            assert_eq!(top.chars().count(), bottom.chars().count());
+            assert!(top.chars().all(|c| c == '▄'));
+            assert!(bottom.chars().all(|c| c == '▀'));
+            assert!(!layout.text().contains(['▄', '▀']));
+            assert_eq!(layout.disclosure_row(), Some(1));
+            assert!(rows[1].starts_with(" ["));
+            assert!(rows[1].contains("1 action"));
+            if expanded {
+                assert!(rows[2].starts_with(" Ran one"));
+                assert_eq!(layout.column_for_offset(0), 1);
+                assert_eq!(layout.text(), "Ran one");
+            }
+            let resized = layout.rewrap(25);
+            assert_eq!(resized.disclosure_row(), Some(1));
+            assert!(!painted(&resized, 25).contains('╯'));
+        }
+    });
