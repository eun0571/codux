+fn mycodx_active_fill_survives_clipping_and_preserves_links_and_auxiliary_rows() {
+    crate::mycodx_ui::with_settings(Settings::comparison(), || {
+        let style = crate::mycodx_ui::current()
+            .change_card(Section::Answers, |c| {
+                c.background = Background::None;
+                c.padding_y = 3;
+            })
+            .card(Section::Answers);
+        let url = "https://example.com/test";
+        let lines = crate::terminal_hyperlinks::annotate_web_urls(vec![
+            Line::from(url),
+            Line::from("another line"),
+        ]);
+        let active_bg = crate::mycodx_ui::style::color(style.colors_for(true).bg);
+        let layout = TextLayout::new(lines, style.content_width(60))
+            .with_message_card(60, style, true, true, true)
+            .with_mycodx_auxiliary(plain_hyperlink_lines(vec![Line::from("warning")]), 60);
+        for width in [12, 60] {
+            let layout = layout.rewrap(width);
+            let area = Rect::new(0, 0, width, layout.row_count() as u16);
+            let mut full = Buffer::empty(area);
+            layout.render_active(area, &mut full, 0, true);
+            for start in 0..layout.row_count() {
+                let clip = Rect::new(0, 0, width, 1);
+                let mut single = Buffer::empty(clip);
+                layout.render_active(clip, &mut single, start, true);
+                for x in 0..width {
+                    assert_eq!(full[(x, start as u16)], single[(x, 0)]);
+                }
+            }
+            let row = layout.row_for_offset(0);
+            let col = layout.column_for_offset(0);
+            assert_eq!(layout.link_at(row, col).as_deref(), Some(url));
+            assert!(!layout.mycodx_background_at_state(row, col, true));
+            assert!(!layout.mycodx_background_at_state(row, 0, false));
+            assert!(layout.mycodx_background_at_state(row, 0, true));
+            let warning = layout.row_for_offset(layout.text().find("warning").unwrap());
+            assert_ne!(full[(0, warning as u16)].bg, active_bg);
+            assert!(layout.text().contains(url));
+        }
+    });
