diff --git a/codex-rs/tui/src/terminal_probe/codux_graphics.rs b/codex-rs/tui/src/terminal_probe/codux_graphics.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/tui/src/terminal_probe/codux_graphics.rs
@@ -0,0 +1,94 @@
+//! Reuse the bounded startup probe; never query terminal input from a render pass.
+use std::ops::Range;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+static SIXEL: AtomicBool = AtomicBool::new(false);
+
+pub(crate) fn supported() -> bool {
+    SIXEL.load(Ordering::Relaxed)
+}
+
+pub(super) fn record(input: &[u8]) {
+    SIXEL.store(advertised(input) == Some(true), Ordering::Relaxed);
+}
+
+/// DA1 option 4 advertises Sixel. Ignore complete and unfinished bracketed pastes.
+pub(super) fn response_ranges(input: &[u8]) -> Vec<Range<usize>> {
+    let mut ranges = Vec::new();
+    let mut cursor = 0;
+    while cursor < input.len() {
+        if input[cursor..].starts_with(b"\x1b[200~") {
+            let start = cursor + 6;
+            let Some(end) = input[start..].windows(6).position(|s| s == b"\x1b[201~") else {
+                break;
+            };
+            cursor = start + end + 6;
+            continue;
+        }
+        if input[cursor..].starts_with(b"\x1b[?") {
+            let start = cursor + 3;
+            let body = &input[start..input.len().min(start + 64)];
+            let count = body
+                .iter()
+                .take_while(|b| b.is_ascii_digit() || **b == b';')
+                .count();
+            if count > 0
+                && body.get(count) == Some(&b'c')
+                && body[..count]
+                    .split(|b| *b == b';')
+                    .all(|part| !part.is_empty())
+            {
+                let end = start + count + 1;
+                ranges.push(cursor..end);
+                cursor = end;
+                continue;
+            }
+        }
+        cursor += 1;
+    }
+    ranges
+}
+
+pub(super) fn advertised(input: &[u8]) -> Option<bool> {
+    let range = response_ranges(input).into_iter().next()?;
+    Some(
+        input[range.start + 3..range.end - 1]
+            .split(|b| *b == b';')
+            .skip(1)
+            .any(|option| option == b"4"),
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn codux_graphics_requires_an_advertised_capability() {
+        assert_eq!(advertised(b"\x1b[?62;4;6;22c"), Some(true));
+        assert_eq!(advertised(b"\x1b[?62;6;22c"), Some(false));
+        assert_eq!(advertised(b"\x1b[?4c"), Some(false));
+        for value in [b"".as_slice(), b"\x1b[?62;4", b"\x1b[?62;;4c", b"\x1b[?4u"] {
+            assert_eq!(advertised(value), None);
+        }
+    }
+
+    #[test]
+    fn codux_graphics_preserves_paste_and_interleaved_input() {
+        let paste = b"\x1b[200~first\r\n\x1b[?62;4c\r\nlast\x1b[201~";
+        assert_eq!(advertised(paste), None);
+        assert_eq!(advertised(b"\x1b[200~\x1b[?62;4c"), None);
+        let mut input = b"typed".to_vec();
+        input.extend_from_slice(paste);
+        input.extend_from_slice(b"\x1b[?62;4cnext");
+        let ranges = response_ranges(&input);
+        let remaining: Vec<_> = input
+            .iter()
+            .enumerate()
+            .filter(|(index, _)| !ranges.iter().any(|range| range.contains(index)))
+            .map(|(_, byte)| *byte)
+            .collect();
+        assert_eq!(remaining, [b"typed".as_slice(), paste, b"next"].concat());
+        assert_eq!(advertised(&input), Some(true));
+    }
+}
