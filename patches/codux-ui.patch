+fn mycodx_message_cards_fold_to_source_line_without_control_labels() {
+    crate::mycodx_ui::with_settings(Settings::comparison(), || {
+        let mut reply = crate::history_cell::new_user_prompt(
+            "reply first\nreply hidden".into(),
+            vec![],
+            vec![],
+            vec![],
+        );
+        reply.mycodx_reply = true;
+        for (cell, first, hidden) in [
+            (
+                user("prompt first\nprompt hidden"),
+                "prompt first",
+                "prompt hidden",
+            ),
+            (
+                Arc::new(reply) as Arc<dyn HistoryCell>,
+                "reply first",
+                "reply hidden",
+            ),
+            (
+                progress("progress first\n\nprogress hidden"),
+                "progress first",
+                "progress hidden",
+            ),
+            (
+                answer("answer first\n\nanswer hidden"),
+                "answer first",
+                "answer hidden",
+            ),
+        ] {
+            let expanded = message_layout(&cell, 80, true).unwrap();
+            let folded = message_layout(&cell, 80, false).unwrap();
+            assert!(painted(&expanded, 80).contains(hidden));
+            assert!(painted(&expanded, 80).contains('▾'));
+            assert!(painted(&folded, 80).contains('▸'));
+            assert!(painted(&folded, 80).contains(first));
+            assert!(!painted(&folded, 80).contains(hidden));
+            assert_eq!(folded.text(), expanded.text());
+            for layout in [&expanded, &folded] {
+                assert_eq!(layout.disclosure_row(), None);
+                assert!(layout.disclosure);
+                assert!(layout.mycodx_focusable());
+                let frame = painted(layout, 80);
+                assert!(!frame.contains("[+]"));
+                assert!(!frame.contains("[-]"));
+                assert!(!frame.contains(" lines"));
+                assert!(!layout.text().contains(['▸', '▾']));
+            }
+            for width in [1, 4, 16, 100] {
+                let resized = folded.rewrap(width);
+                assert_eq!(resized.text(), expanded.text());
+                assert!(!painted(&resized, width).contains(hidden));
+                let row = resized.row_for_offset(0);
+                assert_eq!(resized.position_at(row, resized.column_for_offset(0)), 0);
+            }
+            let cells = vec![cell];
+            let mut view = TranscriptView::default();
+            view.area = Rect::new(0, 0, 80, 30);
+            view.disclosure.focused = Some(view.activity_ids(&cells, 0));
+            view.handle_disclosure_key(KeyCode::Enter.into(), &cells);
+            assert!(!view.mycodx_expanded(&cells, 0));
+            assert!(!painted(&view.current_layout(&cells, 0).unwrap(), 80).contains(hidden));
+            view.handle_disclosure_key(KeyCode::Enter.into(), &cells);
+            assert!(painted(&view.current_layout(&cells, 0).unwrap(), 80).contains(hidden));
+        }
+    });
+}
