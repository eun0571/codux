+fn codux_left_yields_to_composer_but_keeps_selection_and_search_ownership() {
+    crate::mycodx_ui::with_settings(Settings::comparison(), || {
+        let cells = vec![user("question"), answer("answer text")];
+        let area = Rect::new(0, 0, 80, 12);
+        let mut view = TranscriptView::default();
+        view.render(area, &mut Buffer::empty(area), &cells);
+        view.handle_key(KeyCode::F(4).into(), &cells);
+        let focused = view.disclosure.focused.clone();
+        let position = view.position;
+        assert!(!view.owns_interaction_key(KeyCode::Left.into()));
+        assert!(view.handle_key(KeyCode::Left.into(), &cells).is_none());
+        assert_eq!(view.disclosure.focused, focused);
+        assert_eq!(view.position, position);
+        let move_card = KeyEvent::new(KeyCode::Left, KeyModifiers::CONTROL);
+        assert!(view.owns_interaction_key(move_card));
+        assert!(view.handle_key(move_card, &cells).is_some());
+
+        // A search edit keeps its own caret; Left must not open agents underneath it.
+        view.begin_search();
+        view.paste_search("answer");
+        assert!(view.handle_key(KeyCode::Left.into(), &cells).is_some());
+        assert!(view.is_search_editing());
+        view.cancel_search();
+
+        // A mouse text selection keeps Left for moving the selection endpoint.
+        view.render(area, &mut Buffer::empty(area), &cells);
+        let (row, visible) = view
+            .visible
+            .iter()
+            .enumerate()
+            .find(|(_, visible)| visible.row == visible.layout.row_for_offset(0))
+            .unwrap();
+        let x = view.area.x + visible.layout.column_for_offset(0);
+        let y = view.area.y + row as u16;
+        view.begin_selection(&cells, x, y, 1);
+        view.extend_selection(x + 4, y);
+        view.end_drag();
+        assert!(view.has_selection_range());
+        assert!(view.owns_interaction_key(KeyCode::Left.into()));
+        assert!(view.handle_key(KeyCode::Left.into(), &cells).is_some());
+        view.end_selection(&cells);
+
+        assert!(view.begin_select_mode(&cells));
+        assert!(view.owns_interaction_key(KeyCode::Left.into()));
+        assert!(view.handle_key(KeyCode::Left.into(), &cells).is_some());
+    });
+}
