+    fn mycodx_ui_theme_uses_live_palette_and_preserves_settings_on_preview_cancel_and_save() {
+        use crate::render::highlight;
+        struct Restore(syntect::highlighting::Theme);
+        impl Drop for Restore {
+            fn drop(&mut self) {
+                highlight::set_syntax_theme(self.0.clone());
+            }
+        }
+        let _restore = Restore(highlight::current_syntax_theme());
+        with_settings(Settings::web(), || {
+            let home = tempfile::tempdir().unwrap();
+            let original = current();
+            save(home.path(), original.clone()).unwrap();
+            let before = std::fs::read(home.path().join("codux-ui.json")).unwrap();
+            let (raw, mut rx) = tokio::sync::mpsc::unbounded_channel();
+            let tx = AppEventSender::new(raw);
+            highlight::set_syntax_theme(highlight::resolve_theme_by_name("dracula", None).unwrap());
+            let dark_syntax = highlight::current_syntax_theme();
+            let params = page_picker(home.path(), Page::Theme).unwrap();
+            assert_eq!(params.items.len(), 19);
+            assert_eq!(params.items[0].name, "Dracula (recommended)");
+            assert_eq!(params.items[1].name, "Default");
+            assert!(params.items.iter().all(|item| item.description.is_some()));
+            assert_eq!(params.side_content.desired_height(80), 0);
+            let first = current();
+            assert_ne!(first, original);
+            let mut picker = ListSelectionView::new(
+                params,
+                tx.clone(),
+                crate::keymap::RuntimeKeymap::defaults().list,
+            );
+            press(&mut picker, KeyCode::Down);
+            assert_ne!(current(), first);
+            press(&mut picker, KeyCode::Esc);
+            assert_eq!(current(), original);
+            assert_eq!(highlight::current_syntax_theme(), dark_syntax);
+            assert_eq!(
+                std::fs::read(home.path().join("codux-ui.json")).unwrap(),
+                before
+            );
+            while rx.try_recv().is_ok() {}
+
+            // Reopening uses a later /theme selection, not the startup override.
+            highlight::set_syntax_theme(
+                highlight::resolve_theme_by_name("catppuccin-latte", None).unwrap(),
+            );
+            let light_syntax = highlight::current_syntax_theme();
+            let mut picker = view(home.path(), Page::Theme, &tx);
+            assert_ne!(current(), first);
+            let expected = current();
+            press(&mut picker, KeyCode::Enter);
+            let AppEvent::MycodxUiSelected {
+                settings,
+                previous,
+                return_to,
+            } = rx.try_recv().unwrap()
+            else {
+                panic!("expected theme apply");
+            };
+            assert_eq!(previous, original);
+            assert_eq!(settings, expected);
+            assert_eq!(return_to, Page::Root);
+            save(home.path(), settings).unwrap();
+            load(home.path()).unwrap();
+            assert_eq!(current(), expected);
+            assert_eq!(highlight::current_syntax_theme(), light_syntax);
+        });
