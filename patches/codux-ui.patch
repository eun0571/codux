+    for unseen in [false, true] {
+        view.unseen_activity = unseen;
+        for width in [80, 40, 26, 16, 3] {
+            let buffer = paint(&mut view, &cells, width);
+            let label = view
+                .follow_control_label(width)
+                .expect("visible return control");
+            assert!(!label.contains("esc"));
+            if width == 80 {
+                assert!(label.contains("ctrl+end"));
+            }
+            let area = view.follow_control.area.expect("click target");
+            assert!(area.right() <= buffer.area.right());
+        }
+    }
+    view.handle_key(KeyEvent::new(KeyCode::End, KeyModifiers::CONTROL), &cells);
+    assert!(view.is_following());
+    paint(&mut view, &cells, 80);
+    assert!(view.follow_control.area.is_none());
