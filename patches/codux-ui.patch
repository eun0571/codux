+fn mycodx_live_stream_and_final_card_preserve_header_and_completion_boundary() {
+    let stream = live_layout(
+        ActivityTranscriptLines {
+            activity: vec!["still writing".into()],
+            auxiliary: Vec::new(),
+            disclosure: None,
+        },
+        40,
+        0,
+        true,
+        true,
+        false,
+    );
+    assert!(!painted(&stream, 40).contains("CODEX"));
+    assert!(!painted(&stream, 40).contains('╰'));
+    let completed = message_layout(&answer("still writing"), 40, true).unwrap();
+    assert!(painted(&completed, 40).contains("CODEX"));
+    assert!(completed.row_count() > stream.row_count());
+    assert_eq!(completed.text(), stream.text());
+}
