+#[tokio::test]
+async fn codux_working_survives_plan_streaming_and_clears_at_turn_termination() {
+    for termination in ["complete", "interrupt", "error"] {
+        let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(None).await;
+        chat.set_mycodx_stream_cards(true);
+        chat.set_feature_enabled(Feature::CollaborationModes, true);
+        let plan_mask =
+            collaboration_modes::mask_for_kind(chat.model_catalog.as_ref(), ModeKind::Plan)
+                .expect("plan collaboration mask");
+        chat.set_collaboration_mask(plan_mask);
+        chat.on_task_started();
+
+        chat.on_plan_delta("- Step 1".to_string());
+        assert!(chat.bottom_pane.status_indicator_visible());
+        chat.on_plan_delta("\n".to_string());
+        chat.on_commit_tick();
+        drain_insert_history(&mut rx);
+        assert!(chat.bottom_pane.status_indicator_visible());
+        chat.on_plan_item_completed("- Step 1\n".to_string());
+        assert!(chat.bottom_pane.status_indicator_visible());
+
+        match termination {
+            "complete" => chat.on_task_complete(None, None, false),
+            "interrupt" => chat.on_interrupted_turn(TurnAbortReason::Interrupted),
+            _ => chat.on_server_overloaded_error("Server overloaded".to_string()),
+        }
+        assert!(!chat.bottom_pane.is_task_running());
+        assert!(!chat.bottom_pane.status_indicator_visible());
+        chat.on_commit_tick();
+        chat.set_mycodx_stream_cards(false);
+        chat.set_mycodx_stream_cards(true);
+        assert!(!chat.bottom_pane.status_indicator_visible());
+    }
+}
+
+#[tokio::test]
+async fn codux_working_restores_current_status_when_switching_back_to_cards() {
+    let (mut chat, _rx, _op_rx) = make_chatwidget_manual(None).await;
+    chat.on_task_started();
+    chat.bottom_pane.reset_status_timer(Duration::from_secs(42));
+    chat.on_agent_message_delta("In progress".to_string());
+    assert!(!chat.bottom_pane.status_indicator_visible());
+    chat.set_status_header("Reading files".to_string());
+
+    chat.set_mycodx_stream_cards(true);
+    assert_eq!(
+        chat.bottom_pane.status_widget().unwrap().header(),
+        "Reading files"
+    );
+    assert!(chat.bottom_pane.status_elapsed().unwrap() >= Duration::from_secs(42));
+    chat.on_commit_tick();
+    assert_eq!(
+        chat.bottom_pane.status_widget().unwrap().header(),
+        "Reading files"
+    );
+}
