+fn mycodx_active_background_follows_focus_inside_each_card_without_a_rule() {
+    crate::mycodx_ui::with_settings(Settings::comparison(), || {
+        let mut settings = crate::mycodx_ui::current();
+        let sections = [
+            Section::Questions,
+            Section::Replies,
+            Section::Tools,
+            Section::Intermediate,
+            Section::Answers,
+        ];
+        for s in sections {
+            settings = settings.change_card(s, |c| {
+                c.background = Background::Rgb(20, 30, 40);
+                c.padding_y = 2;
+                c.title_visible = true;
+            });
+        }
+        crate::mycodx_ui::set(settings);
+        let renders = Arc::new(AtomicUsize::new(0));
+        let mut reply =
+            crate::history_cell::new_user_prompt("reply".into(), vec![], vec![], vec![]);
+        reply.mycodx_reply = true;
+        let cells = vec![
+            user("question"),
+            Arc::new(reply),
+            tool("read", &renders),
+            progress("working"),
+            answer("finished"),
+        ];
+        let mut view = TranscriptView::default();
+        let area = Rect::new(2, 3, 80, 40);
+        view.jump_to_beginning(&cells);
+        for index in 0..cells.len() {
+            view.clear_activity_focus();
+            let mut resting = Buffer::empty(area);
+            view.render(area, &mut resting, &cells);
+            view.disclosure.focused = Some(view.activity_ids(&cells, index));
+            let mut focused = Buffer::empty(area);
+            view.render(area, &mut focused, &cells);
+            let mut changed = 0;
+            for y in area.top()..area.bottom() {
+                for x in area.left()..area.right() {
+                    let a = &resting[(x, y)];
+                    let b = &focused[(x, y)];
+                    assert_eq!(a.symbol(), b.symbol());
+                    assert!(!b.modifier.contains(ratatui::style::Modifier::UNDERLINED));
+                    if a.bg != b.bg {
+                        changed += 1;
+                        assert_eq!(
+                            b.bg,
+                            crate::mycodx_ui::style::color(crate::mycodx_ui::style::brighten((
+                                20, 30, 40
+                            )))
+                        );
+                        let visible = &view.visible[usize::from(y - area.y)];
+                        assert_eq!(visible.index, index);
+                        assert!(visible.row > usize::from(visible.layout.separated)); // title stays outside
+                        assert!(
+                            visible.layout.mycodx_background_at_state(
+                                visible.row,
+                                x - area.x,
+                                true
+                            ) || visible.layout.row_for_offset(0) == visible.row
+                                || visible.layout.disclosure_row() == Some(visible.row)
+                        );
+                    }
+                }
+            }
+            assert!(changed > 0, "card {index} must show its active background");
+            view.clear_activity_focus();
+            let mut restored = Buffer::empty(area);
+            view.render(area, &mut restored, &cells);
+            assert_eq!(restored, resting);
+        }
+    });
+}
