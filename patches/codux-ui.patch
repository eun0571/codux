@@ -0,0 +1,615 @@
+//! Optional local Mermaid worker. History owns source; cached images are disposable presentation.
+#[path = "codux_mermaid_graphics.rs"]
+mod graphics;
+#[path = "codux_mermaid_style.rs"]
+pub(crate) mod style;
+pub(crate) use graphics::ImageRow;
+pub(crate) use graphics::clear_occluded_rows;
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::collections::HashMap;
+use std::io::{BufRead, BufReader, Write};
+use std::path::{Path, PathBuf};
+use std::process::{Child, ChildStdin, Command, Stdio};
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::{Arc, LazyLock, Mutex, mpsc};
+use std::time::Duration;
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub(crate) enum Mode {
+    #[default]
+    Auto,
+    Compare,
+    Image,
+    Text,
+    Beautiful,
+}
+impl Mode {
+    #[cfg(test)]
+    pub(crate) const ALL: [Self; 5] = [
+        Self::Compare,
+        Self::Auto,
+        Self::Image,
+        Self::Text,
+        Self::Beautiful,
+    ];
+    #[allow(dead_code)]
+    pub(crate) fn label(self) -> &'static str {
+        match self {
+            Self::Compare => "Codex + Beautiful text",
+            Self::Auto => "Auto",
+            Self::Image => "Images",
+            Self::Text => "Codex text",
+            Self::Beautiful => "Beautiful text",
+        }
+    }
+}
+
+#[derive(Clone)]
+pub(crate) enum Preview {
+    Pending,
+    Text(Arc<Vec<String>>),
+    Ready {
+        path: PathBuf,
+        rows: Arc<Vec<ImageRow>>,
+    },
+    Failed(String),
+}
+struct State {
+    entries: HashMap<String, Preview>,
+    sender: Option<mpsc::SyncSender<Job>>,
+    frame: Option<crate::tui::FrameRequester>,
+}
+static STATE: LazyLock<Mutex<State>> = LazyLock::new(|| {
+    Mutex::new(State {
+        entries: HashMap::new(),
+        sender: None,
+        frame: None,
+    })
+});
+static ENABLED: AtomicBool = AtomicBool::new(false);
+static REVISION: AtomicU64 = AtomicU64::new(0);
+static ANIMATED: AtomicBool = AtomicBool::new(true);
+static ANIMATION_START: LazyLock<std::time::Instant> = LazyLock::new(std::time::Instant::now);
+thread_local! { static PRESENTING: std::cell::Cell<bool> = const { std::cell::Cell::new(false) }; }
+thread_local! { static SURFACE: std::cell::Cell<Option<(u8, u8, u8)>> = const { std::cell::Cell::new(None) }; }
+pub(crate) struct SurfaceScope(Option<(u8, u8, u8)>);
+impl Drop for SurfaceScope {
+    fn drop(&mut self) {
+        SURFACE.with(|value| value.set(self.0));
+    }
+}
+pub(crate) fn surface(section: crate::mycodx_ui::Section) -> SurfaceScope {
+    let bg = crate::mycodx_ui::current().card(section).colors().bg;
+    SurfaceScope(SURFACE.with(|value| value.replace(Some(bg))))
+}
+pub(crate) struct Scope(bool);
+impl Drop for Scope {
+    fn drop(&mut self) {
+        PRESENTING.with(|value| value.set(self.0));
+    }
+}
+pub(crate) fn scope(enabled: bool) -> Scope {
+    Scope(PRESENTING.with(|value| value.replace(enabled)))
+}
+pub(crate) fn revision() -> u64 {
+    REVISION.load(Ordering::Acquire)
+}
+pub(crate) fn configure(frame: Option<crate::tui::FrameRequester>, animated: bool) {
+    ANIMATED.store(animated, Ordering::Release);
+    ENABLED.store(true, Ordering::Release);
+    if frame.is_some() {
+        STATE.lock().unwrap_or_else(|e| e.into_inner()).frame = frame;
+    }
+}
+pub(crate) fn pending_style() -> ratatui::style::Style {
+    let animated = ANIMATED.load(Ordering::Acquire);
+    if animated {
+        if let Some(frame) = &STATE.lock().unwrap_or_else(|e| e.into_inner()).frame {
+            frame.schedule_frame_in(Duration::from_millis(50));
+        }
+    }
+    crate::mycodx_ui::status::working_style(ANIMATION_START.elapsed(), animated)
+}
+#[cfg(test)]
+pub(crate) fn pending() -> bool {
+    STATE
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .entries
+        .values()
+        .any(|v| matches!(v, Preview::Pending))
+}
+
+#[derive(Clone)]
+struct Job {
+    key: String,
+    source: String,
+    theme: &'static str,
+    background: String,
+    style: style::ImageStyle,
+    text_style: style::TextStyle,
+    geometry: graphics::Geometry,
+    image: bool,
+    width: u16,
+}
+
+pub(crate) fn request(source: &str, width: u16) -> Option<Preview> {
+    if !ENABLED.load(Ordering::Acquire) || !PRESENTING.with(|v| v.get()) {
+        return None;
+    }
+    #[cfg(test)]
+    if let Some(manifest) = std::env::var_os("CODUX_MERMAID_PREVIEW_IMAGE") {
+        return Some(preview_artifact(source, width, Path::new(&manifest)));
+    }
+    request_with_geometry(source, width, graphics::Geometry::detect(width))
+}
+
+fn request_with_geometry(
+    source: &str,
+    width: u16,
+    geometry: graphics::Geometry,
+) -> Option<Preview> {
+    let settings = crate::mycodx_ui::current();
+    let mode = settings.mermaid;
+    let image = matches!(mode, Mode::Auto | Mode::Image);
+    if mode == Mode::Text
+        || (image && (!geometry.supported() || crate::terminal_palette::default_bg().is_none()))
+    {
+        // Retain the native diagram immediately. Unsupported terminals need no
+        // worker, browser, cache files, placeholder, or reflow after a timeout.
+        return None;
+    }
+    if source.len() > 64 * 1024 {
+        return Some(Preview::Failed("Diagram exceeds 64 KiB".into()));
+    }
+    let bg = SURFACE.with(|value| value.get()).unwrap_or_else(|| {
+        settings
+            .card(crate::mycodx_ui::Section::Answers)
+            .colors()
+            .bg
+    });
+    let image_style = settings.mermaid_style;
+    let (theme, _) = image_style.resolved(bg);
+    let background = format!("#{:02x}{:02x}{:02x}", bg.0, bg.1, bg.2);
+    let width = width.clamp(1, 240);
+    let presentation = if image {
+        format!("{background}\0{theme}\0{image_style:?}\0{geometry:?}")
+    } else {
+        format!("beautiful-text-v2\0{width}\0{:?}", settings.mermaid_text)
+    };
+    let key = format!("{:x}", Sha256::digest(format!("{source}\0{presentation}")));
+    let mut state = STATE.lock().unwrap_or_else(|e| e.into_inner());
+    if let Some(preview) = state.entries.get(&key) {
+        return Some(preview.clone());
+    }
+    if state.sender.is_none() {
+        let (tx, rx) = mpsc::sync_channel(8);
+        if std::thread::Builder::new()
+            .name("codux-mermaid".into())
+            .spawn(move || worker(rx))
+            .is_err()
+        {
+            return Some(Preview::Failed("Cannot start Mermaid worker".into()));
+        }
+        state.sender = Some(tx);
+    }
+    let job = Job {
+        key: key.clone(),
+        source: source.into(),
+        theme,
+        background,
+        style: image_style,
+        text_style: settings.mermaid_text,
+        geometry,
+        image,
+        width,
+    };
+    if state.sender.as_ref()?.try_send(job).is_err() {
+        return Some(Preview::Pending);
+    }
+    state.entries.insert(key, Preview::Pending);
+    Some(Preview::Pending)
+}
+
+#[cfg(test)]
+fn preview_artifact(source: &str, width: u16, manifest: &Path) -> Preview {
+    let result = (|| -> anyhow::Result<Preview> {
+        let content = std::fs::read_to_string(manifest)?;
+        let artifact: serde_json::Value = serde_json::from_str(&content)?;
+        anyhow::ensure!(
+            artifact["source"].as_str().map(str::trim) == Some(source.trim()),
+            "Preview image does not match this Mermaid source"
+        );
+        let png = PathBuf::from(
+            artifact["png"]
+                .as_str()
+                .ok_or_else(|| anyhow::anyhow!("Missing PNG"))?,
+        );
+        let svg = PathBuf::from(
+            artifact["svg"]
+                .as_str()
+                .ok_or_else(|| anyhow::anyhow!("Missing SVG"))?,
+        );
+        let key = format!("preview-file:{}:{width}", manifest.display());
+        let mut state = STATE.lock().unwrap_or_else(|e| e.into_inner());
+        if let Some(value) = state.entries.get(&key) {
+            return Ok(value.clone());
+        }
+        let rows = graphics::prepare(&png, graphics::Geometry::detect(width), 1)?;
+        let value = Preview::Ready {
+            path: svg,
+            rows: Arc::new(rows),
+        };
+        state.entries.insert(key, value.clone());
+        Ok(value)
+    })();
+    result.unwrap_or_else(|error| Preview::Failed(error.to_string()))
+}
+
+pub(crate) fn comparing_text() -> bool {
+    #[cfg(test)]
+    if std::env::var_os("CODUX_MERMAID_PREVIEW_IMAGE").is_some() {
+        return false;
+    }
+    crate::mycodx_ui::current().mermaid == Mode::Compare
