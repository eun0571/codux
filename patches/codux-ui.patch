 use super::*;
 use crate::terminal_palette::rgb_color;
 use pretty_assertions::assert_eq;
+
+#[test]
+fn codux_hidden_cursor_keeps_ime_anchor_while_transcript_selection_changes() {
+    let mut terminal = Terminal::with_options(CaptureBackend::new(40, 8)).expect("terminal");
+    terminal.set_viewport_area(Rect::new(0, 0, 40, 8));
+    let mut parser = vt100::Parser::new(8, 40, 0);
+    for (index, highlight) in [None, Some(3), Some(18), Some(9), None]
+        .into_iter()
+        .enumerate()
+    {
+        terminal.backend_mut().output.clear();
+        terminal
+            .draw(|frame| {
+                frame
+                    .buffer_mut()
+                    .set_string(0, 6, "draft: \u{d55c}\u{ae00}", Style::default());
+                frame.buffer_mut().set_string(
+                    0,
+                    1,
+                    "select text in the transcript",
+                    Style::default(),
+                );
+                if let Some(column) = highlight {
+                    frame.buffer_mut()[(column, 1)].set_bg(Color::Blue);
+                } else {
+                    frame.set_cursor_position((11, 6));
+                }
+            })
+            .expect("draw");
+        parser.process(&terminal.backend().output);
+        assert_eq!(parser.screen().cursor_position(), (6, 11), "frame {index}");
+        assert_eq!(parser.screen().hide_cursor(), highlight.is_some());
+        assert!(
+            parser
+                .screen()
+                .contents()
+                .contains("draft: \u{d55c}\u{ae00}")
+        );
+    }
+}
+
+#[test]
+fn codux_hidden_cursor_anchor_stays_inside_a_resized_terminal() {
+    let mut terminal = Terminal::with_options(CaptureBackend::new(40, 8)).expect("terminal");
+    terminal.set_viewport_area(Rect::new(0, 0, 40, 8));
+    terminal
+        .draw(|frame| frame.set_cursor_position((30, 6)))
+        .expect("draw");
+    terminal
+        .draw_with_size(Size::new(20, 4), &mut Vec::new(), |_| {})
+        .expect("resize");
+    assert!(terminal.hidden_cursor);
+    assert_eq!(terminal.last_known_cursor_pos, Position::new(19, 3));
+}
 
