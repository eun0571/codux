+            "\u{d55c}\u{ae00} \u{c785}\u{b825} \u{c911}"
+        );
+    }
+    assert!(tui.terminal.hidden_cursor);
+    assert_eq!(
+        app.transcript_view
+            .selected_text(&app.transcript_cells)
+            .as_deref(),
+        Some("select thi")
+    );
+    tui.set_owned_screen(false)?;
+    Ok(())
+}
 
