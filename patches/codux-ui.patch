+fn runtime_available(path: &Path, image: bool) -> bool {
+    let dependency = if image {
+        "node_modules/puppeteer-core/package.json"
+    } else {
+        "node_modules/beautiful-mermaid/package.json"
+    };
+    path.join("worker.mjs").is_file() && path.join(dependency).is_file()
+}
+
+fn runtime(image: bool) -> anyhow::Result<PathBuf> {
+    let explicit = std::env::var_os(if image {
+        "CODUX_MERMAID_RUNTIME"
+    } else {
+        "CODUX_MERMAID_TEXT_RUNTIME"
+    })
+    .map(PathBuf::from);
+    let resource = if image {
+        "codex-resources/codux-mermaid"
+    } else {
+        "codex-resources/codux-mermaid-text"
+    };
+    let packaged = std::env::current_exe()
+        .ok()
+        .and_then(|p| p.parent()?.parent().map(|p| p.join(resource)));
+    explicit
+        .or(packaged)
+        .filter(|p| runtime_available(p, image))
+        .ok_or_else(|| {
+            anyhow::anyhow!("Bundled Mermaid renderer is unavailable; reinstall Codux or choose Codex text in /custom")
+        })
+}
+
+struct Worker {
+    child: Child,
+    input: ChildStdin,
+    output: mpsc::Receiver<String>,
+    cache: PathBuf,
+}
+impl Drop for Worker {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+impl Worker {
+    fn start(image: bool) -> anyhow::Result<Self> {
+        let runtime = runtime(image)?;
+        let cache = std::env::var_os("CODUX_MERMAID_CACHE")
+            .map(PathBuf::from)
+            .or_else(|| {
+                std::env::var_os("LOCALAPPDATA")
+                    .map(|p| PathBuf::from(p).join("Codux/cache/mermaid"))
+            })
+            .unwrap_or_else(|| std::env::temp_dir().join("codux-mermaid-cache"));
+        std::fs::create_dir_all(&cache)?;
+        let cache = cache.canonicalize()?;
+        // npm supplies the exact Node executable that launched Codux, including
+        // installations outside PATH or paths containing spaces.
+        let node = std::env::var_os("CODUX_NODE")
+            .map(PathBuf::from)
+            .filter(|path| path.is_absolute() && path.is_file())
+            .unwrap_or_else(|| runtime.join(if cfg!(windows) { "node.exe" } else { "node" }));
+        let mut command = Command::new(if node.is_file() {
+            node.into_os_string()
+        } else {
+            "node".into()
+        });
+        if !image {
+            command.arg("--max-old-space-size=256");
+        }
+        command
+            .arg(runtime.join("worker.mjs"))
+            .arg(&cache)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null());
+        #[cfg(windows)]
+        {
+            use std::os::windows::process::CommandExt;
+            command.creation_flags(0x08000000);
+        }
+        let mut child = command.spawn()?;
+        let input = child
+            .stdin
+            .take()
+            .ok_or_else(|| anyhow::anyhow!("Missing worker input"))?;
+        let stdout = child
+            .stdout
+            .take()
+            .ok_or_else(|| anyhow::anyhow!("Missing worker output"))?;
+        let (tx, output) = mpsc::channel();
+        std::thread::spawn(move || {
+            let mut reader = BufReader::new(stdout);
+            loop {
+                let mut line = String::new();
+                if reader.read_line(&mut line).unwrap_or(0) == 0 || line.len() > 1024 * 1024 {
+                    break;
+                }
+                if tx.send(line).is_err() {
+                    break;
+                }
+            }
+        });
+        Ok(Self {
+            child,
+            input,
+            output,
+            cache,
+        })
+    }
+    fn render(&mut self, job: &Job) -> anyhow::Result<Preview> {
+        writeln!(
+            self.input,
+            "{}",
+            serde_json::json!({ "source": job.source, "theme": job.theme, "background": job.background,
+                "fontFamily": job.style.font_family(), "fontSize": job.style.font_size,
+                "look": job.style.look_name(), "columns": job.width, "options": job.text_style })
+        )?;
+        self.input.flush()?;
+        let reply =
+            self.output
+                .recv_timeout(Duration::from_secs(if job.image { 35 } else { 10 }))?;
+        let reply: serde_json::Value = serde_json::from_str(&reply)?;
+        if reply["ok"] != true {
+            // Syntax errors are valid replies, not a broken worker transport.
+            // The worker closes its browser before returning this response.
+            return Ok(Preview::Failed(
+                reply["error"]
+                    .as_str()
+                    .unwrap_or("Mermaid rendering failed")
+                    .chars()
+                    .filter(|c| !c.is_control())
+                    .take(180)
+                    .collect(),
+            ));
+        }
+        if !job.image {
+            let text = reply["text"]
+                .as_str()
+                .ok_or_else(|| anyhow::anyhow!("Missing text diagram"))?;
+            return validated_text(text, job.width);
+        }
+        let png = validated_artifact(&self.cache, &reply["png"], "png")?;
+        let svg = validated_artifact(&self.cache, &reply["svg"], "svg")?;
+        let scale = reply["scale"].as_u64().unwrap_or(1).clamp(1, 4) as u32;
+        let rows = graphics::prepare(&png, job.geometry, scale)?;
+        Ok(Preview::Ready {
+            path: svg,
+            rows: Arc::new(rows),
+        })
+    }
+}
+fn validated_text(text: &str, width: u16) -> anyhow::Result<Preview> {
+    anyhow::ensure!(
+        !text.trim().is_empty() && text.len() <= 131072,
+        "Invalid text diagram size"
+    );
+    anyhow::ensure!(
+        !regex_lite::Regex::new(r"\x1b\[[0-9;]*m")
+            .unwrap()
+            .replace_all(text, "")
+            .chars()
+            .any(|c| c.is_control() && c != '\n'),
+        "Control characters in text diagram"
+    );
+    let lines: Vec<String> = text.lines().map(str::to_owned).collect();
+    anyhow::ensure!(
+        lines.len() <= 160
+            && lines
+                .iter()
+                .all(|s| codex_ansi_escape::ansi_escape_line(s).width() <= usize::from(width)),
+        "Text diagram exceeds terminal bounds"
+    );
+    Ok(Preview::Text(Arc::new(lines)))
+}
+fn validated_artifact(
+    cache: &Path,
+    value: &serde_json::Value,
+    extension: &str,
+) -> anyhow::Result<PathBuf> {
+    let path = PathBuf::from(
+        value
+            .as_str()
+            .ok_or_else(|| anyhow::anyhow!("Missing image path"))?,
+    )
+    .canonicalize()?;
+    anyhow::ensure!(
+        path.starts_with(cache) && path.extension().and_then(|v| v.to_str()) == Some(extension),
+        "Invalid image path"
+    );
+    anyhow::ensure!(
+        path.metadata()?.len() <= 24 * 1024 * 1024,
+        "Image is too large"
+    );
+    Ok(path)
+}
+fn worker(jobs: mpsc::Receiver<Job>) {
+    let mut image_process: Option<Worker> = None;
+    let mut text_process: Option<Worker> = None;
+    for job in jobs {
+        let process = if job.image {
+            &mut image_process
+        } else {
+            &mut text_process
+        };
+        let result = (|| {
+            if process.is_none() {
+                *process = Some(Worker::start(job.image)?);
+            }
+            process
+                .as_mut()
+                .ok_or_else(|| anyhow::anyhow!("Missing renderer"))?
+                .render(&job)
+        })();
+        let preview = match result {
+            Ok(result) => result,
+            Err(error) => {
+                // Drop closes the failed process; the next distinct diagram can recover.
+                *process = None;
+                Preview::Failed(
+                    error
+                        .to_string()
+                        .chars()
+                        .filter(|c| !c.is_control())
+                        .take(180)
+                        .collect(),
+                )
+            }
+        };
+        let mut state = STATE.lock().unwrap_or_else(|e| e.into_inner());
+        // Keep older file links instead of evicting requests: evicting keys causes
+        // endless re-encoding when a long transcript invalidates its layout cache.
+        let images = state
+            .entries
+            .values()
+            .filter(|p| matches!(p, Preview::Ready { rows, .. } if !rows.is_empty()))
+            .count();
+        if images >= 24 && matches!(&preview, Preview::Ready { rows, .. } if !rows.is_empty()) {
+            if let Some(Preview::Ready { rows, .. }) = state
+                .entries
+                .values_mut()
+                .find(|p| matches!(p, Preview::Ready { rows, .. } if !rows.is_empty()))
+            {
+                *rows = Arc::new(Vec::new());
+            }
+        }
+        state.entries.insert(job.key, preview);
+        REVISION.fetch_add(1, Ordering::Release);
+        if let Some(frame) = &state.frame {
+            frame.schedule_frame();
+        }
+    }
+}
