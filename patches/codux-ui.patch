+//! Codux keeps transcript navigation in the card view. Prompt edits are explicit rewinds.
+use super::*;
+use crate::bottom_pane::{SelectionItem, SelectionViewParams};
+
+impl App {
+    pub(super) fn cycle_codux_card_mode(&mut self, tui: &mut tui::Tui) {
+        if let Err(error) = self
+            .transcript_view
+            .cycle_codux_card_mode(&self.transcript_cells, &self.local_settings.codex_home)
+        {
+            self.chat_widget
+                .add_error_message(format!("Could not save card display mode: {error}"));
+        } else {
+            self.chat_widget.show_codux_card_mode();
+        }
+        tui.frame_requester().schedule_frame();
+    }
+
+    pub(super) fn codux_prompt_edit_allowed(&self) -> bool {
+        !self.reconnect.offline
+            && !self.chat_widget.is_external_writer_view()
+            && !self.chat_widget.side_conversation_active()
+            && self.chat_widget.is_normal_backtrack_mode()
+            && self.chat_widget.composer_is_empty()
+    }
+
+    pub(super) fn open_codux_prompt_edit(&mut self) {
+        if !self.codux_prompt_edit_allowed() {
+            self.chat_widget.add_error_message(
+                "Rewind is available in an idle, writable session with an empty composer. Your draft has been kept.".into(),
+            );
+            return;
+        }
+        let Some(index) = self
+            .transcript_view
+            .codux_focused_index(&self.transcript_cells)
+        else {
+            return;
+        };
+        let Some(prompt) = self.codux_prompt_at(index) else {
+            self.chat_widget.add_error_message("Select an original question to rewind and edit. Replies cannot be rewound independently.".into());
+            return;
+        };
+        if !self
+            .transcript_view
+            .reveal_codux_focus(&self.transcript_cells, index)
+        {
+            return;
+        }
+        let Some(thread_id) = self.chat_widget.thread_id() else {
+            return;
+        };
+        let selected_cell = Arc::clone(&self.transcript_cells[index]);
+        self.chat_widget.show_selection_view(SelectionViewParams {
+            view_id: Some("codux-rewind"),
+            title: Some("Rewind and edit".into()),
+            subtitle: Some("Remove this turn and all later turns from the conversation, then restore this question to the composer. Files on disk will not be reverted.".into()),
+            initial_selected_idx: Some(0),
+            items: vec![
+                SelectionItem { name: "Cancel".into(), dismiss_on_select: true, ..Default::default() },
+                SelectionItem {
+                    name: "Rewind and edit".into(),
+                    dismiss_on_select: true,
+                    actions: vec![Box::new(move |tx| tx.send(AppEvent::RevertSessionForPromptEdit {
+                        thread_id, selected_cell: Arc::clone(&selected_cell), prompt: prompt.clone(),
+                    }))],
+                    ..Default::default()
+                },
+            ],
+            ..SelectionViewParams::confirmation()
+        });
+    }
+}
