+        for width in [1, 3, 24, 80] {
+            let layout = completion_layout(&cell, width).unwrap();
+            assert_eq!(layout.text(), "Worked for 12s");
+            assert!(!layout.disclosure);
+            assert!(layout.row_count() >= 3);
