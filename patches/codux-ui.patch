+pub(super) struct Choice {
+    pub name: String,
+    pub description: String,
+    pub settings: Settings,
+}
+
+/// Fixed first-install palette, shared with the Default choice and web export.
+/// Resolve the bundled Ocean Dark colors without consulting the current /theme.
+pub(super) fn default_colors() -> [Background; 5] {
+    static COLORS: std::sync::LazyLock<[Background; 5]> = std::sync::LazyLock::new(|| {
+        let syntax = highlight::resolve_theme_by_name("base16-ocean-dark", None)
+            .expect("bundled Base16 Ocean Dark theme");
+        let palette = Palette::from_theme(&syntax, (24, 24, 24));
+        let settings = palette.apply(
+            &Settings::web(),
+            &palette,
+            [FUNCTION, STRING, KEYWORD, NUMBER],
+        );
+        SECTIONS.map(|section| {
+            if section == Section::Answers {
+                Background::None
+            } else {
+                settings.card(section).background
+            }
+        })
+    });
+    *COLORS
+}
+
+pub(super) fn choices(original: &Settings) -> Vec<Choice> {
+    choices_for(
+        original,
+        &highlight::current_syntax_theme(),
+        crate::terminal_palette::default_bg().unwrap_or((24, 24, 24)),
+    )
+}
+
+fn choices_for(original: &Settings, syntax: &Theme, outer: Rgb) -> Vec<Choice> {
+    let live = Palette::from_theme(syntax, outer);
+    let mut choices = Vec::new();
+    let mut matched = None;
+    for scheme in SCHEMES {
+        let id = if live.light() {
+            scheme.light
+        } else {
+            scheme.dark
+        };
+        let Some(source) = highlight::resolve_theme_by_name(id, None) else {
+            continue;
+        };
+        if &source == syntax {
+            matched = Some(choices.len());
+        }
+        let source_palette = Palette::from_theme(&source, live.base);
+        choices.push(Choice {
+            name: source.name.clone().unwrap_or_else(|| id.into()),
+            description: format!("{} Source: /theme {id}.", scheme.description),
+            settings: source_palette.apply(original, &live, scheme.roles),
+        });
+    }
+    let mut recommended = if let Some(index) = matched {
+        choices.remove(index)
+    } else {
+        Choice {
+            name: syntax.name.clone().unwrap_or_else(|| "Current /theme".into()),
+            description: "From the current /theme: function prompts, string tools, keyword progress, numeric answers.".into(),
+            settings: live.apply(original, &live, [FUNCTION, STRING, KEYWORD, NUMBER]),
+        }
+    };
+    recommended.name.push_str(" (recommended)");
+    choices.insert(0, recommended);
+    let defaults = Settings::default();
+    let mut settings = original.clone();
+    for section in SECTIONS {
+        settings = settings.change_card(section, |card| {
+            card.background = defaults.card(section).background;
+        });
+    }
+    choices.insert(
+        1,
+        Choice {
+            name: "Default".into(),
+            description: "Base16 Ocean Dark card colors; no final-answer background. Colors only."
+                .into(),
+            settings,
+        },
+    );
+    choices
+}
+
+struct Palette {
+    base: Rgb,
+    accents: [Rgb; 5],
+    // Default text, semantic syntax colors and deliberately dim comments.
+    // Unusual low-contrast themes retain their original baseline.
+    readable_colors: Vec<(Rgb, f64)>,
+}
+
+fn rgb(color: Color) -> Option<Rgb> {
+    match color {
+        Color::Rgb(r, g, b) => Some((r, g, b)),
+        // ANSI indices are terminal-defined, not literal RGB channels.
+        _ => None,
+    }
+}
+
+impl Palette {
+    fn from_theme(theme: &Theme, outer: Rgb) -> Self {
+        let decode = |color| highlight::convert_syntect_color(color).and_then(rgb);
+        let base = theme.settings.background.and_then(decode).unwrap_or(outer);
+        let foreground = theme
+            .settings
+            .foreground
+            .and_then(decode)
+            .unwrap_or_else(|| {
+                if luminance(base) > 0.4 {
+                    (20, 20, 20)
+                } else {
+                    (240, 240, 240)
+                }
+            });
+        let accents = SCOPES.map(|scopes| {
+            highlight::foreground_style_for_scopes_with_theme(theme, scopes)
+                .and_then(|style| style.fg)
+                .and_then(rgb)
+                .unwrap_or(foreground)
+        });
+        let mut readable_colors = vec![(foreground, contrast(foreground, base).min(4.5))];
+        for color in accents {
+            if !readable_colors.iter().any(|(c, _)| *c == color) {
+                readable_colors.push((color, contrast(color, base).min(3.0)));
+            }
+        }
+        if let Some(color) = highlight::foreground_style_for_scopes_with_theme(theme, &["comment"])
+            .and_then(|style| style.fg)
+            .and_then(rgb)
+        {
+            readable_colors.push((color, contrast(color, base).min(2.0)));
+        }
+        Self {
+            base,
+            accents,
+            readable_colors,
+        }
+    }
+
+    fn light(&self) -> bool {
+        luminance(self.base) > 0.4
+    }
+
+    fn apply(&self, original: &Settings, live: &Palette, roles: [usize; 4]) -> Settings {
+        // Opposite-polarity palettes contribute hues, not an unreadable surface.
+        let base = if self.light() == live.light() {
+            self.base
+        } else {
+            live.base
+        };
+        let role_colors = [roles[0], roles[0], roles[1], roles[2], roles[3]];
+        let mut next = original.clone();
+        let edge = if live.light() {
+            (255, 255, 255)
+        } else {
+            (0, 0, 0)
+        };
+        let mut prompt = base;
+        for (index, section) in SECTIONS.into_iter().enumerate() {
+            let resting = live.readable(if section == Section::Replies {
+                // Retain the prompt hue with a visibly quieter fill, even when
+                // contrast limits would otherwise flatten both to one shade.
+                blend(prompt, edge, 22)
+            } else {
+                blend(
+                    base,
+                    self.accents[role_colors[index]],
+                    [38, 25, 24, 14, 22][index],
+                )
+            });
+            if section == Section::Questions {
+                prompt = resting;
+            }
+            next = next.change_card(section, |card| {
+                card.background = Background::Rgb(resting.0, resting.1, resting.2);
+            });
+        }
+        next
+    }
+
+    fn readable(&self, mut background: Rgb) -> Rgb {
+        let edge = if self.light() {
+            (255, 255, 255)
+        } else {
+            (0, 0, 0)
+        };
+        for _ in 0..48 {
+            let plain = if u32::from(background.0) * 299
+                + u32::from(background.1) * 587
+                + u32::from(background.2) * 114
+                > 140_000
+            {
+                (20, 20, 20)
+            } else {
+                (240, 240, 240)
+            };
+            if contrast(plain, background) >= 4.5
+                && self
+                    .readable_colors
+                    .iter()
+                    .all(|(color, minimum)| contrast(*color, background) + 0.001 >= *minimum)
+            {
+                return background;
+            }
+            // Preserve the chosen hue instead of collapsing every selection
+            // back onto the same live-theme background.
+            background = blend(background, edge, 10);
+        }
+        self.base
+    }
+}
+
+fn blend(base: Rgb, tint: Rgb, percent: u16) -> Rgb {
+    let channel =
+        |a: u8, b: u8| ((u16::from(a) * (100 - percent) + u16::from(b) * percent + 50) / 100) as u8;
+    (
+        channel(base.0, tint.0),
+        channel(base.1, tint.1),
+        channel(base.2, tint.2),
+    )
+}
+
+fn luminance(rgb: Rgb) -> f64 {
+    let channel = |v: u8| {
+        let v = f64::from(v) / 255.0;
+        if v <= 0.04045 {
+            v / 12.92
+        } else {
+            ((v + 0.055) / 1.055).powf(2.4)
+        }
+    };
+    0.2126 * channel(rgb.0) + 0.7152 * channel(rgb.1) + 0.0722 * channel(rgb.2)
+}
+
+pub(super) fn contrast(a: Rgb, b: Rgb) -> f64 {
+    let a = luminance(a);
+    let b = luminance(b);
+    (a.max(b) + 0.05) / (a.min(b) + 0.05)
+}
