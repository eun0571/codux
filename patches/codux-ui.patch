+//! Navigation changes must preserve source positions when hiding tools joins prose cards.
+use super::*;
+use crate::mycodx_ui::Section;
+
+impl TranscriptView {
+    pub(crate) fn codux_navigation_shortcuts_available(&self) -> bool {
+        !self.search.is_active()
+            && !self.has_selection_range()
+            && self.select_mode.is_none()
+            && self.copy_mode.is_none()
+    }
+
+    pub(crate) fn cycle_codux_card_mode(
+        &mut self,
+        cells: &[Arc<dyn HistoryCell>],
+        home: &std::path::Path,
+    ) -> anyhow::Result<()> {
+        let old = crate::mycodx_ui::current();
+        self.apply_codux_card_settings(cells, home, old.with_card_mode(old.card_mode().next()))
+    }
+
+    pub(crate) fn apply_codux_card_settings(
+        &mut self,
+        cells: &[Arc<dyn HistoryCell>],
+        home: &std::path::Path,
+        next: crate::mycodx_ui::Settings,
+    ) -> anyhow::Result<()> {
+        let selected = self.codux_focused_index(cells);
+        let origin = match self.position {
+            Position::Reading(anchor) => Some(self.codux_source_anchor(cells, anchor)),
+            Position::Latest => None,
+        };
+        // Mirror intermediate disclosure states onto the IDs used by both presentations.
+        // Unchanged tool IDs retain their individual fold states.
+        let states: Vec<_> = (0..cells.len())
+            .filter(|&index| {
+                super::mycodx::section_at(cells, index) == Some(Section::Intermediate)
+                    && !super::mycodx::message_member(cells, index)
+            })
+            .map(|index| (index, self.mycodx_expanded(cells, index)))
+            .collect();
+        // A failed save leaves both the live view and the settings unchanged.
+        crate::mycodx_ui::save(home, next)?;
+        self.refresh_mycodx_ui();
+        let mut assigned = std::collections::HashSet::new();
+        for (index, expanded) in states {
+            let start = self.codux_group_start(cells, index);
+            for id in super::mycodx::ids(cells, start) {
+                if !assigned.insert(id.clone())
+                    || self.disclosure.expanded.contains(&id)
+                    || self.disclosure.collapsed.contains(&id)
+                {
+                    continue;
+                }
+                if expanded {
+                    self.disclosure.collapsed.remove(&id);
+                    self.disclosure.expanded.insert(id);
+                } else {
+                    self.disclosure.expanded.remove(&id);
+                    self.disclosure.collapsed.insert(id);
+                }
+            }
+            // When a merged card splits, each member inherits its former state.
+            if crate::mycodx_ui::tools_visible() {
+                let end = (index + 1..cells.len())
+                    .find(|&i| {
+                        super::mycodx::section_at(cells, i) != Some(Section::Intermediate)
+                            && !super::mycodx::is_tool(&cells[i])
+                    })
+                    .unwrap_or(cells.len());
+                for i in index..end {
+                    if super::mycodx::section_at(cells, i) != Some(Section::Intermediate) {
+                        continue;
+                    }
+                    for id in super::mycodx::ids(cells, i) {
+                        if self.disclosure.expanded.contains(&id)
+                            || self.disclosure.collapsed.contains(&id)
+                        {
+                            continue;
+                        }
+                        if expanded {
+                            self.disclosure.collapsed.remove(&id);
+                            self.disclosure.expanded.insert(id);
+                        } else {
+                            self.disclosure.expanded.remove(&id);
+                            self.disclosure.collapsed.insert(id);
+                        }
+                    }
+                }
+            }
+        }
+        if let Some(anchor) = origin {
+            let index = self.codux_visible_neighbor(cells, anchor.index);
+            let group = self.codux_group_start(cells, index);
+            let start = self.codux_member_offset(cells, group, index);
+            self.position = Position::Reading(Anchor {
+                key: self.entry_key(cells, group),
+                index: group,
+                offset: if index == anchor.index {
+                    start + anchor.offset
+                } else {
+                    0
+                },
+                row_bias: if index == anchor.index {
+                    anchor.row_bias
+                } else {
+                    0
+                },
+            });
+        }
+        if let Some(index) = selected {
+            let index = self.codux_visible_neighbor(cells, index);
+            let index = self.codux_group_start(cells, index);
+            let ids = self.activity_ids(cells, index);
+            self.disclosure.focused = (!ids.is_empty()).then_some(ids);
+        }
+        self.visible.clear(); // Old hit regions refer to the previous grouping until the next draw.
+        Ok(())
+    }
+
+    fn codux_visible_neighbor(&self, cells: &[Arc<dyn HistoryCell>], index: usize) -> usize {
+        let settings = crate::mycodx_ui::current();
+        let section = if index == cells.len() {
+            Some(if self.mycodx_stream { self.mycodx_stream_section } else { Section::Tools })
+        } else {
+            super::mycodx::section_at(cells, index)
+        };
+        if section.is_none_or(|section| settings.visible(section)) {
+            return index;
+        }
+        let start = super::mycodx::prompt_start(cells, index);
+        let end = (index + 1..cells.len())
+            .find(|&i| super::mycodx::section_at(cells, i) == Some(Section::Questions))
+            .unwrap_or(cells.len());
+        (start..end)
+            .filter(|&i| {
+                super::mycodx::section_at(cells, i)
+                    .is_some_and(|s| settings.visible(s))
+                    && matches!(
+                        super::mycodx::section_at(cells, i),
+                        Some(Section::Answers | Section::Intermediate)
+                    )
+            })
+            .min_by_key(|&i| i.abs_diff(index))
+            .unwrap_or(start)
+    }
+
+    fn codux_group_start(&self, cells: &[Arc<dyn HistoryCell>], index: usize) -> usize {
+        (0..=index)
+            .rev()
+            .find(|&i| {
+                !super::mycodx::message_member(cells, i)
+                    && !super::mycodx::tool_member(cells, i)
+                    && (i == index || super::mycodx::message_members(cells, i).contains(&index))
+            })
+            .unwrap_or(index)
+    }
+
+    fn codux_member_offset(
+        &self,
+        cells: &[Arc<dyn HistoryCell>],
+        group: usize,
+        member: usize,
+    ) -> usize {
+        let Some(section) = super::mycodx::section_at(cells, group) else {
+            return 0;
+        };
+        if section == Section::Tools || member == group {
+            return 0;
+        }
+        let members: Vec<_> = super::mycodx::message_members(cells, group)
+            .into_iter()
+            .take_while(|i| *i <= member)
+            .collect();
+        let combined = super::mycodx::message_group_layout(
+            cells,
+            &members,
+            section,
+            self.area.width,
+            true,
+            false,
+        );
+        let single = super::mycodx::message_group_layout(
+            cells,
+            &[member],
+            section,
+            self.area.width,
+            true,
+            false,
+        );
+        combined.text().len().saturating_sub(single.text().len())
+    }
+
+    fn codux_source_anchor(&self, cells: &[Arc<dyn HistoryCell>], anchor: Anchor) -> Anchor {
+        if !matches!(
+            super::mycodx::section_at(cells, anchor.index),
+            Some(Section::Answers | Section::Intermediate)
+        ) {
+            return anchor;
+        }
+        let member = super::mycodx::message_members(cells, anchor.index)
+            .into_iter()
+            .rev()
+            .find(|&i| self.codux_member_offset(cells, anchor.index, i) <= anchor.offset)
+            .unwrap_or(anchor.index);
+        Anchor {
+            index: member,
+            key: self.entry_key(cells, member),
+            offset: anchor.offset.saturating_sub(self.codux_member_offset(
+                cells,
+                anchor.index,
+                member,
+            )),
+            ..anchor
+        }
+    }
+}
