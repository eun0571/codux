+//! Opt-in UI workbench. Uses the production viewport with inert fixture cells.
+//! No model, tool execution, authentication or database. Local selection copying is supported.
+
+use super::*;
+use anyhow::Context;
+use crossterm::cursor::Show;
+use crossterm::event::{
+    self, DisableMouseCapture, EnableMouseCapture, Event, KeyEventKind, KeyModifiers,
+};
+use crossterm::execute;
+use crossterm::terminal::{self, EnterAlternateScreen, LeaveAlternateScreen};
+use ratatui::Terminal;
+use ratatui::backend::CrosstermBackend;
+use ratatui::widgets::Paragraph;
+use serde::Deserialize;
+use serde_json::json;
+use std::io;
+use std::path::PathBuf;
+use unicode_width::UnicodeWidthStr;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Fixture {
+    scenarios: Vec<Scenario>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Scenario {
+    name: String,
+    cells: Vec<FixtureCell>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct FixtureCell {
+    kind: String,
+    text: String,
+    #[serde(default)]
+    id: String,
+}
+
+#[derive(Debug)]
+struct PreviewTool {
+    id: String,
+    text: String,
+}
+
+impl HistoryCell for PreviewTool {
+    fn display_lines(&self, _width: u16) -> Vec<Line<'static>> {
+        self.text
+            .lines()
+            .map(|line| line.to_owned().into())
+            .collect()
+    }
+
+    fn activity_ids(&self) -> Vec<String> {
+        vec![self.id.clone()]
+    }
+
+    fn raw_lines(&self) -> Vec<Line<'static>> {
+        self.display_lines(80)
+    }
+}
+
+impl Scenario {
+    fn history(&self) -> anyhow::Result<Vec<Arc<dyn HistoryCell>>> {
+        self.cells
+            .iter()
+            .enumerate()
+            .map(|(index, cell)| {
+                let history: Arc<dyn HistoryCell> = match cell.kind.as_str() {
+                    "user" => user(&cell.text),
+                    "reply" => {
+                        let mut reply = crate::history_cell::new_user_prompt(
+                            cell.text.clone(),
+                            vec![],
+                            vec![],
+                            vec![],
+                        );
+                        reply.mycodx_reply = true;
+                        Arc::new(reply)
+                    }
+                    "answer" => answer(&cell.text),
+                    "commentary" => Arc::new(
+                        AgentMarkdownCell::new(cell.text.clone(), Path::new("."))
+                            .with_mycodx_final_answer(false),
+                    ),
+                    "tool" => Arc::new(PreviewTool {
+                        id: if cell.id.is_empty() {
+                            format!("preview-{index}")
+                        } else {
+                            cell.id.clone()
+                        },
+                        text: cell.text.clone(),
+                    }),
+                    "notice" => Arc::new(PlainHistoryCell::new(
+                        cell.text
+                            .lines()
+                            .map(|line| line.to_owned().into())
+                            .collect(),
+                    )),
+                    other => anyhow::bail!("Unknown fixture cell kind: {other}"),
+                };
+                Ok(history)
+            })
+            .collect()
+    }
+}
+
+fn read_fixture(path: &Path) -> anyhow::Result<Fixture> {
+    let fixture: Fixture = serde_json::from_slice(&std::fs::read(path)?)?;
+    anyhow::ensure!(
+        !fixture.scenarios.is_empty(),
+        "Fixture needs at least one scenario"
+    );
+    for scenario in &fixture.scenarios {
+        anyhow::ensure!(
+            !scenario.cells.is_empty(),
+            "Scenario needs at least one cell"
+        );
+        scenario.history()?;
+    }
+    Ok(fixture)
+}
+
+fn expand_all(view: &mut TranscriptView, cells: &[Arc<dyn HistoryCell>], expanded: bool) {
+    view.disclosure.expanded.clear();
+    view.disclosure.collapsed.clear();
+    for index in 0..cells.len() {
+        let ids = view.activity_ids(cells, index);
+        if expanded {
+            view.disclosure.expanded.extend(ids);
+        } else {
+            view.disclosure.collapsed.extend(ids);
+        }
+    }
+}
+
+fn snapshot(
+    view: &mut TranscriptView,
+    cells: &[Arc<dyn HistoryCell>],
+    width: u16,
+    height: u16,
+) -> serde_json::Value {
+    let area = Rect::new(0, 0, width, height);
+    let mut buffer = Buffer::empty(area);
+    view.render(area, &mut buffer, cells);
+    let mut glyphs = Vec::new();
+    let mut text = String::new();
+    for y in 0..height {
+        let mut x = 0;
+        let mut line = String::new();
+        while x < width {
+            let cell = &buffer[(x, y)];
+            let symbol = crate::terminal_hyperlinks::strip_osc8(cell.symbol());
+            let columns = UnicodeWidthStr::width(symbol.as_str())
+                .max(1)
+                .min(usize::from(width - x));
+            glyphs.push(json!({
+                "x": x, "y": y, "text": symbol,
+                "fg": format!("{:?}", cell.fg), "bg": format!("{:?}", cell.bg),
+                "modifiers": format!("{:?}", cell.modifier),
+            }));
+            line.push_str(&symbol);
+            x += columns as u16;
+        }
+        text.push_str(line.trim_end());
+        text.push('\n');
+    }
+    json!({"width": width, "height": height, "glyphs": glyphs, "text": text})
+}
+
+fn dump(fixture: &Fixture, output: &Path, width: u16, height: u16) -> anyhow::Result<()> {
+    std::fs::create_dir_all(output)?;
+    let mut frames = Vec::new();
+    for (index, scenario) in fixture.scenarios.iter().enumerate() {
+        let cells = scenario.history()?;
+        for expanded in [false, true] {
+            let mut view = TranscriptView::default();
+            view.restore_mycodx_answers(&cells);
+            view.area = Rect::new(0, 0, width, height);
+            if expanded {
+                expand_all(&mut view, &cells, true);
+            }
+            view.jump_to_beginning(&cells);
+            let mut frame = snapshot(&mut view, &cells, width, height);
+            let state = if expanded { "expanded" } else { "default" };
+            frame["name"] = json!(format!("{} / {state}", scenario.name));
+            std::fs::write(
+                output.join(format!("{index:02}-{state}.txt")),
+                frame["text"].as_str().unwrap(),
+            )?;
+            frames.push(frame);
+        }
+    }
+    std::fs::write(output.join("frames.json"), serde_json::to_vec(&frames)?)?;
+    Ok(())
+}
+
+struct RestoreTerminal;
+
+impl Drop for RestoreTerminal {
+    fn drop(&mut self) {
+        let _ = terminal::disable_raw_mode();
+        let _ = execute!(
+            io::stdout(),
+            DisableMouseCapture,
+            event::DisableBracketedPaste,
+            terminal::EndSynchronizedUpdate,
+            LeaveAlternateScreen,
+            Show
+        );
+    }
+}
+
+fn custom_view(
+    home: &Path,
+    page: crate::mycodx_ui::Page,
+    tx: &crate::app_event_sender::AppEventSender,
+) -> anyhow::Result<Box<dyn crate::bottom_pane::BottomPaneView>> {
+    if page.is_input() {
+        Ok(Box::new(crate::mycodx_ui::InputView::new(page, tx.clone())))
+    } else {
+        let mut params = crate::mycodx_ui::page_picker(home, page)?;
+        if page == crate::mycodx_ui::Page::WorkingAnimation {
+            crate::mycodx_ui::status::attach_preview(
+                &mut params,
+                tx.clone(),
+                crate::tui::FrameRequester::test_dummy(),
+                // The workbench does not load a user config. Rust's derived
+                // Default leaves this bool false, unlike the config file default.
+                &codex_config::types::Tui {
+                    animations: true,
+                    ..Default::default()
+                },
+            );
+        }
+        Ok(Box::new(crate::bottom_pane::ListSelectionView::new(
+            params,
+            tx.clone(),
+            crate::keymap::RuntimeKeymap::defaults().list,
+        )))
+    }
+}
+
+fn preview_copy(
+    view: &mut TranscriptView,
+    cells: &[Arc<dyn HistoryCell>],
+    action: &crate::transcript_view::ViewAction,
+    copy: impl FnOnce(&str) -> Result<(), String>,
+) -> Option<String> {
+    use crate::clipboard_copy::CopyStatus;
+    use crate::transcript_view::ViewAction;
+    let text = match action {
+        ViewAction::Copy(text)
+        | ViewAction::CopyOnSelect(text)
+        | ViewAction::CopyAndFollow(text) => text,
+        _ => return None,
+    };
+    let clear = view.selection_copy(action).clear_selection();
+    let mut characters = 0;
+    let result = view.copy_selected_text_with(cells, text, clear, |text, _format| {
+        if text.is_empty() {
+            return Err("Nothing selected".into());
+        }
+        characters = text.chars().count();
+        copy(text)?;
+        Ok(CopyStatus::Confirmed)
+    });
+    Some(match result {
+        Ok(CopyStatus::Confirmed) => {
+            if matches!(action, ViewAction::CopyAndFollow(_)) {
+                view.jump_to_latest();
+            }
+            format!("Copied {characters} characters to clipboard")
+        }
+        Err(error) => format!("Copy failed: {error}"),
+        _ => "Copy not confirmed; selection retained".into(),
+    })
+}
+
+fn preview_exit_key(key: event::KeyEvent, has_selection: bool) -> bool {
+    key.code == KeyCode::Char('q')
+        || (key.code == KeyCode::Char('c')
+            && key.modifiers.contains(KeyModifiers::CONTROL)
+            && !has_selection)
+}
+
+fn interactive(path: &Path, mut fixture: Fixture) -> anyhow::Result<()> {
+    use crate::app_event::AppEvent;
+    use crate::bottom_pane::BottomPaneView;
+    use crate::mycodx_ui::{self as ui, Page};
+    let home = PathBuf::from(
+        std::env::var_os("MYCODX_UI_SETTINGS_DIR")
+            .context("Preview settings directory is missing")?,
+    );
+    let mut status = String::new();
+    if std::env::var("MYCODX_UI_PRESET").as_deref() == Ok("comparison")
+        && (home.join("codux-ui.json").exists() || home.join("mycodx-ui.json").exists())
+    {
+        if let Err(error) = ui::load(&home) {
+            status = format!("Settings not loaded: {error}");
+        }
+    }
+    crate::codux_mermaid::configure(None, true);
+    terminal::enable_raw_mode()?;
+    let _restore = RestoreTerminal;
+    execute!(
+        io::stdout(),
+        EnterAlternateScreen,
+        EnableMouseCapture,
+        event::EnableBracketedPaste
+    )?;
+    // Probe theme colors before the event reader begins; do not borrow user configuration.
+    let _ = crate::terminal_palette::default_colors();
+    let mut terminal = Terminal::new(CrosstermBackend::new(io::stdout()))?;
+    terminal.hide_cursor()?;
+    let (raw, mut events) = tokio::sync::mpsc::unbounded_channel();
+    let tx = crate::app_event_sender::AppEventSender::new(raw);
+    let mut menu: Option<Box<dyn BottomPaneView>> = None;
+    let mut index = 0;
+    let mut cells = fixture.scenarios[index].history()?;
+    let mut view = TranscriptView::default();
+    view.restore_mycodx_answers(&cells);
+    let mut clipboard: Option<arboard::Clipboard> = None;
+    loop {
+        // Reapply after F5/F6/default resets. Keep the highlight after automatic copying.
+        view.copy_on_select = true;
+        view.copy_on_select_clear_selection = false;
+        terminal.draw(|frame|{
+            let area=frame.area();let menu_height=menu.as_ref().map_or(0,|v|v.desired_height(area.width).min(area.height.saturating_sub(5)));
+            let body=Rect::new(area.x,area.y,area.width,area.height.saturating_sub(menu_height+3));
+            view.render(body,frame.buffer_mut(),&cells);
+            if let Some(menu)=&menu {
+                let rect=Rect::new(area.x,body.bottom(),area.width,menu_height);
+                menu.render(rect,frame.buffer_mut());
+                if let Some((x,y))=menu.cursor_pos(rect){frame.set_cursor_position((x,y));}
+            }
+            frame.render_widget(Paragraph::new(vec![
+                Line::from(format!("PREVIEW {}/{}: {} | F2 settings",index+1,fixture.scenarios.len(),fixture.scenarios[index].name)),
+                Line::from("Drag to copy | Ctrl+C copy selection | F4 focus | Enter toggle | F5 reload | F6 sample | q quit"),
+                Line::from(status.clone()),
+            ]),Rect::new(area.x,area.bottom().saturating_sub(3),area.width,area.height.min(3)));
+            crate::codux_mermaid::clear_occluded_rows(frame.buffer_mut());
+        })?;
+        // This inert workbench has no app event loop; redraw only the animated picker.
+        if (crate::codux_mermaid::pending()
+            || menu.as_ref().is_some_and(|view| {
+                view.view_id() == Some(crate::mycodx_ui::status::WORKING_PREVIEW_ID)
+            }))
+            && !event::poll(std::time::Duration::from_millis(32))?
+        {
+            continue;
+        }
+        let event = event::read()?;
+        if let Some(active) = &mut menu {
+            match event {
+                Event::Key(key) if key.kind != KeyEventKind::Release => {
+                    active.handle_key_event(key)
+                }
+                Event::Paste(text) => {
+                    active.handle_paste(text);
+                }
+                Event::Resize(..) => {
+                    view.refresh_mycodx_ui();
+                }
+                _ => (),
+            }
+            if active.is_complete() {
+                menu = None;
+            }
+        } else {
+            match event {
+                Event::Key(key) if key.kind != KeyEventKind::Release => {
+                    if preview_exit_key(key, view.has_selection_range()) {
+                        break;
+                    }
+                    if key.code == KeyCode::Char('c')
+                        && key.modifiers.contains(KeyModifiers::CONTROL)
+                    {
+                        if let Some(text) = view.selected_text(&cells) {
+                            let action = crate::transcript_view::ViewAction::Copy(text);
+                            if let Some(message) =
+                                preview_copy(&mut view, &cells, &action, |text| {
+                                    if clipboard.is_none() {
+                                        clipboard = Some(
+                                            arboard::Clipboard::new().map_err(|e| e.to_string())?,
+                                        );
+                                    }
+                                    clipboard
+                                        .as_mut()
+                                        .unwrap()
+                                        .set_text(text)
+                                        .map_err(|e| e.to_string())
+                                })
+                            {
+                                status = message;
+                            }
+                        }
+                        continue;
+                    }
+                    match key.code {
+                        KeyCode::F(2) => {
+                            ui::begin_session();
+                            menu = Some(custom_view(&home, Page::Root, &tx)?);
+                        }
+                        KeyCode::F(5) => match read_fixture(path) {
+                            Ok(updated) => {
+                                fixture = updated;
+                                index = index.min(fixture.scenarios.len() - 1);
+                                cells = fixture.scenarios[index].history()?;
+                                view = TranscriptView::default();
+                                view.restore_mycodx_answers(&cells);
+                                status = "Reloaded fixture".into();
+                            }
+                            Err(e) => status = e.to_string(),
+                        },
+                        KeyCode::F(6) => {
+                            index = (index + 1) % fixture.scenarios.len();
+                            cells = fixture.scenarios[index].history()?;
+                            view = TranscriptView::default();
+                            view.restore_mycodx_answers(&cells);
+                            status.clear();
+                        }
+                        KeyCode::Char('e') => expand_all(&mut view, &cells, true),
+                        KeyCode::Char('c') => expand_all(&mut view, &cells, false),
+                        KeyCode::Char('d') => {
+                            ui::set(ui::Settings::default());
+                            view = TranscriptView::default();
+                            view.restore_mycodx_answers(&cells);
+                            status = "Default UI (not saved)".into();
+                        }
+                        KeyCode::Home => view.jump_to_beginning(&cells),
+                        KeyCode::End => view.jump_to_latest(),
+                        _ => {
+                            if let Some(action) = view.handle_key(key, &cells) {
+                                if let Some(message) =
+                                    preview_copy(&mut view, &cells, &action, |text| {
+                                        if clipboard.is_none() {
+                                            clipboard = Some(
+                                                arboard::Clipboard::new()
+                                                    .map_err(|e| e.to_string())?,
+                                            );
+                                        }
+                                        clipboard
+                                            .as_mut()
+                                            .unwrap()
+                                            .set_text(text)
+                                            .map_err(|e| e.to_string())
+                                    })
+                                {
+                                    status = message;
+                                }
+                            } else {
+                                match key.code {
+                                    KeyCode::Up => view.scroll(&cells, -1),
+                                    KeyCode::Down => view.scroll(&cells, 1),
+                                    _ => (),
+                                }
+                            }
+                        }
+                    }
+                }
+                Event::Mouse(mouse) => {
+                    if let Some(action) = view.handle_mouse(mouse, &cells) {
+                        if let Some(message) = preview_copy(&mut view, &cells, &action, |text| {
+                            if clipboard.is_none() {
+                                clipboard =
+                                    Some(arboard::Clipboard::new().map_err(|e| e.to_string())?);
+                            }
+                            clipboard
+                                .as_mut()
+                                .unwrap()
+                                .set_text(text)
+                                .map_err(|e| e.to_string())
+                        }) {
+                            status = message;
+                        }
+                    }
+                }
+                Event::Resize(..) => {
+                    view.refresh_mycodx_ui();
+                }
+                _ => (),
+            }
+        }
+        while let Ok(event) = events.try_recv() {
+            match event {
+                AppEvent::MycodxUiMenu { page } => menu = Some(custom_view(&home, page, &tx)?),
+                AppEvent::MycodxUiPreviewed => view.refresh_mycodx_ui(),
+                AppEvent::MycodxUiSelected {
+                    settings,
+                    previous,
+                    return_to,
+                } => {
+                    match ui::save(&home, settings) {
+                        Ok(()) => {
+                            status = "Saved preview settings (product settings unchanged)".into();
+                            menu = Some(custom_view(&home, return_to, &tx)?);
+                        }
+                        Err(e) => {
+                            ui::set(previous);
+                            status = format!("Save failed: {e}");
+                        }
+                    }
+                    view.refresh_mycodx_ui();
+                }
+                _ => (),
+            }
+        }
+    }
+    Ok(())
+}
