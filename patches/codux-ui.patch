+#[test]
+fn mycodx_live_toggle_updates_heading_anchor_after_live_layout_refresh() {
+    let mut view = TranscriptView::default();
+    view.area = Rect::new(0, 0, 60, 8);
+    let key = Some(ActiveCellTranscriptKey {
+        cacheable: true,
+        revision: 1,
+        is_stream_continuation: false,
