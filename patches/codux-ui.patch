+#[tokio::test]
+async fn codux_transcript_drag_preserves_hidden_prompt_cursor_and_korean_draft() -> Result<()> {
+    let mut app = crate::app::test_support::make_test_app().await;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    tui.set_owned_screen(true)?;
+    let size = Size::new(80, 12);
+    app.transcript_cells = vec![Arc::new(PlainHistoryCell::new(vec![
+        "select this transcript".into(),
+    ]))];
+    app.chat_widget
+        .apply_external_edit("\u{d55c}\u{ae00} \u{c785}\u{b825} \u{c911}".to_owned());
+    app.render_owned_transcript(&mut tui, size)?;
+    let input_cursor = tui.terminal.last_known_cursor_pos;
+    let buffer = crate::custom_terminal::test_support::last_rendered_buffer(&tui.terminal);
+    let start = buffer
+        .area
+        .positions()
+        .find(|pos| buffer[*pos].symbol() == "s")
+        .expect("transcript text");
+    for (kind, column) in [
+        (MouseEventKind::Down(MouseButton::Left), start.x),
+        (MouseEventKind::Drag(MouseButton::Left), start.x + 6),
+        (MouseEventKind::Drag(MouseButton::Left), start.x + 10),
+        (MouseEventKind::Up(MouseButton::Left), start.x + 10),
+    ] {
+        app.transcript_view.handle_mouse(
+            MouseEvent {
+                kind,
+                column,
+                row: start.y,
+                modifiers: KeyModifiers::NONE,
+            },
+            &app.transcript_cells,
+        );
+        app.render_owned_transcript(&mut tui, size)?;
+        assert_eq!(tui.terminal.last_known_cursor_pos, input_cursor, "{kind:?}");
+        assert_eq!(
