+//! Row-sized images participate in normal terminal diffing, clipping, and card disclosure.
+use base64::Engine;
+use image::{GenericImageView, ImageFormat};
+use ratatui::buffer::{Buffer, CellDiffOption};
+use ratatui::layout::Rect;
+use std::io::Cursor;
+use std::io::IsTerminal;
+use std::num::NonZeroU16;
+use std::path::Path;
+use std::sync::Arc;
+
+#[path = "codux_mermaid_image_cache.rs"]
+mod image_cache;
+#[path = "codux_mermaid_sixel.rs"]
+mod sixel;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Protocol {
+    Sixel,
+    Iterm,
+}
+#[derive(Clone, Copy, Debug)]
+pub(super) struct Geometry {
+    columns: u16,
+    cell_width: u16,
+    cell_height: u16,
+    protocol: Option<Protocol>,
+}
+impl Geometry {
+    pub(super) fn detect(columns: u16) -> Self {
+        let requested = std::env::var("CODUX_MERMAID_PROTOCOL").unwrap_or_default();
+        let protocol = select_protocol(
+            &requested,
+            std::io::stdout().is_terminal(),
+            std::env::var_os("TMUX").is_some() || std::env::var_os("ZELLIJ").is_some(),
+            crate::terminal_probe::codux_graphics::supported(),
+        );
+        let pixels = std::env::var("CODUX_MERMAID_CELL_PIXELS")
+            .ok()
+            .and_then(|v| {
+                let (w, h) = v.split_once('x')?;
+                Some((w.parse::<u16>().ok()?, h.parse::<u16>().ok()?))
+            })
+            .or_else(|| {
+                // Windows Terminal uses a virtual 10x20 Sixel cell, independent
+                // of physical font pixels. Its XTWINOPS reports this same size.
+                (matches!(protocol, Some(Protocol::Sixel))
+                    && std::env::var_os("WT_SESSION").is_some()
+                    && std::env::var_os("TMUX").is_none()
+                    && std::env::var_os("ZELLIJ").is_none())
+                .then_some((10, 20))
+            })
+            .or_else(|| {
+                let size = crossterm::terminal::window_size().ok()?;
+                (size.columns > 0 && size.rows > 0 && size.width > 0 && size.height > 0)
+                    .then(|| (size.width / size.columns, size.height / size.rows))
+            })
+            .filter(|(w, h)| (4..=80).contains(w) && (6..=160).contains(h));
+        // iTerm inline graphics can size in cells. Sixel requires measured pixel geometry.
+        let protocol = if pixels.is_none() && matches!(protocol, Some(Protocol::Sixel)) {
+            None
+        } else {
+            protocol
+        };
+        let (cell_width, cell_height) = pixels.unwrap_or((10, 20));
+        Self {
+            columns: columns.max(1).min(240),
+            cell_width,
+            cell_height,
+            protocol,
+        }
+    }
+
+    pub(super) fn supported(self) -> bool {
+        self.protocol.is_some()
+    }
+
+    #[cfg(test)]
+    pub(super) fn without_images() -> Self {
+        Self {
+            columns: 80,
+            cell_width: 10,
+            cell_height: 20,
+            protocol: None,
+        }
+    }
+}
+
+fn select_protocol(
+    requested: &str,
+    tty: bool,
+    multiplexed: bool,
+    advertised: bool,
+) -> Option<Protocol> {
+    // No passthrough encoder is implemented. Never emit graphics into a pipe or multiplexer.
+    if !tty || multiplexed {
+        return None;
+    }
+    match requested.trim().to_ascii_lowercase().as_str() {
+        "sixel" => Some(Protocol::Sixel),
+        "iterm" => Some(Protocol::Iterm),
+        "" | "auto" if advertised => Some(Protocol::Sixel),
+        // Disabled, unknown overrides, and missing capability replies all keep native text.
+        _ => None,
+    }
+}
+
+#[derive(Clone)]
+pub(crate) struct ImageRow {
+    pub(crate) columns: u16,
+    payload: Arc<str>,
+}
+impl ImageRow {
+    pub(crate) fn render(&self, area: Rect, buf: &mut Buffer) {
+        if area.height == 0 || area.width < self.columns {
+            return;
+        }
+        // Clearing is part of the same cursor-preserving cell payload, so repainting also
+        // removes previous pixels. ForcedWidth keeps escape bytes out of terminal geometry.
+        for x in area.x..area.x + self.columns {
+            // The unpainted part of the last image strip must retain the card
+            // surface, rather than reverting to the terminal's default black.
+            let background = buf[(x, area.y)].bg;
+            buf[(x, area.y)].reset();
+            buf[(x, area.y)].set_bg(background);
+        }
+        let symbol = format!(
+            "\x1b7{}\x1b8\x1b7{}\x1b8\x1b[{}C",
+            " ".repeat(usize::from(self.columns)),
+            self.payload,
+            self.columns
+        );
+        buf[(area.x, area.y)]
+            .set_symbol(&symbol)
+            .set_diff_option(CellDiffOption::ForcedWidth(
+                NonZeroU16::new(self.columns).unwrap_or(NonZeroU16::MIN),
+            ));
+        for x in area.x + 1..area.x + self.columns {
+            buf[(x, area.y)].set_diff_option(CellDiffOption::Skip);
+        }
+    }
+}
+pub(super) fn prepare(
+    path: &Path,
+    geometry: Geometry,
+    raster_scale: u32,
+) -> anyhow::Result<Vec<ImageRow>> {
+    let Some(protocol) = geometry.protocol else {
+        return Ok(Vec::new());
+    };
+    let mut reader = image::ImageReader::open(path)?.with_guessed_format()?;
+    let mut limits = image::Limits::default();
+    limits.max_image_width = Some(8192);
+    limits.max_image_height = Some(8192);
+    limits.max_alloc = Some(64 * 1024 * 1024);
+    reader.limits(limits);
+    let dimensions = image::image_dimensions(path)?;
+    let (target_width, target_height, bucket) = display_bounds(dimensions, geometry, raster_scale);
+    let cached = image_cache::Cache::new(path, geometry, protocol, bucket, raster_scale);
+    if let Some(rows) = cached.as_ref().and_then(|cache| cache.read()) {
+        return Ok(rows);
+    }
+    let original = reader.decode()?;
+    let scaled = original.resize(
+        target_width,
+        target_height,
+        image::imageops::FilterType::Lanczos3,
+    );
+    let rows = encode(&scaled, geometry, protocol)?;
+    if let Some(cache) = cached {
+        cache.write(&rows);
+    }
+    Ok(rows)
+}
+
+fn display_bounds(original: (u32, u32), geometry: Geometry, raster_scale: u32) -> (u32, u32, u8) {
+    let columns = geometry.columns;
+    let target_width = u32::from(columns) * u32::from(geometry.cell_width);
+    let target_height = u32::from(geometry.cell_height) * 160;
+    let density = raster_scale.clamp(1, 4);
+    let natural_width = (original.0.saturating_mul(6) / (density * 5)).max(1);
+    let natural_height = (original.1.saturating_mul(6) / (density * 5)).max(1);
+    // Four reusable sizes: 25/50/75/100% of the existing 1.2x display cap.
+    for bucket in (1_u8..=4).rev() {
+        let width = (natural_width * u32::from(bucket) / 4).max(1);
+        let height = (natural_height * u32::from(bucket) / 4).max(1);
+        if width <= target_width && height <= target_height {
+            return (width, height, bucket);
+        }
+    }
+    // Very narrow viewports still fit safely, without accumulating disk sizes.
+    (
+        target_width.min(natural_width),
+        target_height.min(natural_height),
+        0,
+    )
+}
+
+/// A wide image cell must not swallow an overlapping popup in the terminal diff.
+/// Suppress its whole strip when any of its reserved cells has been overwritten.
+pub(crate) fn clear_occluded_rows(buffer: &mut Buffer) {
+    let width = usize::from(buffer.area.width);
+    if width == 0 {
+        return;
+    }
+    for row in buffer.content.chunks_mut(width) {
+        let mut x = 0;
+        while x < row.len() {
+            let CellDiffOption::ForcedWidth(columns) = row[x].diff_option else {
+                x += 1;
+                continue;
+            };
+            if !row[x].symbol().starts_with("\x1b7") {
+                x += 1;
+                continue;
+            }
+            let end = (x + usize::from(columns.get())).min(row.len());
+            if row[x + 1..end]
+                .iter()
+                .any(|cell| cell.diff_option != CellDiffOption::Skip)
+            {
+                row[x].reset();
+                for cell in &mut row[x + 1..end] {
+                    if cell.diff_option == CellDiffOption::Skip {
+                        cell.reset();
+                    }
+                }
+            }
+            x = end;
+        }
+    }
+}
+fn encode(
+    image: &image::DynamicImage,
+    geometry: Geometry,
+    protocol: Protocol,
+) -> anyhow::Result<Vec<ImageRow>> {
+    let columns = image.width().div_ceil(u32::from(geometry.cell_width)) as u16;
+    let height = u32::from(geometry.cell_height);
+    let indexed = matches!(protocol, Protocol::Sixel)
+        .then(|| sixel::Indexed::new(image.to_rgba8().as_raw(), image.width(), image.height()));
+    let mut rows = Vec::new();
+    let mut total = 0;
+    for y in (0..image.height()).step_by(height as usize) {
+        // Keep the last partial row at its original scale, and pad the last
+        // column instead of stretching the PNG to the requested cell width.
+        let mut slice =
+            image::RgbaImage::new(u32::from(columns) * u32::from(geometry.cell_width), height);
+        image::imageops::replace(
+            &mut slice,
+            &image
+                .view(0, y, image.width(), height.min(image.height() - y))
+                .to_image(),
+            0,
+            0,
+        );
+        let payload = match protocol {
+            Protocol::Sixel => indexed.as_ref().expect("Sixel palette").strip(
+                y as usize,
+                height as usize,
+                slice.width() as usize,
+            ),
+            Protocol::Iterm => {
+                let mut bytes = Cursor::new(Vec::new());
+                image::DynamicImage::ImageRgba8(slice).write_to(&mut bytes, ImageFormat::Png)?;
+                let encoded = base64::engine::general_purpose::STANDARD.encode(bytes.into_inner());
+                format!(
+                    "\x1b]1337;File=inline=1;width={columns};height=1;preserveAspectRatio=0;doNotMoveCursor=1:{encoded}\x07"
+                )
+            }
+        };
+        total += payload.len();
+        anyhow::ensure!(total <= 8 * 1024 * 1024, "Encoded diagram is too large");
+        rows.push(ImageRow {
+            columns,
+            payload: payload.into(),
+        });
+    }
+    Ok(rows)
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn codux_graphics_uses_capabilities_and_never_emits_to_pipes_or_multiplexers() {
+        use super::{Protocol, select_protocol};
+        assert_eq!(
+            select_protocol("auto", true, false, true),
+            Some(Protocol::Sixel)
+        );
+        for requested in ["", "auto", "off", "unknown"] {
+            assert_eq!(select_protocol(requested, true, false, false), None);
+        }
+        for requested in ["sixel", "iterm", "auto"] {
+            assert_eq!(select_protocol(requested, false, false, true), None);
+            assert_eq!(select_protocol(requested, true, true, true), None);
+        }
+        assert_eq!(
+            select_protocol("iterm", true, false, false),
+            Some(Protocol::Iterm)
+        );
+        assert_eq!(
+            select_protocol("SIXEL", true, false, false),
+            Some(Protocol::Sixel)
+        );
+        assert_eq!(select_protocol("typo", true, false, true), None);
+    }
+
+    use super::*;
+    use ratatui::buffer::CellWidth;
+    #[test]
+    fn resize_uses_four_buckets_without_overflow_or_stretching() {
+        let geometry = Geometry {
+            columns: 80,
+            cell_width: 10,
+            cell_height: 20,
+            protocol: Some(Protocol::Sixel),
+        };
+        for (columns, expected_bucket) in [(3, 1), (6, 2), (9, 3), (12, 4), (80, 4)] {
+            let (width, height, bucket) = display_bounds(
+                (200, 80),
+                Geometry {
+                    columns,
+                    ..geometry
+                },
+                2,
+            );
+            assert_eq!(bucket, expected_bucket);
+            assert_eq!(width, 30 * u32::from(bucket));
+            assert_eq!(height, 12 * u32::from(bucket));
+        }
+        for columns in 1..=240 {
+            let (width, height, bucket) = display_bounds(
+                (200, 80),
+                Geometry {
+                    columns,
+                    ..geometry
+                },
+                2,
+            );
+            assert!(width <= u32::from(columns) * 10 && width <= 120);
+            assert!(height <= 48 && bucket <= 4);
+        }
+        assert_eq!(
+            display_bounds(
+                (200, 80),
+                Geometry {
+                    columns: 1,
+                    ..geometry
+                },
+                2
+            )
+            .2,
+            0
+        );
+    }
+    #[test]
+    fn raster_caps_at_one_point_two_natural_size_and_respects_viewport() {
+        let directory = tempfile::tempdir().unwrap();
+        let path = directory.path().join("diagram.png");
+        image::DynamicImage::new_rgb8(200, 80).save(&path).unwrap();
+        for protocol in [Protocol::Sixel, Protocol::Iterm] {
+            let mut geometry = Geometry {
+                columns: 40,
+                cell_width: 10,
+                cell_height: 20,
+                protocol: Some(protocol),
+            };
+            let rows = prepare(&path, geometry, 2).unwrap();
+            assert_eq!(rows.len(), 3);
+            assert!(rows.iter().all(|row| row.columns == 12));
+            geometry.columns = 5;
+            let rows = prepare(&path, geometry, 2).unwrap();
+            assert_eq!(rows.len(), 1);
+            assert!(rows.iter().all(|row| row.columns == 3));
+        }
+    }
+    #[test]
+    fn mermaid_slices_cover_partial_rows_without_changing_cell_width() {
+        let image = image::DynamicImage::new_rgb8(100, 45);
+        for protocol in [Protocol::Sixel, Protocol::Iterm] {
+            let rows = encode(
+                &image,
+                Geometry {
+                    columns: 10,
+                    cell_width: 10,
+                    cell_height: 20,
+                    protocol: Some(protocol),
+                },
+                protocol,
+            )
+            .unwrap();
+            assert_eq!(rows.len(), 3);
+            let mut buffer = Buffer::empty(Rect::new(0, 0, 20, 5));
+            let background = ratatui::style::Color::Rgb(80, 64, 68);
+            buffer.set_style(
+                Rect::new(2, 2, 10, 1),
+                ratatui::style::Style::default().bg(background),
+            );
+            rows[1].render(Rect::new(2, 2, 10, 1), &mut buffer);
+            assert_eq!(buffer[(2, 2)].bg, background);
+            assert_eq!(buffer[(11, 2)].bg, background);
+            assert_eq!(buffer[(2, 2)].cell_width(), 10);
+            assert_eq!(buffer[(11, 2)].diff_option, CellDiffOption::Skip);
+            assert_eq!(buffer[(2, 3)].symbol(), " ");
+            clear_occluded_rows(&mut buffer);
+            assert!(buffer[(2, 2)].symbol().contains("\x1b7"));
+            buffer[(6, 2)].reset();
+            buffer[(6, 2)].set_symbol("X");
+            clear_occluded_rows(&mut buffer);
+            assert_eq!(buffer[(6, 2)].symbol(), "X");
+            assert_eq!(buffer[(2, 2)].symbol(), " ");
+            assert_ne!(buffer[(11, 2)].diff_option, CellDiffOption::Skip);
+            let mut clipped = Buffer::empty(Rect::new(0, 0, 9, 1));
+            rows[0].render(clipped.area, &mut clipped);
+            assert!(clipped.content.iter().all(|cell| cell.symbol() == " "));
+            if matches!(protocol, Protocol::Iterm) {
+                let encoded = rows[2]
+                    .payload
+                    .split_once(':')
+                    .unwrap()
+                    .1
+                    .trim_end_matches('\x07');
+                let png = base64::engine::general_purpose::STANDARD
+                    .decode(encoded)
+                    .unwrap();
+                let last = image::load_from_memory(&png).unwrap();
+                assert_eq!(last.dimensions(), (100, 20));
+                assert_eq!(last.get_pixel(0, 10).0[3], 0);
+            }
+        }
+    }
+}
