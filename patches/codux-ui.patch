--- /dev/null
+++ b/codex-rs/tui/src/mycodx_status.rs
@@ -0,0 +1,506 @@
+//! A background pulse for live work, and a static completion surface.
+//!
+//! The existing status widget owns frame scheduling; these pure presentation
+//! helpers never request redraws or touch input. Use card colors so `/custom`
+//! previews also affect status surfaces, without changing stored settings.
+use super::{Align, Background, CardStyle, Section, current, theme};
+use crate::color::blend;
+use crate::terminal_palette::best_color;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::{Color, Modifier, Style};
+use serde::{Deserialize, Serialize};
+use std::time::Duration;
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub(crate) enum WorkingAnimation {
+    OneSecond,
+    #[default]
+    #[serde(alias = "original", alias = "blink")]
+    TwoSeconds,
+    ThreeSeconds,
+    #[serde(alias = "slow_pulse")]
+    FourSeconds,
+}
+
+impl WorkingAnimation {
+    pub(crate) const ALL: [Self; 4] = [
+        Self::OneSecond,
+        Self::TwoSeconds,
+        Self::ThreeSeconds,
+        Self::FourSeconds,
+    ];
+
+    pub(crate) fn label(self) -> &'static str {
+        match self {
+            Self::OneSecond => "1 second",
+            Self::TwoSeconds => "2 seconds",
+            Self::ThreeSeconds => "3 seconds",
+            Self::FourSeconds => "4 seconds",
+        }
+    }
+
+    pub(crate) fn description(self) -> &'static str {
+        match self {
+            Self::OneSecond => "Smooth background pulse, every 1 second.",
+            Self::TwoSeconds => "Smooth background pulse, every 2 seconds.",
+            Self::ThreeSeconds => "Smooth background pulse, every 3 seconds.",
+            Self::FourSeconds => "Smooth background pulse, every 4 seconds.",
+        }
+    }
+
+    fn period_seconds(self) -> u64 {
+        match self {
+            Self::OneSecond => 1,
+            Self::TwoSeconds => 2,
+            Self::ThreeSeconds => 3,
+            Self::FourSeconds => 4,
+        }
+    }
+
+    fn phase(self, elapsed: Duration) -> f32 {
+        let seconds = elapsed.as_secs_f64();
+        let period = self.period_seconds() as f64;
+        ((1.0 - (std::f64::consts::TAU * (seconds % period) / period).cos()) * 0.5) as f32
+    }
+}
+
+pub(crate) fn working_style(elapsed: Duration, animated: bool) -> Style {
+    // Share the cards' palette and color capability fallback.
+    let phase = if animated {
+        current().working_animation.phase(elapsed)
+    } else {
+        0.0
+    };
+    surface(Section::Intermediate, phase)
+}
+
+pub(crate) fn completed_style() -> Style {
+    surface(Section::Answers, 0.0)
+}
+
+// Same units as /custom: one column each side, one half-row top and bottom.
+pub(crate) const PADDING_X: u16 = 1;
+pub(crate) const PADDING_HALF_ROWS: u16 = 1;
+
+pub(crate) fn content_width(width: u16) -> u16 {
+    width.saturating_sub(2 * PADDING_X.min(width.saturating_sub(1) / 2))
+}
+
+pub(crate) fn completed_card() -> CardStyle {
+    let mut card = current().card(Section::Answers);
+    card.align = Align::Left;
+    card.max_width = 100;
+    card.padding_x = PADDING_X;
+    card.padding_y = PADDING_HALF_ROWS;
+    card.title_visible = false;
+    card.expandable = false;
+    if let Some(Color::Rgb(r, g, b)) = completed_style().bg {
+        card.background = Background::Rgb(r, g, b);
+    }
+    card
+}
+
+/// Paint decorative half-row edges without making them part of status text.
+/// Very short areas omit vertical padding so the interrupt hint stays visible.
+pub(crate) fn padded_surface(area: Rect, buf: &mut Buffer, style: Style) -> Rect {
+    if area.is_empty() {
+        return area;
+    }
+    let vertical = u16::from(area.height >= 3);
+    let inset = PADDING_X.min(area.width.saturating_sub(1) / 2);
+    let body = Rect::new(
+        area.x,
+        area.y + vertical,
+        area.width,
+        area.height - 2 * vertical,
+    );
+    buf.set_style(body, style);
+    if vertical != 0 {
+        let filled = style.bg.is_some_and(|bg| bg != Color::Reset);
+        let edge_style = Style::default()
+            .fg(style.bg.unwrap_or(Color::Reset))
+            .bg(Color::Reset);
+        for x in area.x..area.right() {
+            if let Some(cell) = buf.cell_mut((x, area.y)) {
+                cell.set_symbol(if filled { "▄" } else { " " })
+                    .set_style(edge_style);
+            }
+            if let Some(cell) = buf.cell_mut((x, area.bottom() - 1)) {
+                cell.set_symbol(if filled { "▀" } else { " " })
+                    .set_style(edge_style);
+            }
+        }
+    }
+    Rect::new(
+        body.x + inset,
+        body.y,
+        content_width(area.width),
+        body.height,
+    )
+}
+
+fn surface(section: Section, phase: f32) -> Style {
+    let card = current().card(section);
+    let paint = card.colors();
+    if !paint.filled
+        && (card.background != Background::None || crate::terminal_palette::default_bg().is_none())
+    {
+        return paint.body().remove_modifier(Modifier::DIM);
+    }
+    let fg = paint.fg;
+    let mut base = paint.bg;
+    // Keep a steady foreground throughout the pulse. For unusually bright/dark
+    // custom fills, move the surface away from the text before raising it.
+    let extreme = if theme::contrast(fg, (255, 255, 255)) > theme::contrast(fg, (0, 0, 0)) {
+        (255, 255, 255)
+    } else {
+        (0, 0, 0)
+    };
+    for _ in 0..32 {
+        if theme::contrast(fg, blend(fg, base, 0.18)) >= 4.5 {
+            break;
+        }
+        base = blend(extreme, base, 0.1);
+    }
+    let bg = blend(fg, base, 0.06 + 0.12 * phase);
+    Style::default()
+        .bg(best_color(bg))
+        .fg(best_color(fg))
+        .remove_modifier(Modifier::DIM)
+}
+
+pub(crate) const WORKING_PREVIEW_ID: &str = "codux-working-animation";
+
+/// Use the production status renderer so preview geometry, colors and motion cannot drift.
+pub(crate) fn attach_preview(
+    params: &mut crate::bottom_pane::SelectionViewParams,
+    tx: crate::app_event_sender::AppEventSender,
+    frame_requester: crate::tui::FrameRequester,
+    tui: &codex_config::types::Tui,
+) {
+    let mut status = crate::status_indicator_widget::StatusIndicatorWidget::new(
+        tx,
+        frame_requester,
+        tui.animations,
+        tui.effects,
+    );
+    status.set_interrupt_hint_visible(false);
+    status.update_details(
+        Some("Preparing an answer...".into()),
+        crate::status_indicator_widget::StatusDetailsCapitalization::Preserve,
+        1,
+    );
+    params.view_id = Some(WORKING_PREVIEW_ID);
+    params.side_content = Box::new(WorkingPreview {
+        status,
+        timer: crate::status_indicator_widget::StatusTimer::default(),
+    });
+    params.side_content_width = crate::bottom_pane::SideContentWidth::Half;
+    params.side_content_min_width = 24;
+    params.preserve_side_content_bg = true;
+    params.footer_note = Some(
+        if tui.animations && tui.effects.shimmer {
+            "Preview only; no task is running. Text stays visible in every animation."
+        } else {
+            "Background animation is disabled by Codex animations or shimmer settings."
+        }
+        .into(),
+    );
+}
+
+struct WorkingPreview {
+    status: crate::status_indicator_widget::StatusIndicatorWidget,
+    timer: crate::status_indicator_widget::StatusTimer,
+}
+
+impl crate::render::renderable::Renderable for WorkingPreview {
+    fn desired_height(&self, width: u16) -> u16 {
+        if width == 0 {
+            return 0;
+        }
+        self.status
+            .with_timer(&self.timer)
+            .desired_height(width)
+            .saturating_add(2)
+    }
+
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        use ratatui::style::Stylize;
+        use ratatui::text::Line;
+        use ratatui::widgets::Widget;
+
+        if area.is_empty() {
+            return;
+        }
+        let height = self.desired_height(area.width).min(area.height);
+        let top = area.y + area.height.saturating_sub(height) / 2;
+        Line::from("Preview")
+            .dim()
+            .render(Rect::new(area.x, top, area.width, 1), buf);
+        if height > 2 {
+            self.status
+                .with_timer(&self.timer)
+                .render(Rect::new(area.x, top + 2, area.width, height - 2), buf);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn codux_adaptive_unknown_palette_has_no_solid_half_block_status_edges() {
+        crate::terminal_palette::with_test_default_colors(None, || {
+            let settings = Settings::default()
+                .change_card(Section::Intermediate, |card| card.background = Background::Auto);
+            crate::mycodx_ui::with_settings(settings, || {
+                let style = working_style(Duration::from_millis(500), true);
+                assert_eq!(style.bg, Some(Color::Reset));
+                let area = Rect::new(0, 0, 24, 4);
+                let mut buffer = Buffer::empty(area);
+                padded_surface(area, &mut buffer, style);
+                assert!(buffer.content.iter().all(|cell| cell.symbol() == " "));
+            });
+        });
+    }
+
+    use crate::mycodx_ui::{Background, Settings, with_settings};
+    use ratatui::style::Color;
+
+    #[test]
+    fn codux_animation_modes_have_distinct_cycles_and_respect_reduced_motion() {
+        for animation in WorkingAnimation::ALL {
+            let period = animation.period_seconds() * 1000;
+            let peak = period / 2;
+            let mut settings = Settings::web();
+            settings.working_animation = animation;
+            with_settings(settings, || {
+                let idle = working_style(Duration::ZERO, true);
+                let bright = working_style(Duration::from_millis(peak), true);
+                assert_ne!(idle.bg, bright.bg);
+                assert_eq!(idle.fg, bright.fg);
+                assert_eq!(working_style(Duration::from_millis(period), true), idle);
+                assert_eq!(working_style(Duration::from_millis(peak), false), idle);
+                let middle = working_style(Duration::from_millis(peak / 2), true);
+                assert_ne!(middle.bg, idle.bg);
+                assert_ne!(middle.bg, bright.bg);
+            });
+        }
+    }
+
+    #[test]
+    fn codux_preview_uses_real_status_colors_and_only_requests_local_redraws() {
+        use crate::app_event_sender::AppEventSender;
+        use crate::bottom_pane::{ListSelectionView, SelectionViewParams};
+        use crate::render::renderable::Renderable;
+        use crate::tui::FrameRequester;
+
+        with_settings(Settings::web(), || {
+            for animated in [false, true] {
+                let (tx, mut events) = tokio::sync::mpsc::unbounded_channel();
+                let tx = AppEventSender::new(tx);
+                let (frames, mut draws) = FrameRequester::test_channel();
+                let tui = codex_config::types::Tui {
+                    animations: animated,
+                    ..Default::default()
+                };
+                let home = tempfile::tempdir().unwrap();
+                let mut params: SelectionViewParams =
+                    super::super::page_picker(home.path(), super::super::Page::WorkingAnimation)
+                        .unwrap();
+                attach_preview(&mut params, tx.clone(), frames, &tui);
+                assert!(params.preserve_side_content_bg);
+                let view = ListSelectionView::new(
+                    params,
+                    tx,
+                    crate::keymap::RuntimeKeymap::defaults().list,
+                );
+                for width in [48, 120] {
+                    let height = view.desired_height(width);
+                    let area = Rect::new(1, 1, width, height);
+                    let mut buf = Buffer::empty(Rect::new(0, 0, width + 2, height + 2));
+                    view.render(area, &mut buf);
+                    let text = buf
+                        .content()
+                        .iter()
+                        .map(|cell| cell.symbol())
+                        .collect::<String>();
+                    assert!(text.contains("Preview"));
+                    assert!(text.contains("Working"));
+                    if !animated {
+                        assert!(buf.content().iter().any(
+                            |cell| cell.bg == working_style(Duration::ZERO, false).bg.unwrap()
+                        ));
+                    }
+                    assert_eq!(buf[(0, 0)], ratatui::buffer::Cell::default());
+                    assert_eq!(
+                        buf[(width + 1, height + 1)],
+                        ratatui::buffer::Cell::default()
+                    );
+                }
+                assert_eq!(draws.try_recv().is_ok(), animated);
+                assert!(events.try_recv().is_err());
+            }
+        });
+    }
+
+    #[test]
+    fn codux_preview_background_changes_between_frames_without_changing_text() {
+        use crate::app_event_sender::AppEventSender;
+        use crate::render::renderable::Renderable;
+        use crate::status_indicator_widget::{StatusIndicatorWidget, StatusTimer};
+        use crate::tui::FrameRequester;
+
+        for animation in WorkingAnimation::ALL {
+            let dim_time = 0;
+            let bright_time = animation.period_seconds() * 500;
+            let mut settings = Settings::web();
+            settings.working_animation = animation;
+            with_settings(settings, || {
+                for animated in [false, true] {
+                    let (tx, _events) = tokio::sync::mpsc::unbounded_channel();
+                    let mut status = StatusIndicatorWidget::new(
+                        AppEventSender::new(tx),
+                        FrameRequester::test_dummy(),
+                        animated,
+                        Default::default(),
+                    );
+                    status.set_interrupt_hint_visible(false);
+                    let mut preview = WorkingPreview {
+                        status,
+                        timer: StatusTimer::default(),
+                    };
+                    let area = Rect::new(0, 0, 40, preview.desired_height(40));
+                    let mut frames = Vec::new();
+                    for millis in [dim_time, bright_time] {
+                        preview.timer.reset(Duration::from_millis(millis));
+                        let mut buf = Buffer::empty(area);
+                        preview.render(area, &mut buf);
+                        frames.push(buf);
+                    }
+                    // Check a blank part of the status surface, not the spinner or timer.
+                    assert_eq!(frames[0][(39, 3)].symbol(), " ");
+                    assert_eq!(frames[0][(39, 3)].bg != frames[1][(39, 3)].bg, animated);
+                    let mut header_colors = Vec::new();
+                    for frame in frames {
+                        let text = frame
+                            .content()
+                            .iter()
+                            .map(|cell| cell.symbol())
+                            .collect::<String>();
+                        assert!(text.contains("Working"));
+                        let header = frame
+                            .content()
+                            .iter()
+                            .find(|cell| cell.symbol() == "W")
+                            .unwrap();
+                        // Upstream shimmer now owns the header foreground; the card
+                        // owns its background. Static mode must keep a stable color.
+                        assert_ne!(header.fg, header.bg);
+                        header_colors.push(header.fg);
+                    }
+                    if !animated {
+                        assert_eq!(header_colors[0], header_colors[1]);
+                    }
+                }
+            });
+        }
+    }
+
+    #[test]
+    fn mycodx_status_half_padding_matches_worked_and_leaves_outer_cells_clear() {
+        with_settings(Settings::web(), || {
+            let card = completed_card();
+            assert_eq!(card.padding_x, 1);
+            assert_eq!(card.padding_y, 1);
+            assert!(!card.title_visible);
+            assert!(!card.expandable);
+            for width in [1, 2, 3, 80] {
+                for height in [0, 1, 2, 3, 5] {
+                    let area = Rect::new(2, 1, width, height);
+                    let outer = Rect::new(0, 0, 84, 8);
+                    let mut buf = Buffer::empty(outer);
+                    let style = working_style(Duration::ZERO, false);
+                    let inner = padded_surface(area, &mut buf, style);
+                    assert_eq!(content_width(width), card.content_width(width));
+                    if height >= 3 {
+                        assert_eq!(inner.y, area.y + 1);
+                        assert_eq!(inner.height, height - 2);
+                        assert_eq!(buf[(area.x, area.y)].symbol(), "▄");
+                        assert_eq!(buf[(area.x, area.y)].fg, style.bg.unwrap());
+                        assert_eq!(buf[(area.x, area.bottom() - 1)].symbol(), "▀");
+                    }
+                    assert_eq!(buf[(1, 1)], ratatui::buffer::Cell::default());
+                    assert_eq!(buf[(area.right(), 1)], ratatui::buffer::Cell::default());
+                }
+            }
+        });
+    }
+
+    #[test]
+    fn mycodx_status_pulse_has_a_stable_foreground_and_static_reduced_motion() {
+        for outer in [(24, 24, 24), (245, 245, 245)] {
+            crate::terminal_palette::with_test_default_colors(
+                crate::terminal_probe::DefaultColors {
+                    bg: outer,
+                    fg: (127, 127, 127),
+                },
+                || {
+                    with_settings(Settings::web(), || {
+                        let resting = working_style(Duration::ZERO, true);
+                        let peak = working_style(Duration::from_millis(1000), true);
+                        assert_ne!(resting.bg, peak.bg);
+                        assert_eq!(resting.fg, peak.fg);
+                        assert_eq!(working_style(Duration::from_millis(2000), true), resting);
+                        assert_eq!(working_style(Duration::from_millis(1500), false), resting);
+                        assert_eq!(working_style(Duration::from_secs(300), false), resting);
+                        assert!(!completed_style().add_modifier.contains(Modifier::DIM));
+                    })
+                },
+            );
+        }
+    }
+
+    #[test]
+    fn mycodx_status_keeps_text_readable_through_the_pulse_for_custom_fills() {
+        crate::terminal_palette::with_test_default_colors(
+            crate::terminal_probe::DefaultColors {
+                bg: (24, 24, 24),
+                fg: (240, 240, 240),
+            },
+            || {
+                for bg in (0..=255).map(|v| (v, v, v)).chain([
+                    (0, 0, 0),
+                    (255, 255, 255),
+                    (140, 140, 140),
+                    (150, 150, 150),
+                    (99, 48, 65),
+                    (35, 63, 105),
+                ]) {
+                    let settings = Settings::web().change_card(Section::Intermediate, |card| {
+                        card.background = Background::Rgb(bg.0, bg.1, bg.2);
+                    });
+                    with_settings(settings, || {
+                        let fg = working_style(Duration::ZERO, true).fg;
+                        for millis in (0..=3000).step_by(100) {
+                            let style = working_style(Duration::from_millis(millis), true);
+                            assert_eq!(style.fg, fg);
+                            let Some(Color::Rgb(r, g, b)) = style.bg else {
+                                panic!("expected RGB background")
+                            };
+                            let Some(Color::Rgb(fr, fg, fb)) = style.fg else {
+                                panic!("expected RGB foreground")
+                            };
+                            assert!(
+                                theme::contrast((r, g, b), (fr, fg, fb)) >= 4.5,
+                                "{bg:?} at {millis}"
+                            );
+                        }
+                    });
+                }
+            },
+        );
+    }
+}
