+//! Diagram-specific, shared adaptive palette. Text antialiasing is not reduced to RGB332.
+use std::collections::BTreeMap;
+use std::fmt::Write;
+
+const TRANSPARENT: u16 = 256;
+type Color = [u8; 3];
+
+fn color(pixel: &[u8]) -> Color {
+    [pixel[0], pixel[1], pixel[2]].map(|c| ((u32::from(c) * 100 + 127) / 255) as u8)
+}
+
+pub(super) struct Indexed {
+    width: usize,
+    height: usize,
+    palette: Vec<Color>,
+    pixels: Vec<u16>,
+}
+
+impl Indexed {
+    pub(super) fn new(rgba: &[u8], width: u32, height: u32) -> Self {
+        assert_eq!(rgba.len(), width as usize * height as usize * 4);
+        let mut histogram = BTreeMap::<Color, u64>::new();
+        for pixel in rgba.chunks_exact(4).filter(|p| p[3] >= 128) {
+            *histogram.entry(color(pixel)).or_default() += 1;
+        }
+        let colors: Vec<_> = histogram.into_iter().collect();
+        let mut buckets = vec![colors.clone()];
+        while buckets.len() < 256 {
+            let Some(index) = buckets
+                .iter()
+                .enumerate()
+                .filter(|(_, b)| b.len() > 1)
+                .max_by_key(|(_, b)| {
+                    let (_, range) = longest_axis(b);
+                    u64::from(range) * b.iter().map(|(_, count)| count).sum::<u64>()
+                })
+                .map(|(i, _)| i)
+            else {
+                break;
+            };
+            let mut bucket = buckets.swap_remove(index);
+            let (axis, _) = longest_axis(&bucket);
+            bucket.sort_unstable_by_key(|(c, _)| (c[axis], *c));
+            let half = bucket.iter().map(|(_, count)| count).sum::<u64>() / 2;
+            let mut accumulated = 0;
+            let split = bucket
+                .iter()
+                .position(|(_, count)| {
+                    accumulated += count;
+                    accumulated >= half
+                })
+                .unwrap_or(0)
+                .saturating_add(1)
+                .min(bucket.len() - 1);
+            let right = bucket.split_off(split);
+            buckets.push(bucket);
+            buckets.push(right);
+        }
+        let palette: Vec<Color> = buckets
+            .iter()
+            .filter(|b| !b.is_empty())
+            .map(|b| {
+                let weight = b.iter().map(|(_, n)| n).sum::<u64>();
+                std::array::from_fn(|axis| {
+                    ((b.iter().map(|(c, n)| u64::from(c[axis]) * n).sum::<u64>() + weight / 2)
+                        / weight) as u8
+                })
+            })
+            .collect();
+        let lookup: BTreeMap<_, _> = colors
+            .iter()
+            .map(|(c, _)| {
+                let index = palette
+                    .iter()
+                    .enumerate()
+                    .min_by_key(|(_, p)| {
+                        c.iter()
+                            .zip(p.iter())
+                            .map(|(a, b)| (i32::from(*a) - i32::from(*b)).pow(2))
+                            .sum::<i32>()
+                    })
+                    .map_or(0, |(i, _)| i as u16);
+                (*c, index)
+            })
+            .collect();
+        let pixels = rgba
+            .chunks_exact(4)
+            .map(|p| {
+                if p[3] < 128 {
+                    TRANSPARENT
+                } else {
+                    lookup[&color(p)]
+                }
+            })
+            .collect();
+        Self {
+            width: width as usize,
+            height: height as usize,
+            palette,
+            pixels,
+        }
+    }
+
+    pub(super) fn strip(&self, top: usize, height: usize, padded_width: usize) -> String {
+        let mut output = format!("\x1bP9;1;0q\"1;1;{padded_width};{height}");
+        let end = (top + height).min(self.height);
+        let mut used = [false; 256];
+        for &index in &self.pixels[top * self.width..end * self.width] {
+            if index != TRANSPARENT {
+                used[usize::from(index)] = true;
+            }
+        }
+        for (index, &[r, g, b]) in self.palette.iter().enumerate() {
+            if used[index] {
+                let _ = write!(output, "#{index};2;{r};{g};{b}");
+            }
+        }
+        for band in (0..height).step_by(6) {
+            if band > 0 {
+                output.push('-');
+            }
+            let mut planes = BTreeMap::<u16, Vec<u8>>::new();
+            for bit in 0..6.min(height - band) {
+                let y = top + band + bit;
+                if y >= self.height {
+                    break;
+                }
+                for x in 0..self.width {
+                    let index = self.pixels[y * self.width + x];
+                    if index != TRANSPARENT {
+                        planes.entry(index).or_insert_with(|| vec![0; self.width])[x] |= 1 << bit;
+                    }
+                }
+            }
+            for (plane, (index, values)) in planes.into_iter().enumerate() {
+                if plane > 0 {
+                    output.push('$');
+                }
+                let _ = write!(output, "#{index}");
+                let mut start = 0;
+                while start < values.len() {
+                    let value = values[start];
+                    let length = values[start..].iter().take_while(|v| **v == value).count();
+                    let character = char::from(63 + value);
+                    if length >= 4 {
+                        let _ = write!(output, "!{length}{character}");
+                    } else {
+                        output.extend(std::iter::repeat_n(character, length));
+                    }
+                    start += length;
+                }
+            }
+        }
+        output.push_str("\x1b\\");
+        output
+    }
+}
+
+fn longest_axis(bucket: &[(Color, u64)]) -> (usize, u8) {
+    (0..3)
+        .map(|axis| {
+            let min = bucket.iter().map(|(c, _)| c[axis]).min().unwrap_or(0);
+            let max = bucket.iter().map(|(c, _)| c[axis]).max().unwrap_or(0);
+            (axis, max - min)
+        })
+        .max_by_key(|(_, range)| *range)
+        .unwrap_or((0, 0))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn diagram_colors_keep_sixel_precision_and_transparency() {
+        let rgba = [
+            24, 24, 24, 255, 29, 77, 78, 255, 230, 230, 230, 255, 0, 0, 0, 0,
+        ];
+        let image = Indexed::new(&rgba, 4, 1);
+        assert_eq!(image.palette.len(), 3);
+        for (pixel, &index) in rgba.chunks_exact(4).zip(&image.pixels).take(3) {
+            for (original, encoded) in pixel[..3].iter().zip(image.palette[usize::from(index)]) {
+                assert!((f32::from(*original) - f32::from(encoded) * 2.55).abs() <= 1.3);
+            }
+        }
+        assert_eq!(image.pixels[3], TRANSPARENT);
+        assert!(image.strip(0, 20, 10).starts_with("\x1bP9;1;0q\"1;1;10;20"));
+    }
+    #[test]
+    fn palette_is_bounded_and_shared_across_row_strips() {
+        let rgba: Vec<u8> = (0..512)
+            .flat_map(|i| {
+                [
+                    ((i / 64) * 32) as u8,
+                    ((i / 8 % 8) * 32) as u8,
+                    ((i % 8) * 32) as u8,
+                    255,
+                ]
+            })
+            .collect();
+        let image = Indexed::new(&rgba, 32, 16);
+        assert_eq!(image.palette.len(), 256);
+        assert!(image.pixels.iter().all(|i| *i < 256));
+        for top in [0, 8] {
+            let encoded = image.strip(top, 8, 32);
+            for &index in &image.pixels[top * 32..(top + 8) * 32] {
+                let [r, g, b] = image.palette[usize::from(index)];
+                assert!(encoded.contains(&format!("#{index};2;{r};{g};{b}")));
+            }
+        }
+        let empty = Indexed::new(&[0; 16], 2, 2);
+        assert!(empty.palette.is_empty());
+        assert!(empty.strip(0, 20, 10).ends_with("\x1b\\"));
+    }
+}
