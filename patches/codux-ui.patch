+//! Presentation-only cards. Canonical history, tool execution and persisted source stay upstream.
+
+use super::*;
+use crate::history_cell::AgentMarkdownCell;
+use crate::history_cell::UserHistoryCell;
+use std::collections::hash_map::DefaultHasher;
+use std::hash::Hash;
+use std::hash::Hasher;
+
+pub(super) fn tool_content_width(width: u16) -> u16 {
+    crate::mycodx_ui::current()
+        .card(crate::mycodx_ui::Section::Tools)
+        .content_width(width)
+}
+
+pub(super) fn completion_layout(cell: &Arc<dyn HistoryCell>, width: u16) -> Option<TextLayout> {
+    if !cell
+        .as_any()
+        .is::<crate::history_cell::FinalMessageSeparator>()
+    {
+        return None;
+    }
+    let style = crate::mycodx_ui::status::completed_card();
+    let lines = cell
+        .raw_lines()
+        .into_iter()
+        .map(|line| HyperlinkLine::from(line.style(crate::mycodx_ui::status::completed_style())))
+        .collect::<Vec<_>>();
+    if lines.is_empty() {
+        return Some(TextLayout::new(lines, width));
+    }
+    Some(
+        TextLayout::new(lines, style.content_width(width))
+            .with_common_card(width, style, None, true, true, true),
+    )
+}
+
+#[cfg(test)]
+pub(super) fn answer_content_width(width: u16) -> u16 {
+    crate::mycodx_ui::current()
+        .card(crate::mycodx_ui::Section::Answers)
+        .message_content_width(width)
+}
+
+pub(super) fn section(cell: &Arc<dyn HistoryCell>) -> Option<crate::mycodx_ui::Section> {
+    use crate::mycodx_ui::Section;
+    if let Some(user) = cell.as_any().downcast_ref::<UserHistoryCell>() {
+        return Some(if user.mycodx_reply {
+            Section::Replies
+        } else {
+            Section::Questions
+        });
+    }
+    if cell
+        .as_any()
+        .is::<crate::history_cell::RequestUserInputResultCell>()
+    {
+        return Some(Section::Replies);
+    }
+    if cell.as_any().is::<crate::history_cell::ProposedPlanCell>()
+        || cell
+            .as_any()
+            .is::<crate::history_cell::ProposedPlanStreamCell>()
+    {
+        return Some(Section::Answers);
+    }
+    if let Some(answer) = cell.as_any().downcast_ref::<AgentMarkdownCell>() {
+        return Some(if answer.mycodx_is_final_answer() {
+            Section::Answers
+        } else {
+            Section::Intermediate
+        });
+    }
+    if let Some(stream) = cell
+        .as_any()
+        .downcast_ref::<crate::history_cell::AgentMessageCell>()
+    {
+        return Some(if stream.mycodx_final_answer {
+            Section::Answers
+        } else {
+            Section::Intermediate
+        });
+    }
+    is_tool(cell).then_some(Section::Tools)
+}
+
+#[cfg(test)]
+pub(super) fn hidden(cell: &Arc<dyn HistoryCell>) -> bool {
+    section(cell).is_some_and(|s| !crate::mycodx_ui::current().visible(s))
+}
+
+pub(super) fn is_tool(cell: &Arc<dyn HistoryCell>) -> bool {
+    !cell.as_any().is::<crate::history_cell::PatchFailureCell>() && !tool_ids(cell).is_empty()
+}
+
+fn tool_ids(cell: &Arc<dyn HistoryCell>) -> Vec<String> {
+    if let Some(search) = cell
+        .as_any()
+        .downcast_ref::<crate::history_cell::WebSearchCell>()
+    {
+        return vec![format!("web:{}", search.call_id())];
+    }
+    cell.activity_ids()
+}
+
+/// Only adjacent tool cells join. Questions, answers, notices and approvals remain boundaries.
+pub(super) fn tool_member(cells: &[Arc<dyn HistoryCell>], index: usize) -> bool {
+    index > 0
+        && cells
+            .get(index)
+            .is_some_and(|cell| is_tool(cell) && cell.image_path().is_none())
+        && cells
+            .get(index - 1)
+            .is_some_and(|cell| is_tool(cell) && cell.image_path().is_none())
+}
+
+pub(super) fn tool_end(cells: &[Arc<dyn HistoryCell>], index: usize) -> Option<usize> {
+    if !cells.get(index).is_some_and(is_tool) || tool_member(cells, index) {
+        return None;
+    }
+    // Native previews belong to one entry. Keep image tools as individual cards so
+    // adjacent images cannot disappear inside a text-only grouped layout.
+    if cells[index].image_path().is_some() {
+        return Some(index + 1);
+    }
+    Some(
+        index
+            + cells[index..]
+                .iter()
+                .take_while(|cell| is_tool(cell) && cell.image_path().is_none())
+                .count(),
+    )
+}
+
+/// A prompt owns its replies and all assistant output until the next original prompt.
+pub(super) fn prompt_start(cells: &[Arc<dyn HistoryCell>], index: usize) -> usize {
+    if cells.is_empty() {
+        return 0;
+    }
+    (0..=index.min(cells.len() - 1))
+        .rev()
+        .find(|i| section(&cells[*i]) == Some(crate::mycodx_ui::Section::Questions))
+        .unwrap_or(0)
+}
+
+pub(super) fn identity(cells: &[Arc<dyn HistoryCell>], index: usize) -> String {
+    let Some(cell) = cells.get(index) else {
+        return "mycodx-live-message".into();
+    };
+    if let Some(user) = cell.as_any().downcast_ref::<UserHistoryCell>() {
+        return format!("mycodx-user:{}", user.mycodx_id);
+    }
+    if let Some(plan) = cell
+        .as_any()
+        .downcast_ref::<crate::history_cell::ProposedPlanCell>()
+    {
+        return plan.mycodx_id.clone();
+    }
+    if let Some(plan) = cell
+        .as_any()
+        .downcast_ref::<crate::history_cell::ProposedPlanStreamCell>()
+    {
+        if let Some(id) = &plan.mycodx_id {
+            return id.clone();
+        }
+        if cell.is_stream_continuation() && index > 0 {
+            return identity(cells, index - 1);
+        }
+    }
+    if let Some(answer) = cell.as_any().downcast_ref::<AgentMarkdownCell>() {
+        return answer.mycodx_answer_id().to_owned();
+    }
+    if let Some(stream) = cell
+        .as_any()
+        .downcast_ref::<crate::history_cell::AgentMessageCell>()
+    {
+        if let Some(id) = &stream.mycodx_id {
+            return id.clone();
+        }
+        if cell.is_stream_continuation() && index > 0 {
+            return identity(cells, index - 1);
+        }
+    }
+    let mut hash = DefaultHasher::new();
+    cell.copy_source().hash(&mut hash);
+    format!("mycodx-cell:{:?}:{}", EntryKey::cell(cell), hash.finish())
+}
+
+pub(super) fn intermediate_id(cells: &[Arc<dyn HistoryCell>], index: usize) -> String {
+    format!(
+        "mycodx-progress:{}",
+        identity(cells, prompt_start(cells, index))
+    )
+}
+
+/// Only the last answer candidate for an original prompt is styled as its final answer.
+/// Async question forms are tagged intermediate at ingestion, even with a missing phase.
+pub(super) fn section_at(
+    cells: &[Arc<dyn HistoryCell>],
+    index: usize,
+) -> Option<crate::mycodx_ui::Section> {
+    use crate::mycodx_ui::Section;
+    let kind = section(cells.get(index)?);
+    if kind != Some(Section::Answers) {
+        return kind;
+    }
+    let id = identity(cells, index);
+    for next in index + 1..cells.len() {
+        match section(&cells[next]) {
+            Some(Section::Questions) => break,
+            Some(Section::Answers) if identity(cells, next) != id => {
+                return Some(Section::Intermediate);
+            }
+            _ => {}
+        }
+    }
+    kind
+}
+
+fn joins(cells: &[Arc<dyn HistoryCell>], a: usize, b: usize) -> bool {
+    use crate::mycodx_ui::Section;
+    match section_at(cells, a) {
+        Some(Section::Intermediate) => section_at(cells, b) == Some(Section::Intermediate),
+        Some(Section::Answers) => {
+            section_at(cells, b) == Some(Section::Answers)
+                && identity(cells, a) == identity(cells, b)
+        }
+        _ => false,
+    }
+}
+
+/// Hidden tools do not split intermediate prose. Replies/notices remain in chronological order.
+pub(super) fn message_member(cells: &[Arc<dyn HistoryCell>], index: usize) -> bool {
+    let hidden_tools = !crate::mycodx_ui::tools_visible();
+    let previous = (0..index)
+        .rev()
+        .find(|i| !hidden_tools || !is_tool(&cells[*i]));
+    previous.is_some_and(|i| joins(cells, i, index))
+}
+
+pub(super) fn message_members(cells: &[Arc<dyn HistoryCell>], index: usize) -> Vec<usize> {
+    let hidden_tools = !crate::mycodx_ui::tools_visible();
+    let mut members = vec![index];
+    for next in index + 1..cells.len() {
+        if hidden_tools && is_tool(&cells[next]) {
+            continue;
+        }
+        if !joins(cells, index, next) {
+            break;
+        }
+        members.push(next);
+    }
+    members
+}
+
+pub(super) fn ids(cells: &[Arc<dyn HistoryCell>], index: usize) -> Vec<String> {
+    use crate::mycodx_ui::Section;
+    let Some(kind) = section_at(cells, index) else {
+        return Vec::new();
+    };
+    if kind != Section::Tools {
+        if message_member(cells, index) {
+            return Vec::new();
+        }
+        return vec![
+            if kind == Section::Intermediate && !crate::mycodx_ui::tools_visible() {
+                intermediate_id(cells, index)
+            } else {
+                identity(cells, index)
+            },
+        ];
+    }
+    let Some(end) = tool_end(cells, index) else {
+        return Vec::new();
+    };
+    let mut ids = Vec::new();
+    for id in cells[index..end].iter().flat_map(tool_ids) {
+        if !ids.contains(&id) {
+            ids.push(id);
+        }
+    }
+    ids
+}
+
+/// Separate progress segments around replies share state, but show just one collapsed summary.
+pub(super) fn secondary_progress(cells: &[Arc<dyn HistoryCell>], index: usize) -> bool {
+    use crate::mycodx_ui::Section;
+    !crate::mycodx_ui::tools_visible()
+        && section_at(cells, index) == Some(Section::Intermediate)
+        && (prompt_start(cells, index)..index)
+            .any(|i| section_at(cells, i) == Some(Section::Intermediate))
+}
+
+#[cfg(test)]
+pub(super) fn answer_open_by_default(cells: &[Arc<dyn HistoryCell>], index: usize) -> bool {
+    section_at(cells, index).is_some_and(|s| crate::mycodx_ui::current_card(s).initially_expanded())
+}
+
+/// Include every member revision; a completed call can change in the middle of a group.
+pub(super) fn group_revision(cells: &[Arc<dyn HistoryCell>], frame: u64) -> u64 {
+    let mut hash = DefaultHasher::new();
+    for cell in cells {
+        EntryKey::cell(cell).hash(&mut hash);
+        cell.transcript_animation_tick().hash(&mut hash);
+        if !cell.has_stable_transcript_height() {
+            frame.hash(&mut hash);
+        }
+    }
+    hash.finish()
+}
+
+pub(super) fn tool_layout(
+    cells: &[Arc<dyn HistoryCell>],
+    width: u16,
+    count: usize,
+    expanded: bool,
+) -> TextLayout {
+    let settings = crate::mycodx_ui::current();
+    let style = settings.card(crate::mycodx_ui::Section::Tools);
+    let expanded = expanded || !style.expandable;
+    let summary = style
+        .expandable
+        .then(|| format!("{count} {}", if count == 1 { "action" } else { "actions" }));
+    let inner = tool_content_width(width);
+    let lines = if expanded {
+        cells
+            .iter()
+            .flat_map(|cell| cell.expanded_hyperlink_lines(inner))
+            .collect()
+    } else {
+        Vec::new()
+    };
+    TextLayout::new(lines, inner).with_common_card(
+        width,
+        settings.card(crate::mycodx_ui::Section::Tools),
+        summary,
+        expanded,
+        true,
+        true,
+    )
+}
+
+#[cfg(test)]
+pub(super) fn message_layout(
+    cell: &Arc<dyn HistoryCell>,
+    width: u16,
+    expanded: bool,
+) -> Option<TextLayout> {
+    let cells = vec![Arc::clone(cell)];
+    let kind = section(cell)?;
+    Some(message_group_layout(
+        &cells,
+        &[0],
+        kind,
+        width,
+        expanded,
+        false,
+    ))
+}
+
+pub(super) fn message_group_layout(
+    cells: &[Arc<dyn HistoryCell>],
+    members: &[usize],
+    section: crate::mycodx_ui::Section,
+    width: u16,
+    expanded: bool,
+    live_join: bool,
+) -> TextLayout {
+    let style = crate::mycodx_ui::current_card(section);
+    let inner = style.message_content_width(width);
+    let expanded = expanded || !style.expandable;
+    let mut lines = Vec::new();
+    for &i in members {
+        let cell = &cells[i];
+        if !lines.is_empty() && !cell.is_stream_continuation() {
+            lines.push(HyperlinkLine::from(Line::default()));
+        }
+        lines.extend(
+            if let Some(user) = cell.as_any().downcast_ref::<UserHistoryCell>() {
+                user.mycodx_bubble_lines(inner)
+            } else if let Some(plan) = cell
+                .as_any()
+                .downcast_ref::<crate::history_cell::ProposedPlanCell>()
+            {
+                plan.mycodx_lines(inner)
+            } else if let Some(plan) = cell
+                .as_any()
+                .downcast_ref::<crate::history_cell::ProposedPlanStreamCell>()
+            {
+                plan.mycodx_body
+                    .clone()
+                    .unwrap_or_else(|| cell.retained_hyperlink_lines(inner, false))
+            } else {
+                cell.retained_hyperlink_lines(inner, false)
+            },
+        );
+    }
+    let first = &cells[members[0]];
+    let last = &cells[*members.last().unwrap()];
+    let streaming = last.as_any().is::<crate::history_cell::AgentMessageCell>()
+        || last
+            .as_any()
+            .is::<crate::history_cell::ProposedPlanStreamCell>();
+    let heading = !first.is_stream_continuation();
+    TextLayout::new(lines, inner).with_message_card(
+        width,
+        style,
+        expanded,
+        heading,
+        !streaming && !live_join,
+    )
+}
+
+#[cfg(test)]
+pub(super) fn live_layout(
+    lines: ActivityTranscriptLines,
+    width: u16,
+    count: usize,
+    expanded: bool,
+    stream: bool,
+    heading: bool,
+) -> TextLayout {
+    live_layout_section(
+        lines,
+        width,
+        count,
+        expanded,
+        stream,
+        heading,
+        crate::mycodx_ui::Section::Answers,
+    )
+}
+
+pub(super) fn live_layout_section(
+    lines: ActivityTranscriptLines,
+    width: u16,
+    count: usize,
+    expanded: bool,
+    stream: bool,
+    heading: bool,
+    stream_section: crate::mycodx_ui::Section,
+) -> TextLayout {
+    let settings = crate::mycodx_ui::current();
+    use crate::mycodx_ui::Section;
+    if stream && lines.activity.is_empty() {
+        return TextLayout::new(lines.auxiliary, width);
+    }
+    let section = if stream {
+        stream_section
+    } else {
+        Section::Tools
+    };
+    if !settings.visible(section) {
+        return TextLayout::new(lines.auxiliary, width);
+    }
+    let style = settings.card(section);
+    let inner = if stream {
+        style.message_content_width(width)
+    } else {
+        style.content_width(width)
+    };
+    let expanded = expanded || !style.expandable;
+    if stream && !heading && !expanded {
+        return TextLayout::new(lines.auxiliary, width);
+    }
+    let body = if stream || expanded {
+        lines.activity
+    } else {
+        Vec::new()
+    };
+    let layout = TextLayout::new(body, inner);
+    let layout = if stream {
+        layout.with_message_card(width, style, expanded, heading, false)
+    } else {
+        let summary = style
+            .expandable
+            .then(|| format!("{count} {}", if count == 1 { "action" } else { "actions" }));
+        layout.with_common_card(width, style, summary, expanded, true, true)
+    };
+    layout.with_mycodx_auxiliary(lines.auxiliary, width)
+}
