+#[test]
+fn mycodx_mouse_focus_preserves_text_selection_links_and_selection_mode() {
+    use crossterm::event::{MouseButton, MouseEventKind};
+    crate::mycodx_ui::with_settings(Settings::comparison(), || {
+        let cells = vec![answer("hello world [link](https://example.com)")];
+        let area = Rect::new(2, 3, 60, 10);
+        let mut view = TranscriptView::default();
+        view.render(area, &mut Buffer::empty(area), &cells);
+        let (row, visible) = view
+            .visible
+            .iter()
+            .enumerate()
+            .find(|(_, v)| v.row == v.layout.row_for_offset(0))
+            .unwrap();
+        let x = area.x + visible.layout.column_for_offset(0);
+        let y = area.y + row as u16;
+        view.handle_mouse(mouse(MouseEventKind::Down(MouseButton::Left), x, y), &cells);
+        assert!(view.is_activity_focused());
+        view.handle_mouse(
+            mouse(MouseEventKind::Drag(MouseButton::Left), x + 5, y),
+            &cells,
+        );
+        view.handle_mouse(
+            mouse(MouseEventKind::Up(MouseButton::Left), x + 5, y),
+            &cells,
+        );
+        assert!(view.disclosure.focused.is_none());
+        assert!(
+            matches!(view.handle_key(KeyCode::Enter.into(), &cells), Some(ViewAction::CopyAndFollow(text)) if text == "hello")
+        );
+        assert!(view.mycodx_expanded(&cells, 0));
+        view.end_selection(&cells);
+        // Double-clicking text still selects the word, without toggling its card.
+        for kind in [
+            MouseEventKind::Down(MouseButton::Left),
+            MouseEventKind::Up(MouseButton::Left),
+            MouseEventKind::Down(MouseButton::Left),
+            MouseEventKind::Up(MouseButton::Left),
+        ] {
+            view.handle_mouse(mouse(kind, x, y), &cells);
+        }
+        assert!(view.disclosure.focused.is_none());
+        assert_eq!(view.selected_text(&cells).as_deref(), Some("hello"));
+        view.end_selection(&cells);
+        view.last_click = None;
+        let link_x = (area.x..area.right())
+            .find(|col| view.link_at(*col, y).is_some())
+            .unwrap();
+        view.handle_mouse(
+            mouse(MouseEventKind::Down(MouseButton::Left), link_x, y),
+            &cells,
+        );
+        assert!(
+            matches!(view.handle_mouse(mouse(MouseEventKind::Up(MouseButton::Left), link_x, y), &cells), Some(ViewAction::OpenLink(url)) if url == "https://example.com")
+        );
+        view.handle_selection_mouse(
+            mouse(MouseEventKind::Down(MouseButton::Left), x, y),
+            &cells,
+            None,
+        );
+        view.handle_selection_mouse(
+            mouse(MouseEventKind::Up(MouseButton::Left), x, y),
+            &cells,
+            None,
+        );
+        assert!(view.disclosure.focused.is_none());
+        // The empty space beside a fitted card is not part of that card.
+        view.handle_mouse(
+            mouse(MouseEventKind::Down(MouseButton::Left), area.right() - 1, y),
+            &cells,
+        );
+        assert!(view.disclosure.focused.is_none());
+    });
+}
