+/// Add the running Codux build to spare footer space, without displacing controls or context.
+pub(crate) fn codux_footer_with_version(
+    area: Rect,
+    left_width: u16,
+    right: Option<Line<'static>>,
+) -> Option<Line<'static>> {
+    let mut combined = right.clone().unwrap_or_default();
+    if combined.width() > 0 {
+        combined.push_span(" · ".set_style(secondary_text_style()));
+    }
+    combined.extend(codux_version_line().spans);
+    let width = combined.width().min(u16::MAX as usize) as u16;
+    if width.saturating_add(2 * FOOTER_INDENT_COLS as u16) <= area.width
+        && can_show_left_with_context(area, left_width, width)
+    {
+        Some(combined)
+    } else {
+        right
+    }
+}
+
+pub(crate) fn codux_version_line() -> Line<'static> {
+    let version = option_env!("MYCODEX_DISPLAY_VERSION")
+        .and_then(|value| value.split_whitespace().next())
+        .unwrap_or("dev");
+    Line::from(format!("Codux {version}").set_style(secondary_text_style()))
+}
