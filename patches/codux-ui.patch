+        let area = Rect::new(0, 0, 80, layout.row_count() as u16);
+        let mut buffer = Buffer::empty(area);
+        layout.render(area, &mut buffer, 0);
+        let background = crate::mycodx_ui::current()
+            .card(Section::Questions)
+            .colors()
+            .body()
+            .bg
+            .unwrap();
+        // Five source columns, two state-gutter columns and one padding column per side.
+        let left = 80 - (5 + 2 + 2);
+        for (y, symbol) in [(0, "▄"), (area.height - 1, "▀")] {
+            for x in left..80 {
+                assert_eq!(buffer[(x, y)].symbol(), symbol);
+                assert_eq!(buffer[(x, y)].fg, background);
+                assert_eq!(buffer[(x, y)].bg, ratatui::style::Color::Reset);
+            }
+        }
+        for x in left..80 {
+            assert_eq!(buffer[(x, 1)].bg, background);
+        }
+        assert_eq!(buffer[(left - 1, 1)].bg, ratatui::style::Color::Reset);
+        assert_eq!(layout.text(), "hello");
+    });
+}
