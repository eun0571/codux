+
+    #[test]
+    fn mycodx_theme_changes_only_colors_and_keeps_syntax_contrast() {
+        let mut original = Settings::web();
+        original.show_tools = true;
+        original.show_intermediate = false;
+        for section in SECTIONS {
+            original = original.change_card(section, |card| {
+                card.padding_x = 3;
+                card.padding_y = 2;
+                card.max_width = 60;
+                card.title = "Keep my title".into();
+                card.expandable = false;
+                card.default_expanded = Some(false);
+            });
+        }
+        for entry in highlight::list_available_themes(None) {
+            let syntax = highlight::resolve_theme_by_name(&entry.name, None).unwrap();
+            for outer in [(24, 24, 24), (245, 245, 245)] {
+                let live = Palette::from_theme(&syntax, outer);
+                for choice in choices_for(&original, &syntax, outer) {
+                    let mut restored = choice.settings.clone();
+                    for section in SECTIONS {
+                        let before = original.card(section);
+                        let card = choice.settings.card(section);
+                        if choice.name == "Default" {
+                            // The fixed install palette preserves its chosen colors,
+                            // including the transparent final-answer background.
+                            assert_eq!(
+                                card.background,
+                                Settings::default().card(section).background
+                            );
+                        } else {
+                            let Background::Rgb(r, g, b) = card.background else {
+                                panic!("expected RGB")
+                            };
+                            // Syntax-derived palettes retain the live theme's contrast.
+                            for (fg, min) in &live.readable_colors {
+                                assert!(
+                                    contrast(*fg, (r, g, b)) + 0.001 >= *min,
+                                    "{} / {} / {section:?} / {fg:?}",
+                                    entry.name,
+                                    choice.name
+                                );
+                            }
+                        }
+                        restored = restored.change_card(section, |card| {
+                            card.background = before.background;
+                        });
+                    }
+                    assert_eq!(restored, original, "{} / {}", entry.name, choice.name);
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn mycodx_theme_variety_reaches_every_role_including_final_answers() {
+        for id in [
+            "dracula",
+            "catppuccin-latte",
+            "solarized-dark",
+            "solarized-light",
+        ] {
+            let syntax = highlight::resolve_theme_by_name(id, None).unwrap();
+            let choices = choices_for(&Settings::web(), &syntax, (24, 24, 24));
+            for section in SECTIONS {
+                let mut unique = Vec::new();
+                for choice in &choices {
+                    let card = choice.settings.card(section);
+                    if !unique.contains(&card.background) {
+                        unique.push(card.background);
+                    }
+                    assert_ne!(
+                        card.colors().bg,
+                        card.colors_for(true).bg,
+                        "{id} / {} / {section:?}",
+                        choice.name
+                    );
+                }
+                assert!(
+                    unique.len() >= 13,
+                    "{id} / {section:?}: only {} colors",
+                    unique.len()
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn mycodx_theme_respects_ansi_markers_and_custom_rgb() {
+        let mut theme = Theme::default();
+        for alpha in [0, 1] {
+            theme.settings.background = Some(syntect::highlighting::Color {
+                r: 2,
+                g: 0,
+                b: 0,
+                a: alpha,
+            });
+            for outer in [(25, 25, 25), (245, 245, 245)] {
+                assert_eq!(Palette::from_theme(&theme, outer).base, outer);
+            }
+        }
+        theme.settings.background = Some(syntect::highlighting::Color {
+            r: 34,
+            g: 43,
+            b: 51,
+            a: 255,
+        });
+        assert_eq!(Palette::from_theme(&theme, (0, 0, 0)).base, (34, 43, 51));
+        theme.name = Some("My own theme".into());
+        let choices = choices_for(&Settings::web(), &theme, (24, 24, 24));
+        assert_eq!(choices.len(), SCHEMES.len() + 2);
+        assert_eq!(choices[0].name, "My own theme (recommended)");
+    }
+}
diff --git a/codex-rs/tui/src/mycodx_status.rs b/codex-rs/tui/src/mycodx_status.rs
