+fn mycodx_worked_padding_uses_common_geometry_without_polluting_source() {
+    crate::mycodx_ui::with_settings(Settings::web(), || {
+        let cell: Arc<dyn HistoryCell> = Arc::new(crate::history_cell::FinalMessageSeparator::new(
+            Some(12),
