@@ -0,0 +1,173 @@
+//! Renderer settings affect source images, independently of terminal/card colors.
+use serde::{Deserialize, Serialize};
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+pub(crate) struct TextStyle {
+    pub use_ascii: bool,
+    pub padding_x: u16,
+    pub padding_y: u16,
+    pub box_border_padding: u16,
+    pub color_mode: String,
+    pub theme: String,
+}
+impl Default for TextStyle {
+    fn default() -> Self {
+        Self {
+            use_ascii: false,
+            padding_x: 5,
+            padding_y: 5,
+            box_border_padding: 0,
+            color_mode: "none".into(),
+            theme: "default".into(),
+        }
+    }
+}
+impl TextStyle {
+    pub const MODES: &'static [&'static str] = &["none", "auto", "ansi16", "ansi256", "truecolor"];
+    pub const THEMES: &'static [&'static str] = &[
+        "default",
+        "zinc-light",
+        "zinc-dark",
+        "tokyo-night",
+        "tokyo-night-storm",
+        "tokyo-night-light",
+        "catppuccin-mocha",
+        "catppuccin-latte",
+        "nord",
+        "nord-light",
+        "dracula",
+        "github-light",
+        "github-dark",
+        "solarized-light",
+        "solarized-dark",
+        "one-dark",
+    ];
+    pub fn validate(&self) -> anyhow::Result<()> {
+        anyhow::ensure!(
+            (1..=10).contains(&self.padding_x)
+                && (1..=10).contains(&self.padding_y)
+                && self.box_border_padding <= 4
+                && Self::MODES.contains(&self.color_mode.as_str())
+                && Self::THEMES.contains(&self.theme.as_str()),
+            "Invalid Mermaid text render options"
+        );
+        Ok(())
+    }
+}
+
+macro_rules! choice {
+    ($name:ident, $default:ident, $($variant:ident => $label:literal),+ $(,)?) => {
+        #[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+        #[serde(rename_all = "snake_case")]
+        pub(crate) enum $name { $($variant),+ }
+        impl Default for $name { fn default() -> Self { Self::$default } }
+        impl $name {
+            #[cfg(test)]
+            pub(crate) const ALL: &'static [Self] = &[$(Self::$variant),+];
+        }
+    }
+}
+choice!(Theme, Auto, Auto => "Auto (terminal)", Default => "Default", Neutral => "Neutral",
+    Dark => "Dark", Forest => "Forest", Base => "Base");
+choice!(Font, System, System => "Segoe UI", Mermaid => "Mermaid (Trebuchet MS)",
+    Arial => "Arial", Korean => "Malgun Gothic", Gulim => "Gulim", Batang => "Batang", Mono => "Consolas");
+choice!(Look, Classic, Classic => "Classic", HandDrawn => "Hand drawn");
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+pub(crate) struct ImageStyle {
+    pub theme: Theme,
+    pub font: Font,
+    pub font_size: u16,
+    pub look: Look,
+}
+impl Default for ImageStyle {
+    fn default() -> Self {
+        Self {
+            theme: Theme::Auto,
+            font: Font::System,
+            font_size: 20,
+            look: Look::Classic,
+        }
+    }
+}
+impl ImageStyle {
+    pub(crate) fn validate(&self) -> anyhow::Result<()> {
+        anyhow::ensure!(
+            (12..=32).contains(&self.font_size),
+            "Mermaid font size must be 12..32"
+        );
+        Ok(())
+    }
+    pub(crate) fn resolved(&self, background: (u8, u8, u8)) -> (&'static str, String) {
+        let (r, g, b) = background;
+        let automatic = if u32::from(r) * 299 + u32::from(g) * 587 + u32::from(b) * 114 > 128_000 {
+            "neutral"
+        } else {
+            "dark"
+        };
+        let theme = match self.theme {
+            Theme::Auto => automatic,
+            Theme::Default => "default",
+            Theme::Neutral => "neutral",
+            Theme::Dark => "dark",
+            Theme::Forest => "forest",
+            Theme::Base => "base",
+        };
+        let background = match self.theme {
+            Theme::Auto => format!("#{r:02x}{g:02x}{b:02x}"),
+            Theme::Dark => "#181818".into(),
+            _ => "#ffffff".into(),
+        };
+        (theme, background)
+    }
+    pub(crate) fn font_family(&self) -> &'static str {
+        match self.font {
+            Font::System => "Segoe UI, Malgun Gothic, sans-serif",
+            Font::Mermaid => "trebuchet ms, verdana, arial, Malgun Gothic, sans-serif",
+            Font::Arial => "Arial, Malgun Gothic, sans-serif",
+            Font::Korean => "Malgun Gothic, Segoe UI, sans-serif",
+            Font::Gulim => "Gulim, Malgun Gothic, sans-serif",
+            Font::Batang => "Batang, Malgun Gothic, serif",
+            Font::Mono => "Consolas, Malgun Gothic, monospace",
+        }
+    }
+    pub(crate) fn look_name(&self) -> &'static str {
+        match self.look {
+            Look::Classic => "classic",
+            Look::HandDrawn => "handDrawn",
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn themes_use_readable_canvases_and_settings_round_trip() {
+        let mut style = ImageStyle::default();
+        assert_eq!(style.resolved((24, 24, 24)), ("dark", "#181818".into()));
+        assert_eq!(
+            style.resolved((255, 255, 255)),
+            ("neutral", "#ffffff".into())
+        );
+        for &theme in Theme::ALL {
+            style.theme = theme;
+            if !matches!(theme, Theme::Auto | Theme::Dark) {
+                assert_eq!(style.resolved((24, 24, 24)).1, "#ffffff");
+            }
+            for &font in Font::ALL {
+                style.font = font;
+                for &look in Look::ALL {
+                    style.look = look;
+                    let saved = serde_json::to_string(&style).unwrap();
+                    assert_eq!(serde_json::from_str::<ImageStyle>(&saved).unwrap(), style);
+                    assert!(!style.font_family().is_empty());
+                }
+            }
+        }
+        style.font_size = 0;
+        assert!(style.validate().is_err());
+    }
+}
