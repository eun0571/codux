+#[derive(Debug)]
+struct Tool {
+    id: String,
+    renders: Arc<AtomicUsize>,
+}
+
+impl HistoryCell for Tool {
+    fn display_lines(&self, _width: u16) -> Vec<Line<'static>> {
+        self.renders.fetch_add(1, Ordering::Relaxed);
+        format!("Ran {}", self.id)
+            .lines()
+            .map(|line| Line::from(line.to_owned()))
+            .collect()
+    }
+
+    fn raw_lines(&self) -> Vec<Line<'static>> {
+        self.display_lines(80)
+    }
+
+    fn activity_ids(&self) -> Vec<String> {
+        vec![self.id.to_owned()]
+    }
+}
+
+fn tool(id: &str, renders: &Arc<AtomicUsize>) -> Arc<dyn HistoryCell> {
+    Arc::new(Tool {
+        id: id.to_owned(),
+        renders: Arc::clone(renders),
+    })
+}
+
+fn user(message: &str) -> Arc<dyn HistoryCell> {
+    Arc::new(UserHistoryCell {
+        mycodx_id: uuid::Uuid::new_v4().to_string(),
+        mycodx_reply: false,
+        message: message.to_owned(),
+        text_elements: Vec::new(),
+        local_image_paths: Vec::new(),
+        remote_image_urls: Vec::new(),
+        presentation: Default::default(),
+    })
+}
+
+fn answer(message: &str) -> Arc<dyn HistoryCell> {
+    Arc::new(AgentMarkdownCell::new(message.to_owned(), Path::new(".")))
+}
+
+fn painted(layout: &TextLayout, width: u16) -> String {
+    let area = Rect::new(0, 0, width, layout.row_count() as u16);
+    let mut buf = Buffer::empty(area);
+    layout.render(area, &mut buf, 0);
+    crate::transcript_view::tests::text(&buf)
+}
