+#[test]
+fn mycodx_single_click_selects_each_card_and_enter_toggles_it() {
+    use crossterm::event::{MouseButton, MouseEventKind};
+    crate::mycodx_ui::with_settings(Settings::comparison(), || {
+        let renders = Arc::new(AtomicUsize::new(0));
+        let mut reply =
+            crate::history_cell::new_user_prompt("reply".into(), vec![], vec![], vec![]);
+        reply.mycodx_reply = true;
+        let cells = vec![
+            user("question"),
+            Arc::new(reply),
+            tool("read file", &renders),
+            progress("intermediate answer"),
+            answer("final answer"),
+        ];
+        let area = Rect::new(2, 3, 80, 40);
+        for index in 0..cells.len() {
+            for padding in [false, true] {
+                let mut view = TranscriptView::default();
+                view.area = area;
+                view.disclosure
+                    .expanded
+                    .extend(view.activity_ids(&cells, index));
+                view.render(area, &mut Buffer::empty(area), &cells);
+                let top = view.start(&cells);
+                let (row, visible) = view
+                    .visible
+                    .iter()
+                    .enumerate()
+                    .find(|(_, v)| v.index == index && v.row == v.layout.row_for_offset(0))
+                    .unwrap();
+                let column = if padding {
+                    (0..area.width)
+                        .find(|col| {
+                            visible
+                                .layout
+                                .mycodx_background_at_state(visible.row, *col, true)
+                        })
+                        .unwrap()
+                } else {
+                    visible.layout.column_for_offset(0)
+                };
+                for kind in [
+                    MouseEventKind::Down(MouseButton::Left),
+                    MouseEventKind::Up(MouseButton::Left),
+                ] {
+                    view.handle_mouse(mouse(kind, area.x + column, area.y + row as u16), &cells);
+                }
+                assert_eq!(
+                    view.disclosure.focused,
+                    Some(view.activity_ids(&cells, index))
+                );
+                assert!(
+                    view.mycodx_expanded(&cells, index),
+                    "single click must not collapse card {index}"
+                );
+                view.render(area, &mut Buffer::empty(area), &cells);
+                assert_eq!(
+                    view.start(&cells),
+                    top,
+                    "mouse focus must not move the viewport"
+                );
+                view.handle_key(KeyCode::Enter.into(), &cells);
+                assert!(!view.mycodx_expanded(&cells, index));
+                view.render(area, &mut Buffer::empty(area), &cells);
+                view.handle_key(KeyCode::Enter.into(), &cells);
+                assert!(view.mycodx_expanded(&cells, index));
+            }
+        }
+    });
+}
