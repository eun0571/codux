+#[test]
+fn codux_native_image_tools_keep_each_preview_out_of_hidden_and_search_only_views() {
+    use crate::history_cell::new_view_image_tool_call;
+    use crate::pets::ImageProtocol;
+    use codex_utils_path_uri::LegacyAppPathString;
+
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("preview.png");
+    image::RgbaImage::from_pixel(160, 80, image::Rgba([255, 0, 0, 255]))
+        .save(&path)
+        .unwrap();
+    let cells: Vec<Arc<dyn HistoryCell>> = (0..2)
+        .map(|i| {
+            Arc::new(new_view_image_tool_call(
+                format!("image-{i}"),
+                LegacyAppPathString::from_string(path.to_string_lossy().into_owned()),
+            )) as Arc<dyn HistoryCell>
+        })
+        .collect();
+    crate::mycodx_ui::with_settings(Settings::comparison(), || {
+        assert_eq!(tool_end(&cells, 0), Some(1));
+        assert_eq!(tool_end(&cells, 1), Some(2));
+        let mut view = TranscriptView::default();
+        view.image_protocol = Some(ImageProtocol::Kitty);
+        let area = Rect::new(0, 0, 100, 40);
+        view.render(area, &mut Buffer::empty(area), &cells);
+        assert!(view.image_placements().is_empty());
+        for index in 0..2 {
+            let source = view.entry_layout(&cells, index, true).unwrap();
+            assert!(
+                source.image.is_none(),
+                "Search alone must not expand pixels"
+            );
+            let text = source.text().to_owned();
+            let ids = view.activity_ids(&cells, index);
+            view.disclosure.expanded.extend(ids);
+            view.cache.clear();
+            let expanded = view.layout(&cells, index).unwrap();
+            assert!(expanded.visible_image().is_some());
+            assert_eq!(expanded.text(), text);
+            assert!(expanded.rewrap(8).visible_image().is_none());
+            assert!(expanded.rewrap(8).rewrap(100).visible_image().is_some());
+        }
+        view.jump_to_latest();
+        view.render(area, &mut Buffer::empty(area), &cells);
+        assert_eq!(view.image_placements().len(), 2);
+        let inset = Rect::new(7, 5, 16, 3);
+        view.render(inset, &mut Buffer::empty(inset), &cells);
+        let placements = view.image_placements();
+        assert!(!placements.is_empty());
+        assert!(
+            placements
+                .iter()
+                .all(|p| inset.intersection(p.area) == p.area)
+        );
+    });
+    crate::mycodx_ui::with_settings(Settings::default(), || {
+        let mut view = TranscriptView::default();
+        view.image_protocol = Some(ImageProtocol::Kitty);
+        let area = Rect::new(0, 0, 100, 40);
+        view.render(area, &mut Buffer::empty(area), &cells);
+        assert!(view.image_placements().is_empty());
+        assert_eq!(view.layout(&cells, 0).unwrap().row_count(), 0);
+    });
+}
