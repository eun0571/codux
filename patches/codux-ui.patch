+            let (raw, mut rx) = tokio::sync::mpsc::unbounded_channel();
+            let tx = AppEventSender::new(raw);
+            let original = current();
+            let mut v = view(
+                home.path(),
+                Page::Values(Section::Questions, Element::Horizontal),
+                &tx,
+            );
+            press(&mut v, KeyCode::Down);
+            assert_eq!(current().card(Section::Questions).padding_x, 2);
+            rx.try_recv().unwrap();
+            press(&mut v, KeyCode::Esc);
+            assert_eq!(current(), original);
+            assert!(v.is_complete());
+            rx.try_recv().unwrap();
+            assert!(matches!(
+                rx.try_recv().unwrap(),
+                AppEvent::MycodxUiMenu {
+                    page: Page::Values(Section::Questions, Element::Padding)
+                }
+            ));
+            for (p, parent) in [
+                (
+                    Page::Values(Section::Questions, Element::Padding),
+                    Page::Card(Section::Questions),
+                ),
+                (
+                    Page::Card(Section::Questions),
+                    Page::Group(Section::Questions),
+                ),
+                (Page::Group(Section::Questions), Page::Root),
+            ] {
+                let mut v = view(home.path(), p, &tx);
+                press(&mut v, KeyCode::Esc);
+                assert!(
+                    matches!(rx.try_recv().unwrap(),AppEvent::MycodxUiMenu{page} if page==parent)
+                );
+            }
+            let mut v = view(home.path(), Page::Root, &tx);
+            press(&mut v, KeyCode::Esc);
+            assert!(rx.try_recv().is_err());
+        });
+    }
+    #[test]
+    fn mycodx_ui_settings_roundtrip_and_legacy_load() {
+        with_settings(Settings::comparison(), || {
+            let home = tempfile::tempdir().unwrap();
+            let path = home.path().join("codux-ui.json");
+            std::fs::write(
+                &path,
+                br#"{"active":{"question_padding":2,"question_bubble":false}}"#,
+            )
+            .unwrap();
+            load(home.path()).unwrap();
+            assert_eq!(current().card(Section::Questions).align, Align::Right);
+            assert_eq!(current().card(Section::Questions).padding_y, 4);
+            let custom = current().change_card(Section::Tools, |c| {
+                c.title = "My tools".into();
+                c.background = Background::Rgb(10, 20, 30);
+            });
+            save(home.path(), custom.clone()).unwrap();
+            assert_eq!(read(home.path()).unwrap().active, custom);
+            assert!(read(home.path()).unwrap().custom.is_none());
+            std::fs::write(&path, b"invalid").unwrap();
+            assert!(save(home.path(), Settings::web()).is_err());
+            assert_eq!(std::fs::read(&path).unwrap(), b"invalid");
+        });
+    }
+    #[test]
+    fn mycodx_ui_legacy_borders_are_discarded_without_losing_custom_style() {
+        with_settings(Settings::web(), || {
+            let home = tempfile::tempdir().unwrap();
+            let path = home.path().join("codux-ui.json");
+            let custom = Settings::comparison().change_card(Section::Questions, |c| {
+                c.title = "Keep title".into();
+                c.background = Background::Rgb(29, 77, 78);
+                c.padding_x = 2;
+            });
+            let mut value = serde_json::json!({"active": custom, "custom": custom});
+            for key in ["active", "custom"] {
+                value[key]["question_border"] = serde_json::json!(true);
+                value[key]["tools_fill_border"] = serde_json::json!(true);
+                for (index, border) in ["pixel", "block", "none"].into_iter().enumerate() {
+                    value[key]["cards"][index]["border"] = serde_json::json!(border);
+                }
+            }
+            std::fs::write(&path, serde_json::to_vec(&value).unwrap()).unwrap();
+            load(home.path()).unwrap();
+            assert_eq!(current(), custom);
+            save(home.path(), current()).unwrap();
+            let saved = std::fs::read_to_string(&path).unwrap();
+            assert!(!saved.contains("\"border\""));
+            assert!(!saved.contains("pixel"));
+            assert_eq!(read(home.path()).unwrap().active, custom);
+            assert!(read(home.path()).unwrap().custom.is_none());
+        });
+    }
+    #[test]
+    fn mycodx_ui_old_alignment_is_ignored_and_expandable_round_trips() {
+        with_settings(Settings::web(), || {
+            let home = tempfile::tempdir().unwrap();
+            let path = home.path().join("codux-ui.json");
+            let mut value = serde_json::json!({"active": Settings::web()});
+            for card in value["active"]["cards"].as_array_mut().unwrap() {
+                card["align"] = serde_json::json!("right");
+                card.as_object_mut().unwrap().remove("expandable");
+            }
+            std::fs::write(&path, serde_json::to_vec(&value).unwrap()).unwrap();
+            load(home.path()).unwrap();
+            for section in [
+                Section::Questions,
+                Section::Replies,
+                Section::Tools,
+                Section::Intermediate,
+                Section::Answers,
+            ] {
+                let card = current().card(section);
+                assert!(card.expandable);
+                assert_eq!(
+                    card.align,
+                    if matches!(section, Section::Questions | Section::Replies) {
+                        Align::Right
+                    } else {
+                        Align::Left
+                    }
+                );
+            }
+            save(
+                home.path(),
+                current().change_card(Section::Questions, |c| c.expandable = false),
+            )
+            .unwrap();
+            load(home.path()).unwrap();
+            assert!(!current().card(Section::Questions).expandable);
+            assert!(current().card(Section::Replies).expandable);
+            assert!(!std::fs::read_to_string(path).unwrap().contains("\"align\""));
+        });
+    }
+
+    #[test]
+    fn mycodx_ui_fractional_padding_does_not_depend_on_visible_background() {
+        let home = tempfile::tempdir().unwrap();
+        let settings = Settings::comparison().change_card(Section::Tools, |c| {
+            c.background = Background::None;
+        });
+        let values = choices(
+            home.path(),
+            Page::Values(Section::Tools, Element::Vertical),
+            &settings,
+        )
+        .unwrap();
+        assert_eq!(values.len(), 7);
+        assert!(
+            values
+                .iter()
+                .any(|(_, s)| s.card(Section::Tools).padding_y % 2 == 1)
+        );
+        assert!(style::parse_hex("#12aBcF").is_ok());
+        assert!(style::parse_hex("#12").is_err());
+    }
+}
diff --git a/codex-rs/tui/src/mycodx_input.rs b/codex-rs/tui/src/mycodx_input.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/tui/src/mycodx_input.rs
@@ -0,0 +1,211 @@
+use super::*;
+use crate::app_event::AppEvent;
+use crate::app_event_sender::AppEventSender;
+use crate::bottom_pane::{BottomPaneView, CancellationEvent, TextArea, TextAreaState};
+use crate::render::renderable::Renderable;
+use crossterm::event::{KeyCode, KeyEvent};
+use ratatui::{
+    buffer::Buffer,
+    layout::Rect,
+    widgets::{Paragraph, StatefulWidgetRef, Widget},
+};
+use std::cell::RefCell;
+
+pub(crate) struct InputView {
+    page: Page,
+    original: Settings,
+    input: TextArea,
+    state: RefCell<TextAreaState>,
+    tx: AppEventSender,
+    complete: bool,
+    error: Option<String>,
+}
+impl InputView {
+    pub(crate) fn new(page: Page, tx: AppEventSender) -> Self {
+        let original = current();
+        let mut input = TextArea::new_single_line();
+        if let Some((s, e, _)) = page.editor() {
+            let card = original.card(s);
+            input.set_text_clearing_elements(&if e == Element::Text {
+                card.title
+            } else {
+                match card.background {
+                    Background::Rgb(r, g, b) => format!("#{r:02X}{g:02X}{b:02X}"),
+                    _ => "#373A40".into(),
+                }
+            });
+        }
+        Self {
+            page,
+            original,
+            input,
+            state: RefCell::new(TextAreaState::default()),
+            tx,
+            complete: false,
+            error: None,
+        }
+    }
+    fn edited(&self) -> anyhow::Result<Settings> {
+        let Some((section, element, _)) = self.page.editor() else {
+            unreachable!()
+        };
+        let text = self.input.text();
+        let next = if element == Element::Text {
+            self.original.change_card(section, |c| {
+                c.title = text.into();
+            })
+        } else {
+            let bg = style::parse_hex(text)?;
+            self.original.change_card(section, |c| c.background = bg)
+        };
+        super::menu::apply_scoped(&self.original, &next, self.page).validate()
+    }
+    fn preview(&mut self) {
+        match self.edited() {
+            Ok(next) => {
+                set(next);
+                self.tx.send(AppEvent::MycodxUiPreviewed);
+                self.error = None;
+            }
+            Err(e) => self.error = Some(e.to_string()),
+        }
+    }
+    fn input_area(area: Rect) -> Rect {
+        Rect::new(
+            area.x,
+            area.y.saturating_add(1),
+            area.width,
+            area.height.saturating_sub(1).min(1),
+        )
+    }
+}
+impl BottomPaneView for InputView {
+    fn handle_key_event(&mut self, key: KeyEvent) {
+        match key.code {
+            KeyCode::Esc => {
+                self.on_ctrl_c();
+            }
+            KeyCode::Enter => match self.edited() {
+                Ok(settings) => {
+                    self.tx.send(AppEvent::MycodxUiSelected {
+                        settings,
+                        previous: self.original.clone(),
+                        return_to: self.page.parent().unwrap(),
+                    });
+                    self.complete = true;
+                }
+                Err(e) => self.error = Some(e.to_string()),
+            },
+            _ => {
+                self.input.input(key);
+                self.preview();
+            }
+        }
+    }
+    fn handle_paste(&mut self, text: String) -> bool {
+        self.input.insert_str(&text);
+        self.preview();
+        true
+    }
+    fn on_ctrl_c(&mut self) -> CancellationEvent {
+        set(self.original.clone());
+        self.tx.send(AppEvent::MycodxUiPreviewed);
+        self.tx.send(AppEvent::MycodxUiMenu {
+            page: self.page.parent().unwrap(),
+        });
+        self.complete = true;
+        CancellationEvent::Handled
+    }
+    fn is_complete(&self) -> bool {
+        self.complete
+    }
+}
+impl Renderable for InputView {
+    fn desired_height(&self, _width: u16) -> u16 {
+        5
+    }
+    fn cursor_pos(&self, area: Rect) -> Option<(u16, u16)> {
+        self.input
+            .cursor_pos_with_state(Self::input_area(area), *self.state.borrow())
+    }
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        Paragraph::new(self.page.title()).render(
+            Rect::new(area.x, area.y, area.width, area.height.min(1)),
+            buf,
+        );
+        StatefulWidgetRef::render_ref(
+            &(&self.input),
+            Self::input_area(area),
+            buf,
+            &mut self.state.borrow_mut(),
+        );
+        if area.height > 2 {
+            Paragraph::new(
+                self.error
+                    .as_deref()
+                    .unwrap_or("Enter saves | Esc restores and goes back"),
+            )
+            .render(Rect::new(area.x, area.y + 2, area.width, 1), buf);
+        }
+        if area.height > 3 {
+            if let Some((s, _, mask)) = self.page.editor() {
+                Paragraph::new(format!("Apply to: {}", super::menu::scope_label(s, mask)))
+                    .render(Rect::new(area.x, area.y + 3, area.width, 1), buf);
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crossterm::event::KeyModifiers;
+    #[test]
+    fn codux_bulk_text_and_hex_inputs_preserve_other_fields_and_cancel() {
+        with_settings(Settings::default(), || {
+            let original = current();
+            let (raw, _) = tokio::sync::mpsc::unbounded_channel();
+            let tx = AppEventSender::new(raw);
+            let mut input = InputView::new(Page::Scoped(Section::Answers, Element::Text, 31), tx.clone());
+            input.input.set_text_clearing_elements("Shared title");input.preview();
+            for s in [Section::Questions, Section::Replies, Section::Tools, Section::Intermediate, Section::Answers] {
+                assert_eq!(current().card(s).title, "Shared title");
+                assert_eq!(current().card(s).title_visible, original.card(s).title_visible);
+            }
+            input.on_ctrl_c();assert_eq!(current(), original);
+            let mut input = InputView::new(Page::Scoped(Section::Tools, Element::CustomColor, 31), tx);
+            input.input.set_text_clearing_elements("#123456");input.preview();
+            assert_eq!(current().card(Section::Questions).background, Background::Rgb(18, 52, 86));
+            assert_eq!(current().card(Section::Answers).padding_x, original.card(Section::Answers).padding_x);
+            input.on_ctrl_c();assert_eq!(current(), original);
+        });
+    }
+    #[test]
+    fn mycodx_ui_text_and_hex_edit_preview_cancel_and_validation() {
+        with_settings(Settings::comparison(), || {
+            let (raw, mut rx) = tokio::sync::mpsc::unbounded_channel();
+            let tx = AppEventSender::new(raw);
+            let original = current();
+            let mut v = InputView::new(Page::Values(Section::Questions, Element::Text), tx.clone());
+            v.input.set_text_clearing_elements("Custom title");
+            v.preview();
+            assert_eq!(current().card(Section::Questions).title, "Custom title");
+            v.on_ctrl_c();
+            assert_eq!(current(), original);
+            while rx.try_recv().is_ok() {}
+            let mut v = InputView::new(Page::Values(Section::Tools, Element::CustomColor), tx);
+            v.input.set_text_clearing_elements("#bad");
+            v.handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+            assert!(!v.is_complete());
+            assert!(rx.try_recv().is_err());
+            v.input.set_text_clearing_elements("#aBc123");
+            v.preview();
+            v.handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+            assert!(v.is_complete());
+            assert_eq!(
+                current().card(Section::Tools).background,
+                Background::Rgb(171, 193, 35)
+            );
+        });
+    }
+}
diff --git a/codex-rs/tui/src/transcript_view/text_mycodx.rs b/codex-rs/tui/src/transcript_view/text_mycodx.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/tui/src/transcript_view/text_mycodx.rs
@@ -0,0 +1,545 @@
+//! Shared geometry for all three card kinds. All decoration has empty source ranges.
+use super::*;
+use crate::mycodx_ui::style::{Paint, color};
+use crate::mycodx_ui::{Align, CardStyle};
+
+#[derive(Clone)]
+pub(super) struct CommonCard {
+    style: CardStyle,
+    summary: Option<String>,
+    message: bool,
+    expanded: bool,
+    heading: bool,
+    footer: bool,
+    body_lines: usize,
+    left: u16,
+    width: u16,
+    rows: Range<usize>,
+    top_rows: u16,
+    bottom_rows: u16,
+    marker_row: Option<usize>,
+    marker_gutter: u16,
+}
+impl TextLayout {
+    pub(in crate::transcript_view) fn with_common_card(
+        self,
+        width: u16,
+        style: CardStyle,
+        summary: Option<String>,
+        expanded: bool,
+        heading: bool,
+        footer: bool,
+    ) -> Self {
+        self.with_card(width, style, summary, expanded, heading, footer, false)
+    }
+
+    pub(in crate::transcript_view) fn with_message_card(
+        self,
+        width: u16,
+        style: CardStyle,
+        expanded: bool,
+        heading: bool,
+        footer: bool,
+    ) -> Self {
+        self.with_card(width, style, None, expanded, heading, footer, true)
+    }
+
+    fn with_card(
+        mut self,
+        width: u16,
+        style: CardStyle,
+        summary: Option<String>,
+        expanded: bool,
+        heading: bool,
+        footer: bool,
+        message: bool,
+    ) -> Self {
+        let max = style.maximum(width);
+        let inset = style.inset(max);
+        // Source-free state gutter; tools retain their interactive action summary.
+        let marker_gutter = if message && style.expandable { 2 } else { 0 };
+        let label = summary
+            .as_ref()
+            .map(|s| format!("{} {s}", if expanded { "[-]" } else { "[+]" }));
+        let title = if heading && style.title_visible {
+            style.title.clone()
+        } else {
+            String::new()
+        };
+        let content = self
+            .rows
+            .iter()
+            .map(|r| r.line.line.width())
+            .max()
+            .unwrap_or(0)
+            .max(
+                label
+                    .as_ref()
+                    .map_or(0, |v| unicode_width::UnicodeWidthStr::width(v.as_str())),
+            );
+        let outer = if !footer {
+            max
+        } else {
+            (content.saturating_add(usize::from(2 * inset + marker_gutter)))
+                .max(unicode_width::UnicodeWidthStr::width(title.as_str()))
+                .max(1)
+                .min(usize::from(max)) as u16
+        };
+        let inset = style.inset(outer);
+        let inner = outer - 2 * inset;
+        let marker_gutter = marker_gutter.min(inner.saturating_sub(1));
+        let body_width = inner - marker_gutter;
+        if body_width != self.width {
+            // Recompute alignment and hit positions for the content-fitted width.
+            self = Self::from_logical(self.logical.clone(), body_width);
+        }
+        if message && !expanded {
+            // Fold only the painted rows. Source and links remain intact for copying/search;
+            // rewrap repeats this projection at the new width instead of losing the source.
+            let first = self
+                .rows
+                .iter()
+                .position(|r| !r.line.line.to_string().trim().is_empty())
+                .unwrap_or(0);
+            if first < self.rows.len() {
+                let row = self.rows.remove(first);
+                self.rows = vec![row];
+            }
+        }
+        let left = if style.align == Align::Right {
+            width.max(1) - outer
+        } else {
+            0
+        };
+        let reserved = style.half_rows().div_ceil(2);
+        let top_rows = if heading { reserved } else { 0 };
+        let bottom_rows = if footer { reserved } else { 0 };
+        let body_lines = self.logical.len();
+        if let Some(label) = &label {
+            self.rows.insert(
+                0,
+                Self::mycodx_row(
+                    truncate_line_to_width(Line::from(label.clone()).bold(), usize::from(inner)),
+                    0,
+                    inner,
+                ),
+            );
+        }
+        // A card without source or a summary still has a visible body row.
+        if self.rows.is_empty() {
+            self.rows.push(Self::mycodx_row(Line::default(), 0, inner));
+        }
+        let marker_body_row = (heading && marker_gutter > 0).then(|| {
+            self.rows
+                .iter()
+                .position(|r| !r.line.line.to_string().trim().is_empty())
+                .unwrap_or(0)
+        });
+        for row in &mut self.rows {
+            row.render_offset = left + inset + marker_gutter;
+            row.first_column += usize::from(left + inset + marker_gutter);
+            row.content_width = body_width;
+        }
+        for _ in 0..top_rows {
+            self.rows.insert(0, Self::mycodx_row(Line::default(), 0, 0));
+        }
+        for _ in 0..bottom_rows {
+            self.rows
+                .push(Self::mycodx_row(Line::default(), self.text.len(), 0));
+        }
+        let title_rows = usize::from(!title.is_empty());
+        if title_rows != 0 {
+            let line = truncate_line_to_width(Line::from(title).dim(), usize::from(outer));
+            let offset = left
+                + if style.align == Align::Right {
+                    outer.saturating_sub(line.width() as u16)
+                } else {
+                    0
+                };
+            let mut row = Self::mycodx_row(line, 0, outer);
+            row.render_offset = offset;
+            row.first_column = usize::from(offset);
+            self.rows.insert(0, row);
+        }
+        self.width = width.max(1);
+        self.disclosure = summary.is_some() || (message && style.expandable);
+        self.disclosure_control = label.map(|label| DisclosureControl {
+            label,
+            source_offset: 0,
+            row: title_rows + usize::from(top_rows),
+        });
+        self.common_card = Some(CommonCard {
+            style,
+            summary,
+            message,
+            expanded,
+            heading,
+            footer,
+            body_lines,
+            left,
+            width: outer,
+            rows: title_rows..self.rows.len(),
+            top_rows,
+            bottom_rows,
+            marker_row: marker_body_row.map(|row| row + title_rows + usize::from(top_rows)),
+            marker_gutter,
+        });
+        self
+    }
+    pub(super) fn rewrap_common(&self, width: u16, card: &CommonCard) -> Self {
+        Self::from_logical(
+            self.logical[..card.body_lines].to_vec(),
+            if card.message {
+                card.style.message_content_width(width)
+            } else {
+                card.style.content_width(width)
+            },
+        )
+        .with_card(
+            width,
+            card.style.clone(),
+            card.summary.clone(),
+            card.expanded,
+            card.heading,
+            card.footer,
+            card.message,
+        )
+        .append_mycodx_auxiliary(Self::from_logical(
+            self.logical[card.body_lines..].to_vec(),
+            width,
+        ))
+    }
+    pub(super) fn shift_common(&mut self) {
+        if let Some(c) = &mut self.common_card {
+            c.rows.start += 1;
+            c.rows.end += 1;
+            if let Some(row) = &mut c.marker_row {
+                *row += 1;
+            }
+        }
+    }
+    #[cfg(test)]
+    pub(in crate::transcript_view) fn mycodx_background_at(&self, row: usize, column: u16) -> bool {
+        self.mycodx_background_at_state(row, column, false)
+    }
+    pub(in crate::transcript_view) fn mycodx_background_at_state(
+        &self,
+        row: usize,
+        column: u16,
+        active: bool,
+    ) -> bool {
+        let Some(card) = &self.common_card else {
+            return false;
+        };
+        if !card.style.expandable
+            || !card.style.colors_for(active).filled
+            || !card.rows.contains(&row)
+            || !(card.left..card.left + card.width).contains(&column)
+        {
+            return false;
+        }
+        let Some(text_row) = self.rows.get(row) else {
+            return false;
+        };
+        let start = text_row
+            .first_column
+            .saturating_sub(text_row.prefix_columns);
+        let end = start + text_row.line.line.width();
+        !(start..end).contains(&usize::from(column))
+    }
+
+    pub(in crate::transcript_view) fn mycodx_focusable(&self) -> bool {
+        self.common_card.is_some() && !self.rows.is_empty()
+    }
+
+    pub(in crate::transcript_view) fn mycodx_card_at(&self, row: usize, column: u16) -> bool {
+        self.common_card.as_ref().is_some_and(|card| {
+            card.rows.contains(&row) && (card.left..card.left + card.width).contains(&column)
+        })
+    }
+
+    pub(in crate::transcript_view) fn mycodx_focus_row(&self) -> Option<usize> {
+        self.disclosure_row().or_else(|| {
+            self.common_card
+                .as_ref()
+                .map(|c| c.rows.start + usize::from(c.top_rows))
+        })
+    }
+
+    pub(super) fn common_heading(&self) -> bool {
+        self.common_card.as_ref().is_some_and(|c| c.heading)
+    }
+    pub(super) fn render_common_row(
+        &self,
+        area: Rect,
+        buf: &mut Buffer,
+        index: usize,
+        y: u16,
+        active: bool,
+    ) {
+        let Some(c) = &self.common_card else {
+            return;
+        };
+        if !c.rows.contains(&index) {
+            return;
+        }
+        let row = index - c.rows.start;
+        let height = c.rows.len();
+        let paint = c.style.colors_for(active);
+        let top = padding_sample(c, paint, row * 2, height);
+        let bottom = padding_sample(c, paint, row * 2 + 1, height);
+        // Resolve palette colors once per row, including on 256-color terminals.
+        let body = paint.body();
+        let (symbol, style) = if paint.filled {
+            half_cell(top, bottom, paint.outer)
+        } else {
+            (" ", body)
+        };
+        for x in 0..c.width.min(area.width.saturating_sub(c.left)) {
+            if let Some(cell) = buf.cell_mut((area.x + c.left + x, area.y + y)) {
+                cell.set_symbol(symbol).set_style(style);
+            }
+        }
+        if row >= usize::from(c.top_rows) && row < height.saturating_sub(usize::from(c.bottom_rows))
+        {
+            let inset = c.style.inset(c.width);
+            buf.set_style(
+                Rect::new(area.x + c.left + inset, area.y + y, c.width - 2 * inset, 1),
+                body,
+            );
+        }
+        if c.marker_row == Some(index) && c.marker_gutter > 0 {
+            let x = c.left + c.style.inset(c.width);
+            if x < area.width {
+                if let Some(cell) = buf.cell_mut((area.x + x, area.y + y)) {
+                    cell.set_symbol(if c.expanded { "▾" } else { "▸" })
+                        .set_style(body);
+                }
+            }
+        }
+    }
+}
+
+fn padding_sample(c: &CommonCard, p: Paint, y: usize, height: usize) -> (u8, u8, u8) {
+    let top = if c.heading {
+        usize::from(c.top_rows) * 2 - usize::from(c.style.half_rows())
+    } else {
+        0
+    };
+    let bottom = height * 2
+        - if c.footer {
+            usize::from(c.bottom_rows) * 2 - usize::from(c.style.half_rows())
+        } else {
+            0
+        };
+    if y < top || y >= bottom {
+        return p.outer;
+    }
+    p.bg
+}
+fn half_cell(
+    top: (u8, u8, u8),
+    bottom: (u8, u8, u8),
+    outer: (u8, u8, u8),
+) -> (&'static str, Style) {
+    let (symbol, fg, bg) = if top == bottom {
+        (" ", top, top)
+    } else if top == outer {
+        ("▄", bottom, top)
+    } else {
+        ("▀", top, bottom)
+    };
+    (
+        symbol,
+        Style::default()
+            .bg(if bg == outer {
+                ratatui::style::Color::Reset
+            } else {
+                color(bg)
+            })
+            .fg(color(fg)),
+    )
+}
