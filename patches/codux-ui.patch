+use super::*;
+use crate::history_cell::{AgentMarkdownCell, PlainHistoryCell};
+use crate::mycodx_ui::Settings;
+use std::path::Path;
+
+#[derive(Debug)]
+struct Tool(&'static str);
+impl HistoryCell for Tool {
+    fn display_lines(&self, _: u16) -> Vec<Line<'static>> {
+        vec![self.0.into()]
+    }
+    fn raw_lines(&self) -> Vec<Line<'static>> {
+        vec![self.0.into()]
+    }
+    fn activity_ids(&self) -> Vec<String> {
+        vec![self.0.to_owned()]
+    }
+    fn has_stable_transcript_height(&self) -> bool {
+        true
+    }
+}
+fn question(text: &str, reply: bool) -> Arc<dyn HistoryCell> {
+    let mut cell = crate::history_cell::new_user_prompt(text.into(), vec![], vec![], vec![]);
+    cell.mycodx_reply = reply;
+    Arc::new(cell)
+}
+fn assistant(text: &str, final_answer: bool) -> Arc<dyn HistoryCell> {
+    Arc::new(
+        AgentMarkdownCell::new(text.into(), Path::new(".")).with_mycodx_final_answer(final_answer),
+    )
+}
+fn notice(text: &str) -> Arc<dyn HistoryCell> {
+    Arc::new(PlainHistoryCell::new(vec![Line::from(text.to_owned())]))
+}
+fn scan(view: &mut TranscriptView, cells: &[Arc<dyn HistoryCell>]) {
+    for _ in 0..128 {
+        if !view.advance_search(cells) {
+            return;
+        }
+    }
+    panic!("search did not finish its bounded scan");
+}
+fn index(view: &TranscriptView) -> Option<usize> {
+    view.search.current.as_ref().map(|hit| hit.anchor.index)
+}
+fn view() -> TranscriptView {
+    TranscriptView {
+        area: Rect::new(0, 0, 80, 20),
+        ..TranscriptView::default()
+    }
+}
+
+#[test]
+fn codux_search_tab_filters_hidden_cards_and_preserves_query_and_manual_state() {
+    crate::mycodx_ui::with_settings(Settings::web(), || {
+        let cells: Vec<Arc<dyn HistoryCell>> = vec![
+            question("needle question", false),
+            assistant("needle progress", false),
+            Arc::new(Tool("needle tool")),
+            question("needle reply", true),
+            assistant("needle intermediate", false),
+            assistant("needle final", true),
+            notice("needle notice"),
+        ];
+        for (detailed, mode) in [
+            (false, HistoryRenderMode::Rich),
+            (false, HistoryRenderMode::Raw),
+            (true, HistoryRenderMode::Rich),
+        ] {
+            let mut view = view();
+            view.set_presentation(detailed, mode);
+            let ids = view.activity_ids(&cells, 5);
+            view.disclosure.collapsed.extend(ids);
+            let collapsed = view.disclosure.collapsed.clone();
+            let expanded = view.disclosure.expanded.clone();
+            view.begin_search();
+            view.paste_search("needle");
+            for (scope, expected) in [
+                (SearchScope::All, 6),
+                (SearchScope::Questions, 3),
+                (SearchScope::Tools, 2),
+                (SearchScope::Intermediate, 4),
+                (SearchScope::Answers, 5),
+                (SearchScope::All, 6),
+            ] {
+                scan(&mut view, &cells);
+                assert_eq!(view.search.scope, scope);
+                assert_eq!(index(&view), Some(expected));
+                assert_eq!(view.search.editor.text(), "needle");
+                assert_eq!(view.disclosure.collapsed, collapsed);
+                assert_eq!(view.disclosure.expanded, expanded);
+                view.handle_search_key(KeyCode::Tab.into(), &cells);
+                assert!(view.search.current.is_none());
+            }
+            // Both legacy BackTab and enhanced Shift+Tab reverse the cycle.
+            for key in [
+                KeyCode::BackTab.into(),
+                KeyEvent::new(KeyCode::Tab, KeyModifiers::SHIFT),
+            ] {
+                view.handle_search_key(key, &cells);
+                scan(&mut view, &cells);
+            }
+            assert_eq!(view.search.scope, SearchScope::Answers);
+            assert_eq!(index(&view), Some(5));
+            view.cancel_search();
+            assert_eq!(view.disclosure.collapsed, collapsed);
+            assert_eq!(view.disclosure.expanded, expanded);
+        }
+    });
+}
+
+#[test]
+fn codux_search_filtered_skips_remain_bounded_and_continue_into_older_pages() {
+    let mut cells = (0..25).map(|_| notice("needle notice")).collect::<Vec<_>>();
+    let mut view = view();
+    view.history = TranscriptHistoryState::Partial;
+    view.begin_search();
+    view.search.scope = SearchScope::Tools;
+    view.paste_search("needle");
+    assert!(view.advance_search(&cells));
+    assert!(view.search.current.is_none());
+    scan(&mut view, &cells);
+    assert!(view.search.needs_history(view.history));
+    cells.insert(0, Arc::new(Tool("needle old tool")));
+    view.history = TranscriptHistoryState::Complete;
+    view.history_loaded(&cells, 0..1);
+    scan(&mut view, &cells);
+    assert_eq!(index(&view), Some(0));
+    view.handle_search_key(
+        KeyEvent::new(KeyCode::Char('n'), KeyModifiers::CONTROL),
+        &cells,
+    );
+    scan(&mut view, &cells);
+    assert!(matches!(view.search.progress, Progress::Exhausted));
+    assert_eq!(index(&view), Some(0));
+}
+
+#[test]
+fn codux_search_plan_and_replaced_final_use_card_classification() {
+    crate::mycodx_ui::with_settings(Settings::web(), || {
+        let mut cells: Vec<Arc<dyn HistoryCell>> = vec![
+            question("question", false),
+            Arc::new(crate::history_cell::new_proposed_plan(
+                "needle plan".into(),
+                Path::new("."),
+            )),
+        ];
+        let mut view = view();
+        view.begin_search();
+        view.search.scope = SearchScope::Answers;
+        view.paste_search("needle");
+        scan(&mut view, &cells);
+        assert_eq!(index(&view), Some(1));
+        view.cancel_search();
+        cells.push(assistant("needle final", true));
+        view.begin_search();
+        view.paste_search("needle");
+        scan(&mut view, &cells);
+        assert_eq!(index(&view), Some(2));
+        view.handle_search_key(KeyCode::BackTab.into(), &cells);
+        scan(&mut view, &cells);
+        assert_eq!(view.search.scope, SearchScope::Intermediate);
+        assert_eq!(index(&view), Some(1));
+    });
+}
+
+#[test]
+fn codux_search_scope_keeps_live_revision_type_and_refreshes_when_filter_changes() {
+    let mut view = view();
+    view.set_mycodx_stream(true);
+    view.set_mycodx_stream_section(Section::Intermediate);
+    view.begin_search();
+    view.search.scope = SearchScope::Intermediate;
+    view.sync_search_live_tail(80, None, |_| Some(vec![Line::from("needle live").into()]));
+    view.paste_search("needle");
+    scan(&mut view, &[]);
+    assert_eq!(
+        view.search.current.as_ref().unwrap().anchor.key,
+        EntryKey::Live
+    );
+    let anchor = view.search.current.as_ref().unwrap().anchor;
+    assert!(view.snapshot().is_some());
+    view.set_mycodx_stream_section(Section::Answers);
+    assert!(view.matches_search_scope(&[], anchor)); // frozen intermediate revision
+    view.handle_search_key(KeyCode::Tab.into(), &[]);
+    assert!(view.snapshot().is_none());
+    scan(&mut view, &[]);
+    assert_eq!(view.search.scope, SearchScope::Answers);
+    assert_eq!(
+        view.search.current.as_ref().unwrap().anchor.key,
+        EntryKey::Live
+    );
+}
+
+#[test]
+fn codux_search_scope_hints_fit_and_tab_is_reserved_only_while_editing() {
+    let cells = vec![assistant("needle", true)];
+    let mut view = view();
+    assert!(!view.handle_search_key(KeyCode::Tab.into(), &cells));
+    view.begin_search();
+    view.paste_search("needle");
+    for scope in [
+        SearchScope::All,
+        SearchScope::Questions,
+        SearchScope::Tools,
+        SearchScope::Intermediate,
+        SearchScope::Answers,
+    ] {
+        view.search.scope = scope;
+        let full = view.search.status_line(120, view.history).to_string();
+        assert!(full.contains(scope.label()));
+        assert!(full.contains("tab filter"));
+        for width in [10, 20, 30, 60] {
+            let hint = view.search.status_line(width, view.history);
+            assert!(hint.width() <= usize::from(width));
+            assert!(hint.to_string().contains("esc"));
+            if width >= 30 && scope != SearchScope::All {
+                assert!(hint.to_string().contains(scope.label()));
+            }
+        }
+    }
+    scan(&mut view, &cells);
+    view.handle_search_key(KeyCode::Enter.into(), &cells);
+    assert!(view.search.is_reading());
+    assert!(
+        view.search
+            .status_line(120, view.history)
+            .to_string()
+            .contains("Final answers")
+    );
+    assert!(!view.handle_search_key(KeyCode::Tab.into(), &cells));
+}
