+//! Runtime transcript settings, independent of syntax highlighting themes.
+#[path = "mycodx_input.rs"]
+mod input;
+#[path = "mycodx_style.rs"]
+pub(crate) mod style;
+pub(crate) use input::InputView;
+#[path = "mycodx_menu.rs"]
+mod menu;
+#[path = "mycodx_status.rs"]
+pub(crate) mod status;
+#[path = "mycodx_theme.rs"]
+mod theme;
+pub(crate) use menu::*;
+use std::io::Write;
+use std::path::Path;
+use std::sync::{LazyLock, RwLock};
+pub(crate) use style::{Align, Background, CardStyle};
+
+use serde::{Deserialize, Serialize};
+
+/// Presentation only: questions, replies, final answers and notices remain visible.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum CardMode {
+    Progress,
+    Answers,
+    All,
+    Custom,
+}
+
+impl CardMode {
+    pub(crate) const ALL: [Self; 3] = [Self::Progress, Self::Answers, Self::All];
+
+    pub(crate) fn label(self) -> &'static str {
+        match self {
+            Self::Progress => "0: Progress",
+            Self::Answers => "1: Answers only",
+            Self::All => "2: All cards",
+            Self::Custom => "Custom",
+        }
+    }
+
+    pub(crate) fn description(self) -> &'static str {
+        match self {
+            Self::Progress => "Hide tools; show intermediate and final answers",
+            Self::Answers => "Hide tools and intermediate answers",
+            Self::All => "Show tools, intermediate and final answers",
+            Self::Custom => "Show tools; hide intermediate answers",
+        }
+    }
+
+    pub(crate) fn next(self) -> Self {
+        match self {
+            Self::Progress => Self::Answers,
+            Self::Answers => Self::All,
+            Self::All | Self::Custom => Self::Progress,
+        }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default = "Settings::legacy_defaults", deny_unknown_fields)]
+pub(crate) struct Settings {
+    pub working_animation: status::WorkingAnimation,
+    pub mermaid: crate::codux_mermaid::Mode,
+    pub mermaid_text: crate::codux_mermaid::style::TextStyle,
+    pub mermaid_style: crate::codux_mermaid::style::ImageStyle,
+    pub cards: Option<[CardStyle; 3]>,
+    pub reply: Option<CardStyle>,
+    pub intermediate: Option<CardStyle>,
+    pub show_tools: bool,
+    pub show_intermediate: bool,
+    #[serde(skip_serializing)]
+    pub question_bubble: bool,
+    #[serde(skip_serializing)]
+    pub question_width: u16,
+    #[serde(skip_serializing)]
+    pub question_padding: u16,
+    #[serde(skip_serializing)]
+    pub question_highlight: bool,
+    #[serde(skip_serializing)]
+    pub question_title: bool,
+    #[serde(skip_serializing)]
+    pub answer_card: bool,
+    #[serde(skip_serializing)]
+    pub answer_title: bool,
+    #[serde(skip_serializing)]
+    pub answer_padding: u16,
+    #[serde(skip_serializing)]
+    pub answer_highlight: bool,
+    #[serde(skip_serializing)]
+    pub tools_title: bool,
+    #[serde(skip_serializing)]
+    pub tools_padding: u16,
+    #[serde(skip_serializing)]
+    pub tools_highlight: bool,
+}
+
+impl Default for Settings {
+    fn default() -> Self {
+        Self::shipped_defaults()
+    }
+}
+
+impl Settings {
+    pub(crate) fn card_mode(&self) -> CardMode {
+        match (self.show_tools, self.show_intermediate) {
+            (false, true) => CardMode::Progress,
+            (false, false) => CardMode::Answers,
+            (true, true) => CardMode::All,
+            (true, false) => CardMode::Custom,
+        }
+    }
+
+    pub(crate) fn with_card_mode(&self, mode: CardMode) -> Self {
+        let mut next = self.clone();
+        next.show_tools = matches!(mode, CardMode::All | CardMode::Custom);
+        next.show_intermediate = matches!(mode, CardMode::Progress | CardMode::All);
+        next
+    }
+
+    pub(crate) fn is_shipped_default(&self) -> bool {
+        let defaults = Self::default().normalized();
+        let mut actual = self.normalized();
+        // The resolved card styles supersede this non-persisted legacy switch.
+        actual.answer_card = defaults.answer_card;
+        actual == defaults
+    }
+
+    fn legacy_defaults() -> Self {
+        Self {
+            working_animation: status::WorkingAnimation::default(),
+            mermaid: crate::codux_mermaid::Mode::default(),
+            mermaid_text: crate::codux_mermaid::style::TextStyle::default(),
+            mermaid_style: crate::codux_mermaid::style::ImageStyle::default(),
+            cards: None,
+            reply: None,
+            intermediate: None,
+            show_tools: false,
+            show_intermediate: true,
+            question_bubble: true,
+            question_width: 70,
+            question_padding: 1,
+            question_highlight: true,
+            question_title: false,
+            answer_card: false,
+            answer_title: false,
+            answer_padding: 1,
+            answer_highlight: false,
+            tools_title: false,
+            tools_padding: 1,
+            tools_highlight: true,
+        }
+    }
+
+    pub(crate) fn web() -> Self {
+        let mut settings = Self::legacy_defaults().normalized();
+        for section in [
+            Section::Questions,
+            Section::Replies,
+            Section::Tools,
+            Section::Intermediate,
+            Section::Answers,
+        ] {
+            settings = settings.change_card(section, |card| {
+                card.padding_x = 1;
+                card.padding_y = 1;
+            });
+        }
+        settings
+    }
+
+    /// First-install colors use Ocean Dark with a transparent final-answer surface.
+    fn shipped_defaults() -> Self {
+        let mut settings = Self::web();
+        settings.working_animation = status::WorkingAnimation::OneSecond;
+        for ((section, width, padding_y, expanded), background) in [
+            (Section::Questions, 60, 1, true),
+            (Section::Replies, 70, 1, true),
+            (Section::Tools, 100, 1, false),
+            (Section::Intermediate, 100, 1, false),
+            (Section::Answers, 100, 1, true),
+        ]
+        .into_iter()
+        .zip(theme::default_colors())
+        {
+            settings = settings.change_card(section, |card| {
+                card.max_width = width;
+                card.padding_y = padding_y;
+                card.default_expanded = Some(expanded);
+                card.background = background;
+                card.title_visible = false;
+            });
+        }
+        settings
+    }
+
+    #[cfg(test)]
+    pub(crate) fn cards() -> Self {
+        Self {
+            answer_card: true,
+            ..Self::comparison()
+        }
+    }
+
+    pub(crate) fn visible(&self, section: Section) -> bool {
+        match section {
+            Section::Tools => self.show_tools,
+            Section::Intermediate => self.show_intermediate,
+            _ => true,
+        }
+    }
+
+    fn normalized(&self) -> Self {
+        let cards = [
+            self.card(Section::Questions),
+            self.card(Section::Tools),
+            self.card(Section::Answers),
+        ];
+        Self {
+            cards: Some(cards),
+            working_animation: self.working_animation,
+            mermaid: if self.mermaid == crate::codux_mermaid::Mode::Text {
+                self.mermaid
+            } else {
+                crate::codux_mermaid::Mode::Auto
+            },
+            mermaid_text: self.mermaid_text.clone(),
+            mermaid_style: self.mermaid_style.clone(),
+            reply: Some(self.card(Section::Replies)),
+            intermediate: Some(self.card(Section::Intermediate)),
+            show_tools: self.show_tools,
+            show_intermediate: self.show_intermediate,
+            answer_card: self.answer_card,
+            ..Self::legacy_defaults()
+        }
+    }
+
+    fn validate(&self) -> anyhow::Result<Self> {
+        self.mermaid_style.validate()?;
+        self.mermaid_text.validate()?;
+        for section in [Section::Replies, Section::Intermediate] {
+            self.card(section).validate()?;
+        }
+        if let Some(cards) = &self.cards {
+            for card in cards {
+                card.validate()?;
+            }
+        }
+        anyhow::ensure!(
+            (30..=100).contains(&self.question_width),
+            "question_width must be 30..100"
+        );
+        anyhow::ensure!(self.question_padding <= 3, "question_padding must be 0..3");
+        anyhow::ensure!(self.tools_padding <= 3, "tools_padding must be 0..3");
+        anyhow::ensure!(self.answer_padding <= 3, "answer_padding must be 0..3");
+        Ok(self.normalized())
+    }
+}
+
+static CURRENT: LazyLock<RwLock<Settings>> = LazyLock::new(|| {
+    #[cfg(test)]
+    let settings = Settings::cards();
+    #[cfg(not(test))]
+    let settings = Settings::default();
+    RwLock::new(settings)
+});
+
+#[cfg(test)]
+thread_local! { static TEST_SETTINGS: std::cell::RefCell<Option<Settings>> = const { std::cell::RefCell::new(None) }; }
+
+pub(crate) fn tools_visible() -> bool {
+    #[cfg(test)]
+    if let Some(value) = TEST_SETTINGS.with(|v| v.borrow().as_ref().map(|s| s.show_tools)) {
+        return value;
+    }
+    CURRENT.read().unwrap_or_else(|e| e.into_inner()).show_tools
+}
+
+pub(crate) fn current_card(section: Section) -> CardStyle {
+    #[cfg(test)]
+    if let Some(value) = TEST_SETTINGS.with(|v| v.borrow().as_ref().map(|s| s.card(section))) {
+        return value;
+    }
+    CURRENT
+        .read()
+        .unwrap_or_else(|e| e.into_inner())
+        .card(section)
+}
+
+pub(crate) fn current() -> Settings {
+    #[cfg(test)]
+    if let Some(settings) = TEST_SETTINGS.with(|value| value.borrow().clone()) {
+        return settings;
+    }
+    CURRENT
+        .read()
+        .unwrap_or_else(|error| error.into_inner())
+        .clone()
+}
+
+pub(crate) fn set(settings: Settings) {
+    let settings = settings.normalized();
+    #[cfg(test)]
+    if TEST_SETTINGS.with(|value| value.borrow().is_some()) {
+        TEST_SETTINGS.with(|value| *value.borrow_mut() = Some(settings));
+        return;
+    }
+    *CURRENT.write().unwrap_or_else(|error| error.into_inner()) = settings;
+}
+
+#[cfg(test)]
+pub(crate) fn with_settings<T>(settings: Settings, run: impl FnOnce() -> T) -> T {
+    struct Restore(Option<Settings>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            TEST_SETTINGS.with(|value| *value.borrow_mut() = self.0.take());
+        }
+    }
+    let _restore = Restore(TEST_SETTINGS.with(|value| value.replace(Some(settings.normalized()))));
+    crate::terminal_palette::with_card_fixture_palette(run)
+}
+
+#[derive(Default, Serialize, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+struct FileSettings {
+    active: Settings,
+    // Preserve old snapshots on disk without exposing or applying them.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    presets: Option<serde_json::Value>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    default_preset_version: Option<u32>,
+    #[serde(skip_serializing)]
+    custom: Option<Settings>,
+}
+
+fn read(home: &Path) -> anyhow::Result<FileSettings> {
+    let path = if home.join("codux-ui.json").try_exists()? {
+        home.join("codux-ui.json")
+    } else {
+        // Import the pre-release settings without modifying the old file.
+        home.join("mycodx-ui.json")
+    };
+    let mut file: FileSettings = match std::fs::read(path) {
+        Ok(bytes) => {
+            let mut value: serde_json::Value = serde_json::from_slice(&bytes)?;
+            for key in ["active", "custom"] {
+                if let Some(settings) = value
+                    .get_mut(key)
+                    .and_then(serde_json::Value::as_object_mut)
+                {
+                    for obsolete in [
+                        "question_inset",
+                        "question_border",
+                        "question_fill_border",
+                        "answer_inset",
+                        "answer_border",
+                        "answer_fill_border",
+                        "tools_border",
+                        "tools_inset",
+                        "tools_fill_border",
+                    ] {
+                        settings.remove(obsolete);
+                    }
+                    if let Some(cards) = settings
+                        .get_mut("cards")
+                        .and_then(serde_json::Value::as_array_mut)
+                    {
+                        for card in cards {
+                            if let Some(card) = card.as_object_mut() {
+                                card.remove("border");
+                                card.remove("background_active");
+                            }
+                        }
+                    }
+                    for key in ["reply", "intermediate"] {
+                        if let Some(card) = settings
+                            .get_mut(key)
+                            .and_then(serde_json::Value::as_object_mut)
+                        {
+                            card.remove("background_active");
+                        }
+                    }
+                }
+            }
+            serde_json::from_value(value)?
+        }
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => FileSettings::default(),
+        Err(error) => return Err(error.into()),
+    };
+    file.active = file.active.validate()?;
+    file.custom = file.custom.map(|custom| custom.validate()).transpose()?;
+    Ok(file)
+}
+
+pub(crate) fn load(home: &Path) -> anyhow::Result<()> {
+    let missing = !home.join("codux-ui.json").try_exists()?;
+    let fresh = missing && !home.join("mycodx-ui.json").try_exists()?;
+    let mut file = read(home)?;
+    if missing {
+        if fresh {
+            file.active = Settings::default();
+        }
+        write_settings(home, &file)?;
+    }
+    set(file.active);
+    Ok(())
+}
+
+pub(crate) fn save(home: &Path, settings: Settings) -> anyhow::Result<()> {
+    let settings = settings.validate()?;
+    let mut file = read(home)?;
+    file.active = settings.clone();
+    file.custom = None;
+    write_settings(home, &file)?;
+    set(file.active);
+    Ok(())
+}
+
+fn write_settings(home: &Path, file: &FileSettings) -> anyhow::Result<()> {
+    std::fs::create_dir_all(home)?;
+    let mut temporary = tempfile::NamedTempFile::new_in(home)?;
+    temporary.write_all(&serde_json::to_vec_pretty(&file)?)?;
+    temporary.write_all(b"\n")?;
+    temporary.persist(home.join("codux-ui.json"))?;
+    Ok(())
+}
