+        assert_eq!(anchor.row_bias, layout.mycodx_heading_bias());
+        assert_eq!(
+            layout.row_for_offset(anchor.offset) as isize - anchor.row_bias,
+            layout.mycodx_focus_row().unwrap() as isize,
+        );
+        view.handle_disclosure_key(KeyCode::Enter.into(), &cells);
+    }
+}
