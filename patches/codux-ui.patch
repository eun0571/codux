+//! Image rows replace only presentation; logical lines/copy metadata remain canonical.
+use super::*;
+use crate::codux_mermaid::Preview;
+use crate::terminal_hyperlinks::TerminalHyperlink;
+
+impl TextLayout {
+    pub(super) fn project_mermaid(&mut self) {
+        let mut blocks: Vec<(Range<usize>, std::sync::Arc<str>)> = Vec::new();
+        let mut offset = 0;
+        for logical in &self.logical {
+            let end = offset + logical.origin.range.len();
+            if let Some(copy) = logical.origin.copy.as_deref()
+                && copy.mermaid
+                && let Some(source) = &copy.code_source
+            {
+                if let Some((range, previous)) = blocks.last_mut()
+                    && std::sync::Arc::ptr_eq(previous, source)
+                    && range.end + 1 == offset
+                {
+                    range.end = end;
+                } else {
+                    blocks.push((offset..end, source.clone()));
+                }
+            }
+            offset = end + 1;
+        }
+        for (range, source) in blocks.into_iter().rev() {
+            if let Some(preview) = crate::codux_mermaid::request(&source, self.width) {
+                if crate::codux_mermaid::comparing_text() {
+                    self.compare_mermaid_rows(range, preview);
+                } else {
+                    self.replace_mermaid_rows(range, preview);
+                }
+            }
+        }
+    }
+
+    fn compare_mermaid_rows(&mut self, range: Range<usize>, preview: Preview) {
+        let Some(first) = self
+            .rows
+            .iter()
+            .position(|row| row.source.start >= range.start && row.source.start < range.end)
+        else {
+            return;
+        };
+        let last = self
+            .rows
+            .iter()
+            .rposition(|row| row.source.start >= range.start && row.source.start < range.end)
+            .unwrap_or(first);
+        let native: Vec<_> = self.rows.drain(first..=last).collect();
+        let mut placeholder = Self::mycodx_row(Line::from(""), range.start, self.width);
+        placeholder.source = range.clone();
+        self.rows.insert(first, placeholder);
+        let old_len = self.rows.len();
+        self.replace_mermaid_rows(range.clone(), preview);
+        let count = self.rows.len() + 1 - old_len;
+        let mut beautiful = self.rows.drain(first..first + count).collect::<Vec<_>>();
+        for row in &mut beautiful {
+            row.source = range.end..range.end;
+        }
+        let mut combined = vec![Self::mycodx_row(
+            Line::from("Codex text only").bold(),
+            range.start,
+            self.width,
+        )];
+        combined.extend(native);
+        combined.push(Self::mycodx_row(
+            Line::from("Beautiful text").bold(),
+            range.end,
+            self.width,
+        ));
+        combined.extend(beautiful);
+        self.rows.splice(first..first, combined);
+    }
+
+    fn replace_mermaid_rows(&mut self, range: Range<usize>, preview: Preview) {
+        let Some(first) = self
+            .rows
+            .iter()
+            .position(|row| row.source.start >= range.start && row.source.start < range.end)
+        else {
+            return;
+        };
+        let last = self
+            .rows
+            .iter()
+            .rposition(|row| row.source.start >= range.start && row.source.start < range.end)
+            .unwrap_or(first);
+        let pending = matches!(preview, Preview::Pending);
+        let (label, path, images) = match preview {
+            Preview::Text(lines) => {
+                let rows = lines
+                    .iter()
+                    .enumerate()
+                    .map(|(index, line)| {
+                        let mut row = Self::mycodx_row(
+                            codex_ansi_escape::ansi_escape_line(line),
+                            range.end,
+                            self.width,
+                        );
+                        // Drawing rows are presentation. Selecting the complete block still
+                        // resolves to its original Mermaid copy metadata.
+                        if index == 0 {
+                            row.source = range.clone();
+                        }
+                        row
+                    })
+                    .collect::<Vec<_>>();
+                self.rows.splice(first..=last, rows);
+                return;
+            }
+            Preview::Pending => ("Mermaid · rendering…".to_owned(), None, None),
+            Preview::Failed(error) => {
+                tracing::debug!("Mermaid image unavailable; keeping Codex text: {error}");
+                return;
+            }
+            Preview::Ready { path, rows } => {
+                if rows.is_empty() && !crate::codux_mermaid::comparing_text() {
+                    return;
+                }
+                let label = if rows.is_empty() {
+                    "Mermaid · open diagram (inline images unavailable)"
+                } else {
+                    "Mermaid · open full size"
+                };
+                (label.to_owned(), Some(path), Some(rows))
+            }
+        };
+        let mut heading = Self::mycodx_row(
+            crate::line_truncation::truncate_line_to_width(
+                Line::from(label).bold(),
+                usize::from(self.width),
+            ),
+            range.start,
+            self.width,
+        );
+        heading.source = range.clone();
+        heading.mermaid_pending = pending;
+        if pending {
+            heading.line.line.style = Style::default();
+        }
+        if let Some(path) = path
+            && let Ok(url) = url::Url::from_file_path(path)
+        {
+            let mut link = TerminalHyperlink::web(0..heading.line.width(), String::new());
+            link.retarget_to_trusted_file(&url);
+            heading.line.hyperlinks.push(link);
+        }
+        let mut replacement = vec![heading];
+        if let Some(images) = images {
+            for image in images.iter() {
+                let mut row = Self::mycodx_row(
+                    Line::from(" ".repeat(usize::from(image.columns))),
+                    range.end,
+                    self.width,
+                );
+                row.image = Some(image.clone());
+                replacement.push(row);
+            }
+        }
+        self.rows.splice(first..=last, replacement);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::markdown_render::render_markdown_lines_with_width_and_cwd;
+    #[test]
+    fn comparison_keeps_native_source_and_colored_text_in_order() {
+        let markdown = "Before\n\n```mermaid\nflowchart LR\n A[Hello] --> B[World]\n```\n\nAfter";
+        for preview in [
+            Preview::Pending,
+            Preview::Text(std::sync::Arc::new(vec!["\x1b[31mConverted\x1b[0m".into()])),
+            Preview::Failed("Cannot render".into()),
+        ] {
+            let mut layout = TextLayout::new(
+                render_markdown_lines_with_width_and_cwd(markdown, Some(100), None),
+                100,
+            );
+            let text = layout.text.clone();
+            let copies = layout.copy_block_ranges();
+            let range = copies
+                .iter()
+                .find(|(_, name, _)| *name == "Code block")
+                .unwrap()
+                .0
+                .clone();
+            layout.compare_mermaid_rows(range, preview);
+            assert_eq!(layout.text, text);
+            assert_eq!(layout.copy_block_ranges(), copies);
+            let lines: Vec<_> = layout
+                .rows
+                .iter()
+                .map(|row| row.line.line.to_string())
+                .collect();
+            let native = lines
+                .iter()
+                .position(|line| line == "Codex text only")
+                .unwrap();
+            let beautiful = lines
+                .iter()
+                .position(|line| line == "Beautiful text")
+                .unwrap();
+            assert!(native < beautiful);
+            assert!(
+                lines[native + 1..beautiful]
+                    .iter()
+                    .any(|line| line.contains("Hello"))
+            );
+            assert!(lines.last().unwrap().contains("After"));
+            if let Some(row) = layout
+                .rows
+                .iter()
+                .find(|row| row.line.line.to_string() == "Converted")
+            {
+                assert!(
+                    row.line
+                        .line
+                        .spans
+                        .iter()
+                        .any(|span| span.style.fg.is_some())
+                );
+                assert!(row.source.is_empty());
+            }
+        }
+    }
+
+    #[test]
+    fn only_complete_mermaid_fences_are_image_candidates() {
+        for (source, expected) in [
+            ("```mermaid\nflowchart LR\n A --> B\n```", true),
+            ("```mermaid\nflowchart LR\n A --> B", false),
+            ("```text\nflowchart LR\n A --> B\n```", false),
+        ] {
+            let layout = TextLayout::new(
+                render_markdown_lines_with_width_and_cwd(source, Some(60), None),
+                60,
+            );
+            assert_eq!(
+                layout.logical.iter().any(|line| line
+                    .origin
+                    .copy
+                    .as_ref()
+                    .is_some_and(|copy| copy.mermaid)),
+                expected
+            );
+        }
+    }
+
+    #[test]
+    fn mermaid_file_fallback_and_failure_preserve_copy_source() {
+        let source =
+            "Before\n\n```mermaid\nflowchart LR\n A[Hello] --> B[(Database)]\n```\n\nAfter";
+        for preview in [
+            Preview::Ready {
+                path: std::env::temp_dir().join("diagram.svg"),
+                rows: std::sync::Arc::new(Vec::new()),
+            },
+            Preview::Failed("Invalid diagram".into()),
+        ] {
+            let lines = render_markdown_lines_with_width_and_cwd(source, Some(60), None);
+            let mut layout = TextLayout::new(lines, 60);
+            let before = layout.copy_block_ranges();
+            let (range, _, _) = before
+                .iter()
+                .find(|(_, name, _)| *name == "Code block")
+                .unwrap();
+            let text = layout.text.clone();
+            layout.replace_mermaid_rows(range.clone(), preview.clone());
+            assert!(layout.rows.iter().all(|row| !row.mermaid_pending));
+            assert_eq!(layout.text, text);
+            assert_eq!(layout.copy_block_ranges(), before);
+            assert!(
+                layout
+                    .rows
+                    .iter()
+                    .any(|r| r.line.line.to_string().contains("After"))
+            );
+            match preview {
+                Preview::Ready { .. } => {
+                    assert!(layout.rows.iter().all(|r| r.image.is_none()));
+                    assert!(
+                        layout.rows.iter().any(|r| r
+                            .line
+                            .line
+                            .to_string()
+                            .contains("B[(Database)]"))
+                    )
+                }
+                Preview::Failed(_) => assert!(
+                    layout
+                        .rows
+                        .iter()
+                        .any(|r| r.line.line.to_string().contains("B[(Database)]"))
+                ),
+                Preview::Pending | Preview::Text(_) => unreachable!(),
+            }
+        }
+    }
+    #[test]
+    fn text_fallback_keeps_source_and_renders_korean_as_normal_cells() {
+        let source = "Before\n\n```mermaid\nflowchart LR\n A[\u{c785}\u{b825}] --> B[(\u{b370}\u{c774}\u{d130})]\n```\n\nAfter";
+        let mut layout = TextLayout::new(
+            render_markdown_lines_with_width_and_cwd(source, Some(80), None),
+            80,
+        );
+        let original = layout.text.clone();
+        let blocks = layout.copy_block_ranges();
+        let range = blocks
+            .iter()
+            .find(|(_, label, _)| *label == "Code block")
+            .unwrap()
+            .0
+            .clone();
+        let lines = vec![
+            "┌──────┐".to_owned(),
+            "│ \u{c785}\u{b825} │".to_owned(),
+            "└──────┘".to_owned(),
+        ];
+        layout.replace_mermaid_rows(range.clone(), Preview::Text(std::sync::Arc::new(lines)));
+        assert_eq!(layout.text, original);
+        assert_eq!(layout.copy_block_ranges(), blocks);
+        assert!(
+            layout
+                .rows
+                .iter()
+                .all(|row| row.image.is_none() && !row.mermaid_pending)
+        );
+        assert!(layout.rows.iter().all(|row| {
+            !row.line
+                .line
+                .to_string()
+                .contains("terminal renderer doesn't support")
+        }));
+        let first = layout
+            .rows
+            .iter()
+            .position(|row| row.line.line.to_string() == "┌──────┐")
+            .unwrap();
+        let mut buffer = Buffer::empty(Rect::new(0, 0, 80, 3));
+        layout.render(buffer.area, &mut buffer, first);
+        assert_eq!(buffer[(2, 1)].symbol(), "\u{c785}");
+        assert_eq!(buffer[(4, 1)].symbol(), "\u{b825}");
+        assert_eq!(buffer[(7, 1)].symbol(), "│");
+        assert!(
+            layout
+                .rows
+                .iter()
+                .any(|row| row.line.line.to_string().contains("After"))
+        );
+        assert_eq!(layout.position_at(first + 2, 79), range.end);
+    }
+    #[test]
+    fn mermaid_projection_keeps_source_and_neighboring_prose() {
+        crate::mycodx_ui::with_settings(crate::mycodx_ui::Settings::web(), || {
+            let source =
+                "Before\n\n```mermaid\nflowchart LR\n A[Hello] --> B[(Database)]\n```\n\nAfter";
+            let lines = render_markdown_lines_with_width_and_cwd(source, Some(80), None);
+            let mut layout = TextLayout::new(lines, 80);
+            let original = layout.text.clone();
+            let (range, _, retained) = layout
+                .copy_block_ranges()
+                .into_iter()
+                .find(|(_, name, _)| *name == "Code block")
+                .unwrap();
+            layout.replace_mermaid_rows(range.clone(), Preview::Pending);
+            assert_eq!(
+                layout.rows.iter().filter(|row| row.mermaid_pending).count(),
+                1
+            );
+            let pending_row = layout
+                .rows
+                .iter()
+                .position(|row| row.mermaid_pending)
+                .unwrap();
+            let mut buffer = Buffer::empty(Rect::new(0, 0, 80, 1));
+            layout.render(buffer.area, &mut buffer, pending_row);
+            assert_ne!(buffer[(0, 0)].bg, ratatui::style::Color::Reset);
+            assert!(
+                buffer
+                    .content
+                    .iter()
+                    .map(|cell| cell.symbol())
+                    .collect::<String>()
+                    .contains("rendering")
+            );
+            assert_eq!(layout.text, original);
+            assert!(retained.unwrap().contains("B[(Database)]"));
+            assert!(
+                layout
+                    .rows
+                    .iter()
+                    .any(|row| row.line.line.to_string().contains("Before"))
+            );
+            assert!(
+                layout
+                    .rows
+                    .iter()
+                    .any(|row| row.line.line.to_string().contains("After"))
+            );
+            assert!(
+                layout
+                    .rows
+                    .iter()
+                    .any(|row| row.line.line.to_string().contains("rendering"))
+            );
+        });
+    }
+}
