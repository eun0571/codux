+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub(crate) enum Section {
+    Questions,
+    Tools,
+    Answers,
+    Replies,
+    Intermediate,
+}
+impl Section {
+    const ALL: [Self; 5] = [Self::Questions, Self::Replies, Self::Tools, Self::Intermediate, Self::Answers];
+    fn bit(self) -> u8 { 1 << Self::ALL.iter().position(|s| *s == self).unwrap() }
+    pub(crate) fn index(self) -> usize {
+        match self {
+            Self::Questions => 0,
+            Self::Tools => 1,
+            Self::Answers => 2,
+            Self::Replies | Self::Intermediate => unreachable!(),
+        }
+    }
+    fn label(self) -> &'static str {
+        match self {
+            Self::Questions => "Question",
+            Self::Tools => "Tools",
+            Self::Answers => "Answer",
+            Self::Replies => "Reply",
+            Self::Intermediate => "Intermediate answer",
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub(crate) enum Element {
+    Display,
+    Expandable,
+    Enabled,
+    InitialState,
+    Width,
+    Padding,
+    Horizontal,
+    Vertical,
+    Background,
+    CustomColor,
+    Title,
+    Visibility,
+    Text,
+}
+impl Element {
+    fn shareable(self) -> bool { self != Self::Display }
+    fn label(self) -> &'static str {
+        match self {
+            Self::Display => "Display",
+            Self::Expandable => "Expandable",
+            Self::Enabled => "Enabled",
+            Self::InitialState => "Initial state",
+            Self::Width => "Maximum width",
+            Self::Padding => "Padding",
+            Self::Horizontal => "Horizontal",
+            Self::Vertical => "Vertical",
+            Self::Background => "Background",
+            Self::CustomColor => "Custom HEX",
+            Self::Title => "Title",
+            Self::Visibility => "Show title",
+            Self::Text => "Title text",
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub(crate) enum Page {
+    Root,
+    Theme,
+    CardMode,
+    Reset,
+    WorkingAnimation,
+    Mermaid,
+    Group(Section),
+    Card(Section),
+    Values(Section, Element),
+    Scoped(Section, Element, u8),
+    Scope(Section, Element, u8),
+    Targets(Section, Element, u8, u8),
+}
+
+// Navigation belongs to one /custom invocation, independently of persisted card styles.
+#[cfg(not(test))]
+static CURSORS: LazyLock<RwLock<std::collections::HashMap<Page, usize>>> =
+    LazyLock::new(|| RwLock::new(std::collections::HashMap::new()));
+#[cfg(test)]
+thread_local! {
+    static CURSORS: std::cell::RefCell<std::collections::HashMap<Page, usize>> = std::cell::RefCell::new(std::collections::HashMap::new());
+}
+fn remembered_cursor(page: Page) -> Option<usize> {
+    let page = page.base();
+    #[cfg(test)]
+    {
+        CURSORS.with(|c| c.borrow().get(&page).copied())
+    }
+    #[cfg(not(test))]
+    {
+        CURSORS
+            .read()
+            .unwrap_or_else(|e| e.into_inner())
+            .get(&page)
+            .copied()
+    }
+}
+fn remember_cursor(page: Page, index: usize) {
+    let page = page.base();
+    #[cfg(test)]
+    CURSORS.with(|c| {
+        c.borrow_mut().insert(page, index);
+    });
+    #[cfg(not(test))]
+    CURSORS
+        .write()
+        .unwrap_or_else(|e| e.into_inner())
+        .insert(page, index);
+}
+impl Page {
+    pub(super) fn editor(self) -> Option<(Section, Element, u8)> {
+        match self {
+            Self::Values(s, e) => Some((s, e, s.bit())),
+            Self::Scoped(s, e, mask) => Some((s, e, mask)),
+            _ => None,
+        }
+    }
+    fn scoped(s: Section, e: Element, mask: u8) -> Self {
+        if mask == s.bit() { Self::Values(s, e) } else { Self::Scoped(s, e, mask) }
+    }
+    fn base(self) -> Self {
+        if let Self::Scoped(s, e, _) = self { Self::Values(s, e) } else { self }
+    }
+    pub(crate) fn parent(self) -> Option<Self> {
+        match self {
+            Self::Scoped(s, e, mask) => Self::Values(s, e).parent().map(|parent| {
+                if let Self::Values(s, e) = parent { Self::scoped(s, e, mask) } else { parent }
+            }),
+            Self::Scope(s, e, mask) => Some(Self::scoped(s, e, mask)),
+            Self::Targets(s, e, previous, _) => Some(Self::Scope(s, e, previous)),
+            Self::Root => None,
+            Self::Theme | Self::CardMode | Self::Reset => Some(Self::Root),
+            Self::WorkingAnimation | Self::Mermaid => Some(Self::Group(Section::Answers)),
+            Self::Group(_) | Self::Card(Section::Tools) => Some(Self::Root),
+            Self::Card(Section::Questions | Section::Replies) => {
+                Some(Self::Group(Section::Questions))
+            }
+            Self::Card(Section::Answers | Section::Intermediate) => {
+                Some(Self::Group(Section::Answers))
+            }
+            Self::Values(s, Element::Enabled | Element::InitialState) => {
+                Some(Self::Values(s, Element::Expandable))
+            }
+            Self::Values(s, Element::Horizontal | Element::Vertical) => {
+                Some(Self::Values(s, Element::Padding))
+            }
+            Self::Values(s, Element::Visibility | Element::Text) => {
+                Some(Self::Values(s, Element::Title))
+            }
+            Self::Values(s, Element::CustomColor) => Some(Self::Values(s, Element::Background)),
+            Self::Values(s, _) => Some(Self::Card(s)),
+        }
+    }
+    pub(crate) fn is_input(self) -> bool {
+        matches!(self.base(), Self::Values(_, Element::Text | Element::CustomColor))
+    }
+    fn has_values(self) -> bool {
+        matches!(self, Self::Theme | Self::CardMode | Self::Reset | Self::WorkingAnimation | Self::Mermaid)
+            || matches!(self.base(),Self::Values(_,e) if !matches!(e,Element::Padding|Element::Title|Element::Expandable))
+    }
+    pub(crate) fn title(self) -> String {
+        match self {
+            Self::Scoped(s, e, _) => Self::Values(s, e).title(),
+            Self::Scope(s, e, _) => format!("{} / Apply to", Self::Values(s, e).title()),
+            Self::Targets(_, _, _, _) => "Custom UI / Select cards".into(),
+            Self::Root => "Custom UI".into(),
+            Self::Theme => "Custom UI / Theme".into(),
+            Self::CardMode => "Custom UI / Card display".into(),
+            Self::Reset => "Custom UI / Reset to defaults".into(),
+            Self::WorkingAnimation => "Custom UI / Answer / Working animation".into(),
+            Self::Mermaid => "Custom UI / Answer / Mermaid".into(),
+            Self::Group(s) => format!("Custom UI / {}", s.label()),
+            Self::Card(s) => format!("Custom UI / {}", s.label()),
+            Self::Values(s, e) => format!("Custom UI / {} / {}", s.label(), e.label()),
+        }
+    }
+}
+
+impl Settings {
+    #[cfg(test)]
+    pub(crate) fn comparison() -> Self {
+        Self {
+            cards: Some(std::array::from_fn(CardStyle::preview)),
+            show_tools: true,
+            ..Self::web()
+        }
+    }
+    pub(crate) fn card(&self, section: Section) -> CardStyle {
+        let mut card = self.stored_card(section);
+        card.default_expanded
+            .get_or_insert(section != Section::Tools);
+        card.align = if matches!(section, Section::Questions | Section::Replies) {
+            Align::Right
+        } else {
+            Align::Left
+        };
+        card
+    }
+
+    fn stored_card(&self, section: Section) -> CardStyle {
+        if section == Section::Replies {
+            return self.reply.clone().unwrap_or_else(|| {
+                let mut c = self.card(Section::Questions);
+                c.title = "REPLY".into();
+                c.title_visible = true;
+                c.background = Background::Rgb(49, 65, 82);
+                c
+            });
+        }
+        if section == Section::Intermediate {
+            return self.intermediate.clone().unwrap_or_else(|| {
+                let mut c = self.card(Section::Answers);
+                c.title = "PROGRESS".into();
+                c
+            });
+        }
+        if let Some(cards) = &self.cards {
+            return cards[section.index()].clone();
+        }
+        let mut card = CardStyle::preview(section.index());
+        let (bg, title, pad) = match section {
+            Section::Questions => {
+                card.align = if self.question_bubble {
+                    Align::Right
+                } else {
+                    Align::Left
+                };
+                card.max_width = if self.question_bubble {
+                    self.question_width
+                } else {
+                    100
+                };
+                (
+                    self.question_highlight,
+                    self.question_title,
+                    self.question_padding,
+                )
+            }
+            Section::Tools => (self.tools_highlight, self.tools_title, self.tools_padding),
+            Section::Answers => (
+                self.answer_card && self.answer_highlight,
+                self.answer_card && self.answer_title,
+                if self.answer_card {
+                    self.answer_padding
+                } else {
+                    0
+                },
+            ),
+            Section::Replies | Section::Intermediate => unreachable!(),
+        };
+        card.background = if bg {
+            Background::Auto
+        } else {
+            Background::None
+        };
+        card.title_visible = title;
+        card.padding_x = pad;
+        card.padding_y = pad * 2;
+        card
+    }
+    pub(crate) fn change_card(
+        &self,
+        section: Section,
+        change: impl FnOnce(&mut CardStyle),
+    ) -> Self {
+        let mut next = self.clone();
+        if matches!(section, Section::Replies | Section::Intermediate) {
+            let mut card = self.card(section);
+            change(&mut card);
+            if section == Section::Replies {
+                next.reply = Some(card);
+            } else {
+                next.intermediate = Some(card);
+            }
+            return next;
+        }
+        let mut cards = self.cards.clone().unwrap_or_else(|| {
+            [
+                self.card(Section::Questions),
+                self.card(Section::Tools),
+                self.card(Section::Answers),
+            ]
+        });
+        change(&mut cards[section.index()]);
+        next.cards = Some(cards);
+        next
+    }
+}
+
+pub(super) fn scope_label(section: Section, mask: u8) -> String {
+    if mask == section.bit() { "Current card".into() }
+    else if mask == 31 { "All cards".into() }
+    else { format!("{} selected cards", mask.count_ones()) }
+}
+
+pub(super) fn apply_scoped(original: &Settings, changed: &Settings, page: Page) -> Settings {
+    let Some((source, element, mask)) = page.editor() else { return changed.clone(); };
+    if !element.shareable() { return changed.clone(); }
+    let source = changed.card(source);
+    // Materialize inherited styles before changing a parent, so unselected replies/progress
+    // retain their own appearance even when loading an old settings file.
+    let mut next = original.clone();
+    next.reply = Some(original.card(Section::Replies));
+    next.intermediate = Some(original.card(Section::Intermediate));
+    for section in Section::ALL.into_iter().filter(|s| mask & s.bit() != 0) {
+        next = next.change_card(section, |c| match element {
+            Element::Enabled => c.expandable = source.expandable,
+            Element::InitialState => c.default_expanded = source.default_expanded,
+            Element::Width => c.max_width = source.max_width,
+            Element::Horizontal => c.padding_x = source.padding_x,
+            Element::Vertical => c.padding_y = source.padding_y,
+            Element::Background | Element::CustomColor => c.background = source.background,
+            Element::Visibility => c.title_visible = source.title_visible,
+            Element::Text => c.title = source.title.clone(),
+            _ => {},
+        });
+    }
+    next
+}
+
+fn value(section: Section, element: Element, settings: &Settings) -> String {
+    let c = settings.card(section);
+    match element {
+        Element::Display => if settings.visible(section) {
+            "Shown"
+        } else {
+            "Hidden"
+        }
+        .into(),
+        Element::Expandable | Element::Enabled => if c.expandable { "On" } else { "Off" }.into(),
+        Element::InitialState => if c.initially_expanded() {
+            "Expanded"
+        } else {
+            "Collapsed"
+        }
+        .into(),
+        Element::Width => format!("{}%", c.max_width),
+        Element::Horizontal => format!("{} columns", c.padding_x),
+        Element::Vertical => format!("{} rows", f32::from(c.half_rows()) / 2.0),
+        Element::Background => style::background_name(c.background),
+        Element::Visibility => if c.title_visible { "On" } else { "Off" }.into(),
+        Element::Text => c.title,
+        Element::Padding => format!(
+            "{} columns / {} rows",
+            c.padding_x,
+            f32::from(c.half_rows()) / 2.0
+        ),
+        Element::Title => {
+            if c.title_visible {
+                c.title
+            } else {
+                "Off".into()
+            }
+        }
+        _ => String::new(),
+    }
+}
+
+fn choices(
+    _home: &Path,
+    page: Page,
+    original: &Settings,
+) -> anyhow::Result<Vec<(String, Settings)>> {
+    if page == Page::Reset {
+        return Ok(vec![
+            ("Keep current settings".into(), original.clone()),
+            ("Restore shipped defaults".into(), Settings::default()),
+        ]);
+    }
+    if page == Page::CardMode {
+        let mut modes = CardMode::ALL.to_vec();
+        if original.card_mode() == CardMode::Custom {
+            modes.push(CardMode::Custom);
+        }
+        return Ok(modes.into_iter().map(|mode| {
+            (mode.label().into(), original.with_card_mode(mode))
+        }).collect());
+    }
+    if page == Page::Mermaid {
+        return Ok([
+            crate::codux_mermaid::Mode::Auto,
+            crate::codux_mermaid::Mode::Text,
+        ]
+        .into_iter()
+        .map(|mode| {
+            let mut next = original.clone();
+            next.mermaid = mode;
+            (mode.label().into(), next)
+        })
+        .collect());
+    }
+    if page == Page::WorkingAnimation {
+        return Ok(status::WorkingAnimation::ALL
+            .into_iter()
+            .map(|animation| {
+                let mut next = original.clone();
+                next.working_animation = animation;
+                (animation.label().into(), next)
+            })
+            .collect());
+    }
+    if page == Page::Theme {
+        return Ok(theme::choices(original)
+            .into_iter()
+            .map(|c| (c.name, c.settings))
+            .collect());
+    }
+    let Some((section, element, _)) = page.editor() else {
+        anyhow::bail!("Expected a value menu");
+    };
+    let mut list = Vec::new();
+    match element {
+        Element::Display => {
+            for shown in [true, false] {
+                let mut next = original.clone();
+                match section {
+                    Section::Tools => next.show_tools = shown,
+                    Section::Intermediate => next.show_intermediate = shown,
+                    _ => anyhow::bail!("Display applies only to tools and intermediate answers"),
+                }
+                list.push((if shown { "Shown" } else { "Hidden" }.into(), next));
+            }
+        }
+        Element::Enabled => {
+            for enabled in [true, false] {
+                list.push((
+                    if enabled { "On" } else { "Off" }.into(),
+                    original.change_card(section, |c| c.expandable = enabled),
+                ));
+            }
+        }
+        Element::InitialState => {
+            for expanded in [true, false] {
+                list.push((
+                    if expanded { "Expanded" } else { "Collapsed" }.into(),
+                    original.change_card(section, |c| c.default_expanded = Some(expanded)),
+                ));
+            }
+        }
+        Element::Width => {
+            for width in [50, 60, 70, 80, 100] {
+                list.push((
+                    format!("{width}%"),
+                    original.change_card(section, |c| c.max_width = width),
+                ));
+            }
+        }
+        Element::Horizontal => {
+            for pad in 0..=6 {
+                list.push((
+                    format!("{pad} columns"),
+                    original.change_card(section, |c| c.padding_x = pad),
+                ));
+            }
+        }
+        Element::Vertical => {
+            for pad in 0..=6 {
+                list.push((
+                    format!("{} rows", f32::from(pad) / 2.0),
+                    original.change_card(section, |c| c.padding_y = pad),
+                ));
+            }
+        }
+        Element::Background => {
+            for &(name, bg) in style::COLORS {
+                list.push((
+                    name.into(),
+                    original.change_card(section, |c| c.background = bg),
+                ));
+            }
+        }
+        Element::Visibility => {
+            for enabled in [false, true] {
+                list.push((
+                    if enabled { "On" } else { "Off" }.into(),
+                    original.change_card(section, |c| c.title_visible = enabled),
+                ));
+            }
+        }
+        _ => anyhow::bail!("This setting has a submenu or text input"),
+    }
+    Ok(list.into_iter().map(|(label, changed)| (label, apply_scoped(original, &changed, page))).collect())
+}
+
+fn navigation(name: String, description: Option<String>, page: Page) -> SelectionItem {
+    SelectionItem {
+        name,
+        description,
+        dismiss_on_select: true,
+        actions: vec![Box::new(move |tx| tx.send(AppEvent::MycodxUiMenu { page }))],
+        ..Default::default()
+    }
+}
+/// Called only when /custom (or the preview's F2 menu) opens a new invocation.
+pub(crate) fn begin_session() {
+    #[cfg(test)]
+    CURSORS.with(|c| c.borrow_mut().clear());
+    #[cfg(not(test))]
+    CURSORS.write().unwrap_or_else(|e| e.into_inner()).clear();
+}
+pub(crate) fn page_picker(home: &Path, page: Page) -> anyhow::Result<SelectionViewParams> {
+    anyhow::ensure!(
+        !page.is_input(),
+        "Use the single-line editor for this setting"
+    );
+    let original = current();
+    let base_page = page.base();
+    if let Some((_, _, mask)) = page.editor() {
+        anyhow::ensure!(mask != 0 && mask & !31 == 0, "Choose at least one card");
+    }
+    let cancelled = original.clone();
+    let mut params = SelectionViewParams {
+        title: Some(page.title()),
+        footer_hint: Some(ratatui::text::Line::from(if page == Page::Root {
+            "Up/Down navigate | Enter open | Esc close"
+        } else if page.has_values() {
+            "Up/Down preview | Enter save | Esc back"
+        } else {
+            "Up/Down navigate | Enter open | Esc back"
+        })),
+        on_cancel: Some(Box::new(move |tx| {
+            if page.has_values() {
+                set(cancelled.clone());
+                tx.send(AppEvent::MycodxUiPreviewed);
+            }
+            if let Some(parent) = page.parent() {
+                tx.send(AppEvent::MycodxUiMenu { page: parent });
+            }
+        })),
+        ..SelectionViewParams::picker()
+    };
+    if let Page::Scope(s, e, mask) = page {
+        params.items = vec![
+            navigation("Current card".into(), Some(s.label().into()), Page::Values(s, e)),
+            navigation("Selected cards...".into(), Some(scope_label(s, mask)), Page::Targets(s, e, mask, mask)),
+            navigation("All cards".into(), Some("All five card types".into()), Page::scoped(s, e, 31)),
+        ];
+        params.subtitle = Some("Choose the target cards, then choose a value to preview and save.".into());
+    } else if let Page::Targets(s, e, previous, mask) = page {
+        let mut done = navigation("Use selected cards".into(), Some(format!("{} selected", mask.count_ones())), Page::scoped(s, e, mask));
+        done.is_disabled = mask == 0;
+        params.items.push(done);
+        for (index, target) in Section::ALL.into_iter().enumerate() {
+            let destination = Page::Targets(s, e, previous, mask ^ target.bit());
+            let mut item = navigation(format!("[{}] {}", if mask & target.bit() != 0 { "x" } else { " " }, target.label()), None, destination);
+            item.actions.insert(0, Box::new(move |_| remember_cursor(destination, index + 1)));
+            params.items.push(item);
+        }
+        params.subtitle = Some("Select the cards that should receive this element's value.".into());
+        params.footer_hint = Some("Up/Down navigate | Enter toggle/use | Esc back".into());
+    } else if page.has_values() {
+        let themes = (page == Page::Theme).then(|| theme::choices(&original));
+        let values = if let Some(themes) = &themes {
+            themes
+                .iter()
+                .map(|c| (c.name.clone(), c.settings.clone()))
+                .collect()
+        } else {
+            choices(home, page, &original)?
+        };
+        let selected = if let Some((s, e, _)) = page.editor() {
+            Some(value(s, e, &original))
+        } else {
+            None
+        };
+        params.items = values
+            .iter()
+            .map(|(name, settings)| {
+                let saved = settings.clone();
+                let previous = original.clone();
+                SelectionItem {
+                    name: name.clone(),
+                    is_current: selected
+                        .as_ref()
+                        .map_or(settings == &original, |v| v == name),
+                    dismiss_on_select: true,
+                    actions: vec![Box::new(move |tx| {
+                        tx.send(AppEvent::MycodxUiSelected {
+                            settings: saved.clone(),
+                            previous: previous.clone(),
+                            return_to: page.parent().unwrap_or(Page::Root),
+                        })
+                    })],
+                    ..Default::default()
+                }
+            })
+            .collect();
+        params.initial_selected_idx =
+            Some(params.items.iter().position(|i| i.is_current).unwrap_or(0));
+        if page == Page::Theme {
+            if let Some((_, settings)) = values.get(params.initial_selected_idx.unwrap_or(0)) {
+                set(settings.clone());
+            }
+            params.footer_hint = Some(ratatui::text::Line::from(
+                "Up/Down preview | Enter apply | Esc back",
+            ));
+        }
+        if let Some((s, e, mask)) = page.editor().filter(|(_, e, _)| e.shareable()) {
+            params.items.push(navigation(format!("Apply to: {}", scope_label(s, mask)), Some("Choose current, selected, or all cards".into()), Page::Scope(s, e, mask)));
+        }
+        if let Some((s, e @ Element::Background, mask)) = page.editor() {
+            params.items.push(navigation(
+                "Custom HEX...".into(),
+                Some(value(s, e, &original)),
+                Page::scoped(s, Element::CustomColor, mask),
+            ));
+        }
+        let restore = original.clone();
+        params.on_selection_changed = Some(Box::new(move |index, tx| {
+            if let Some((_, settings)) = values.get(index) {
+                set(settings.clone());
+            } else {
+                set(restore.clone());
+            }
+            tx.send(AppEvent::MycodxUiPreviewed);
+        }));
+        params.subtitle =
+            Some("Changes appear in the conversation. Enter saves; Esc restores.".into());
+        if let Some((s, _, mask)) = page.editor().filter(|(_, e, _)| e.shareable()) {
+            let targets = Section::ALL.into_iter().filter(|s| mask & s.bit() != 0).map(Section::label).collect::<Vec<_>>().join(", ");
+            params.subtitle = Some(format!("Apply to: {} ({targets}). Enter saves; Esc restores.", scope_label(s, mask)));
+        }
+        if page == Page::Reset {
+            params.subtitle = Some("Preview this version's first-install settings. Enter saves; Esc restores your settings.".into());
+            params.footer_note = Some("Resets Codux card styles, display mode, animation and Mermaid settings. Codex configuration, /theme and conversations are unchanged.".into());
+        }
+        if page == Page::CardMode {
+            params.subtitle = Some("Questions, replies and final answers are always shown. Folding and styles are unchanged.".into());
+            for (index, item) in params.items.iter_mut().enumerate() {
+                let mode = CardMode::ALL.get(index).copied().unwrap_or(CardMode::Custom);
+                item.description = Some(mode.description().into());
+            }
+        }
+        if page == Page::WorkingAnimation {
+            params.subtitle = Some(
+                "Choose an animation. Preview it beside the list; Enter saves, Esc restores."
+                    .into(),
+            );
+            for (item, animation) in params.items.iter_mut().zip(status::WorkingAnimation::ALL) {
+                item.description = Some(animation.description().into());
+            }
+        }
+        if page == Page::Mermaid {
+            params.subtitle = Some(
+                "Auto renders images with your current styling; if unavailable, keep Codex text."
+                    .into(),
+            );
+            params.items[0].description = Some("Mermaid image, with Codex text fallback".into());
+            params.items[1].description = Some("Use the built-in Codex text renderer only".into());
+        }
+        if page == Page::Theme {
+            let syntax = crate::render::highlight::current_syntax_theme();
+            let name = syntax.name.as_deref().unwrap_or("current /theme");
+            params.subtitle = Some(format!(
+                "Current /theme: {name}. Preview card palettes in the conversation."
+            ));
+            params.footer_note = Some("All five card backgrounds; focus automatically brightens each color. Default uses fixed colors; other palettes adapt to /theme. Syntax colors stay unchanged.".into());
+            for (item, choice) in params.items.iter_mut().zip(themes.iter().flatten()) {
+                item.description = Some(choice.description.clone());
+            }
+        }
+        if matches!(base_page, Page::Values(_, Element::Vertical)) {
+            params.footer_note = Some(
+                "Half rows change the visible background edge; terminal rows remain full height."
+                    .into(),
+            );
+        }
+    } else if page == Page::Root {
+        params.items = [
+            ("Theme", Page::Theme),
+            ("Question", Page::Group(Section::Questions)),
+            ("Tools", Page::Card(Section::Tools)),
+            ("Answer", Page::Group(Section::Answers)),
+        ]
+        .into_iter()
+        .map(|(name, page)| navigation(name.into(), None, page))
+        .collect();
+        params.items.push(navigation(
+            "Card display".into(), Some(original.card_mode().label().into()), Page::CardMode,
+        ));
+        params.items.push(navigation(
+            "Reset to defaults".into(), Some("Preview and restore first-install settings".into()), Page::Reset,
+        ));
+        params.subtitle = Some(if original.is_shipped_default() {
+            "Default: using this version's first-install settings."
+        } else {
+            "Customized: your settings differ from this version's first-install defaults."
+        }.into());
+    } else if let Page::Group(section) = page {
+        let entries = match section {
+            Section::Questions => [
+                ("Prompt style", Section::Questions),
+                ("Reply style", Section::Replies),
+            ],
+            Section::Answers => [
+                ("Final answer style", Section::Answers),
+                ("Intermediate answer", Section::Intermediate),
+            ],
+            _ => anyhow::bail!("Invalid settings group"),
+        };
+        params.items = entries
+            .into_iter()
+            .map(|(name, s)| navigation(name.into(), None, Page::Card(s)))
+            .collect();
+        if section == Section::Answers {
+            params.items.push(navigation(
+                "Mermaid".into(),
+                Some(original.mermaid.label().into()),
+                Page::Mermaid,
+            ));
+            params.items.push(navigation(
+                "Working animation".into(),
+                Some(original.working_animation.label().into()),
+                Page::WorkingAnimation,
+            ));
+        }
+        params.subtitle = Some(
+            if section == Section::Questions {
+                "Prompts and replies are always shown; their styles are independent."
+            } else {
+                "Final answers are always shown. Intermediate answers can be hidden."
+            }
+            .into(),
+        );
+    } else {
+        let (section, elements) = match base_page {
+            Page::Card(s) => (
+                s,
+                vec![
+                    Element::Expandable,
+                    Element::Width,
+                    Element::Padding,
+                    Element::Background,
+                    Element::Title,
+                ],
+            ),
+            Page::Values(s, Element::Expandable) => (
+                s,
+                if original.card(s).expandable {
+                    vec![Element::Enabled, Element::InitialState]
+                } else {
+                    vec![Element::Enabled]
+                },
+            ),
+            Page::Values(s, Element::Padding) => (s, vec![Element::Horizontal, Element::Vertical]),
+            Page::Values(s, Element::Title) => (s, vec![Element::Visibility, Element::Text]),
+            _ => unreachable!(),
+        };
+        let mut elements = elements;
+        if matches!(page, Page::Card(Section::Tools | Section::Intermediate)) {
+            elements.insert(0, Element::Display);
+        }
+        if page == Page::Card(Section::Tools) {
+            params.footer_note = Some("F4 browses cards. Up/Down: scroll. Ctrl+arrows: select a card. Enter: fold. Double-click blank background: fold.".into());
+        }
+        params.items = elements
+            .into_iter()
+            .map(|e| {
+                navigation(
+                    e.label().into(),
+                    Some(value(section, e, &original)),
+                    Page::scoped(section, e, page.editor().map_or(section.bit(), |(_, _, mask)| mask)),
+                )
+            })
+            .collect();
+        if let Some((s, e, mask)) = page.editor().filter(|(_, e, _)| e.shareable()) {
+            params.items.push(navigation(format!("Apply to: {}", scope_label(s, mask)), Some("Only the element you edit is applied".into()), Page::Scope(s, e, mask)));
+        }
+    }
+    // Value lists open at the saved setting; navigation lists reopen at the last route.
+    // Background also contains the Custom HEX editor, so it participates in the hierarchy.
+    if !page.has_values() || matches!(base_page, Page::Values(_, Element::Background)) {
+        if let Some(index) = remembered_cursor(page).filter(|i| *i < params.items.len()) {
+            params.initial_selected_idx = Some(index);
+        }
+        let preview = params.on_selection_changed.take();
+        params.on_selection_changed = Some(Box::new(move |index, tx| {
+            remember_cursor(page, index);
+            if let Some(preview) = &preview {
+                preview(index, tx);
+            }
+        }));
+    }
+    Ok(params)
+}
