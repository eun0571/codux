+    }
+    #[derive(Deserialize)]
+    struct CoduxVersion {
+        version: String,
+    }
+    let latest: CoduxVersion = serde_json::from_slice(&output.stdout)?;
+    // Validate the response before it can become an update notification.
+    if is_newer(&latest.version, current_version()).is_none() {
+        anyhow::bail!("Invalid Codux release version");
+    }
+    Ok(latest.version)
