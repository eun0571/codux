+#[test]
+#[ignore = "explicit transcript scrolling benchmark"]
+fn codux_scroll_benchmark() {
+    crate::mycodx_ui::with_settings(Settings::web(), || {
+        let renders = Arc::new(AtomicUsize::new(0));
+        let mut cells = Vec::new();
+        for turn in 0..200 {
+            cells.push(user(&format!("Question {turn}")));
+            for step in 0..20 {
+                cells.push(progress(&format!("Progress {turn}/{step}\nMore details.")));
+                cells.push(tool(&format!("tool-{turn}-{step}"), &renders));
+            }
+            cells.push(answer(&format!("Answer {turn}\nResult\nMore result")));
+        }
+        let area = Rect::new(0, 0, 120, 40);
+        let mut view = TranscriptView::default();
+        let mut buf = Buffer::empty(area);
+        view.render(area, &mut buf, &cells);
+        let mut times = Vec::new();
+        for _ in 0..100 {
+            let start = std::time::Instant::now();
+            view.scroll(&cells, -3);
+            view.render(area, &mut buf, &cells);
+            times.push(start.elapsed().as_micros());
+        }
+        times.sort();
+        println!(
+            "SCROLL cells={} p50_us={} p95_us={} hidden_tool_renders={}",
+            cells.len(),
+            times[50],
+            times[95],
+            renders.load(Ordering::Relaxed)
+        );
+        assert_eq!(renders.load(Ordering::Relaxed), 0);
+    });
+}
