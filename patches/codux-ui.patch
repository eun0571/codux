+++ b/codex-rs/tui/src/codux_mermaid_image_cache.rs
@@ -0,0 +1,192 @@
+//! Four on-demand terminal encodings per diagram and protocol, reused across sessions.
+use super::{Geometry, ImageRow, Protocol};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::io::Write;
+use std::path::{Path, PathBuf};
+
+const MAX_BYTES: u64 = 12 * 1024 * 1024;
+
+#[derive(Serialize, Deserialize)]
+struct StoredRow {
+    columns: u16,
+    payload: String,
+}
+
+#[derive(Serialize, Deserialize)]
+struct Stored {
+    key: String,
+    rows: Vec<StoredRow>,
+}
+
+pub(super) struct Cache {
+    path: PathBuf,
+    key: String,
+    geometry: Geometry,
+    protocol: Protocol,
+}
+
+impl Cache {
+    pub(super) fn new(
+        png: &Path,
+        geometry: Geometry,
+        protocol: Protocol,
+        bucket: u8,
+        density: u32,
+    ) -> Option<Self> {
+        if bucket == 0 || std::fs::metadata(png).ok()?.len() > 64 * 1024 * 1024 {
+            return None;
+        }
+        let bytes = std::fs::read(png).ok()?;
+        let parameters = format!(
+            "terminal-v1:{protocol:?}:{bucket}:{density}:{}:{}",
+            geometry.cell_width, geometry.cell_height
+        );
+        let key = format!(
+            "{:x}",
+            Sha256::new()
+                .chain_update(&bytes)
+                .chain_update(parameters)
+                .finalize()
+        );
+        let stem = png.file_stem()?.to_str()?;
+        let path = png
+            .parent()?
+            .join("terminal")
+            .join(format!("{stem}-{protocol:?}-{bucket}.json"));
+        Some(Self {
+            path,
+            key,
+            geometry,
+            protocol,
+        })
+    }
+
+    pub(super) fn read(&self) -> Option<Vec<ImageRow>> {
+        if std::fs::metadata(&self.path).ok()?.len() > MAX_BYTES {
+            return None;
+        }
+        let stored: Stored = serde_json::from_slice(&std::fs::read(&self.path).ok()?).ok()?;
+        if stored.key != self.key || stored.rows.is_empty() || stored.rows.len() > 160 {
+            return None;
+        }
+        let total: usize = stored.rows.iter().map(|row| row.payload.len()).sum();
+        if total > 8 * 1024 * 1024 || stored.rows.iter().any(|row| !self.valid_row(row)) {
+            return None;
+        }
+        Some(
+            stored
+                .rows
+                .into_iter()
+                .map(|row| ImageRow {
+                    columns: row.columns,
+                    payload: row.payload.into(),
+                })
+                .collect(),
+        )
+    }
+
+    // Cached terminal data must contain only the one expected graphics command.
+    // Reject arbitrary escape sequences, out-of-bounds geometry, or corrupt data.
+    fn valid_row(&self, row: &StoredRow) -> bool {
+        if row.columns == 0 || row.columns > self.geometry.columns {
+            return false;
+        }
+        match self.protocol {
+            Protocol::Sixel => {
+                let prefix = format!(
+                    "\x1bP9;1;0q\"1;1;{};{}",
+                    u32::from(row.columns) * u32::from(self.geometry.cell_width),
+                    self.geometry.cell_height
+                );
+                row.payload
+                    .strip_prefix(&prefix)
+                    .and_then(|s| s.strip_suffix("\x1b\\"))
+                    .is_some_and(|body| body.bytes().all(|b| (b'!'..=b'~').contains(&b)))
+            }
+            Protocol::Iterm => {
+                let prefix = format!(
+                    "\x1b]1337;File=inline=1;width={};height=1;preserveAspectRatio=0;doNotMoveCursor=1:",
+                    row.columns
+                );
+                row.payload
+                    .strip_prefix(&prefix)
+                    .and_then(|s| s.strip_suffix('\x07'))
+                    .is_some_and(|body| {
+                        body.starts_with("iVBORw0KGgo")
+                            && body
+                                .bytes()
+                                .all(|b| b.is_ascii_alphanumeric() || b"+/=".contains(&b))
+                    })
+            }
+        }
+    }
+
+    pub(super) fn write(&self, rows: &[ImageRow]) {
+        let stored = Stored {
+            key: self.key.clone(),
+            rows: rows
+                .iter()
+                .map(|row| StoredRow {
+                    columns: row.columns,
+                    payload: row.payload.to_string(),
+                })
+                .collect(),
+        };
+        // Cache errors must never hide a successfully rendered diagram.
+        let save = || -> anyhow::Result<()> {
+            let parent = self.path.parent().expect("cache parent");
+            std::fs::create_dir_all(parent)?;
+            let bytes = serde_json::to_vec(&stored)?;
+            anyhow::ensure!(bytes.len() as u64 <= MAX_BYTES, "Cache size limit");
+            let mut temporary = tempfile::NamedTempFile::new_in(parent)?;
+            temporary.write_all(&bytes)?;
+            temporary.persist(&self.path)?;
+            Ok(())
+        };
+        let _ = save();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn new_cache_instances_reuse_rows_and_reject_stale_or_injected_data() {
+        let directory = tempfile::tempdir().unwrap();
+        let png = directory.path().join("diagram.png");
+        image::DynamicImage::new_rgb8(80, 40).save(&png).unwrap();
+        for protocol in [Protocol::Sixel, Protocol::Iterm] {
+            let geometry = Geometry {
+                columns: 80,
+                cell_width: 10,
+                cell_height: 20,
+                protocol: Some(protocol),
+            };
+            let rows = super::super::prepare(&png, geometry, 1).unwrap();
+            let cache = Cache::new(&png, geometry, protocol, 4, 1).unwrap();
+            let reused = cache.read().expect("reuse a previous instance's output");
+            assert_eq!(rows.len(), reused.len());
+            assert_eq!(rows[0].payload, reused[0].payload);
+            let changed_geometry = Geometry {
+                cell_width: 11,
+                ..geometry
+            };
+            assert!(
+                Cache::new(&png, changed_geometry, protocol, 4, 1)
+                    .unwrap()
+                    .read()
+                    .is_none()
+            );
+            let mut corrupt: Stored =
+                serde_json::from_slice(&std::fs::read(&cache.path).unwrap()).unwrap();
+            corrupt.rows[0].payload.push_str("\x1b]52;c;bad\x07");
+            std::fs::write(&cache.path, serde_json::to_vec(&corrupt).unwrap()).unwrap();
+            assert!(cache.read().is_none());
+            let repaired = super::super::prepare(&png, geometry, 1).unwrap();
+            assert_eq!(repaired[0].payload, rows[0].payload);
+            assert!(cache.read().is_some());
+        }
+    }
+}
