+//! Shared presentation settings. Legacy fields remain readable during the preview rollout.
+use ratatui::style::{Color, Modifier, Style};
+use serde::{Deserialize, Serialize};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub(crate) enum Align {
+    Left,
+    Right,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub(crate) enum Background {
+    None,
+    Auto,
+    Rgb(u8, u8, u8),
+}
+
+pub(crate) const COLORS: &[(&str, Background)] = &[
+    ("None", Background::None),
+    ("Auto", Background::Auto),
+    ("Gray", Background::Rgb(55, 58, 64)),
+    ("Slate", Background::Rgb(49, 65, 82)),
+    ("Blue", Background::Rgb(35, 63, 105)),
+    ("Teal", Background::Rgb(29, 77, 78)),
+    ("Green", Background::Rgb(45, 76, 49)),
+    ("Amber", Background::Rgb(100, 74, 31)),
+    ("Rose", Background::Rgb(99, 48, 65)),
+    ("Purple", Background::Rgb(72, 51, 96)),
+];
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct CardStyle {
+    #[serde(default, skip_serializing)]
+    pub align: Align,
+    #[serde(default = "default_expandable")]
+    pub expandable: bool,
+    /// Missing in older files; Settings supplies the section's historical default.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub default_expanded: Option<bool>,
+    pub max_width: u16,
+    pub padding_x: u16,
+    /// Half-row units; the character grid itself always has integral rows.
+    pub padding_y: u16,
+    pub background: Background,
+    pub title_visible: bool,
+    pub title: String,
+}
+
+fn default_expandable() -> bool {
+    true
+}
+
+impl Default for Align {
+    fn default() -> Self {
+        Self::Left
+    }
+}
+
+impl CardStyle {
+    pub(crate) fn preview(index: usize) -> Self {
+        Self {
+            expandable: true,
+            default_expanded: Some(index != 1),
+            align: if index == 0 {
+                Align::Right
+            } else {
+                Align::Left
+            },
+            max_width: if index == 0 { 70 } else { 100 },
+            padding_x: 1,
+            padding_y: 1,
+            background: Background::Auto,
+            title_visible: true,
+            title: ["YOU", "TOOLS", "CODEX"][index].into(),
+        }
+    }
+    pub(crate) fn initially_expanded(&self) -> bool {
+        self.default_expanded.unwrap_or(true)
+    }
+    pub(crate) fn validate(&self) -> anyhow::Result<()> {
+        anyhow::ensure!(
+            (30..=100).contains(&self.max_width),
+            "Maximum width must be 30..100%"
+        );
+        anyhow::ensure!(
+            self.padding_x <= 6 && self.padding_y <= 6,
+            "Padding is out of range"
+        );
+        anyhow::ensure!(
+            !self.title.chars().any(char::is_control),
+            "Title must be a single line without control characters"
+        );
+        Ok(())
+    }
+    pub(crate) fn half_rows(&self) -> u16 {
+        self.padding_y
+    }
+    pub(crate) fn maximum(&self, width: u16) -> u16 {
+        ((u32::from(width.max(1)) * u32::from(self.max_width) / 100) as u16).max(1)
+    }
+    pub(crate) fn inset(&self, width: u16) -> u16 {
+        self.padding_x.min(width.max(1).saturating_sub(1) / 2)
+    }
+    pub(crate) fn content_width(&self, width: u16) -> u16 {
+        let outer = self.maximum(width);
+        outer - 2 * self.inset(outer)
+    }
+    pub(crate) fn message_content_width(&self, width: u16) -> u16 {
+        let inner = self.content_width(width);
+        inner
+            - if self.expandable {
+                2.min(inner.saturating_sub(1))
+            } else {
+                0
+            }
+    }
+    pub(crate) fn colors(&self) -> Paint {
+        self.colors_for(false)
+    }
+    pub(crate) fn colors_for(&self, active: bool) -> Paint {
+        let detected = crate::terminal_palette::default_bg();
+        let outer = detected.unwrap_or((24, 24, 24));
+        // Unknown palettes must keep the terminal's own colors. A guessed dark
+        // surface can erase text in a light theme or a restricted color terminal.
+        let adaptive = matches!(self.background, Background::None | Background::Auto);
+        let supported = !matches!(
+            crate::terminal_palette::effective_stdout_color_level(),
+            crate::terminal_palette::StdoutColorLevel::Ansi16
+                | crate::terminal_palette::StdoutColorLevel::Unknown
+        );
+        let bg = match self.background {
+            Background::None => outer,
+            Background::Auto => {
+                let light = u32::from(outer.0) + u32::from(outer.1) + u32::from(outer.2) > 382;
+                let adjust = |v: u8| {
+                    if light {
+                        v.saturating_sub(18)
+                    } else {
+                        v.saturating_add(24)
+                    }
+                };
+                (adjust(outer.0), adjust(outer.1), adjust(outer.2))
+            }
+            Background::Rgb(r, g, b) => (r, g, b),
+        };
+        let bg = if active { brighten(bg) } else { bg };
+        let light = u32::from(bg.0) * 299 + u32::from(bg.1) * 587 + u32::from(bg.2) * 114 > 140_000;
+        let mut fg = if light { (20, 20, 20) } else { (240, 240, 240) };
+        if super::theme::contrast(fg, bg) < 4.5 {
+            fg = if super::theme::contrast((0, 0, 0), bg)
+                > super::theme::contrast((255, 255, 255), bg)
+            {
+                (0, 0, 0)
+            } else {
+                (255, 255, 255)
+            };
+        }
+        Paint {
+            outer,
+            bg,
+            fg,
+            active,
+            filled: supported
+                && (!adaptive || detected.is_some())
+                && (active || self.background != Background::None),
+        }
+    }
+}
+
+/// Mix the resting surface toward white without introducing a separate focus hue.
+/// Even a nearly white surface brightens, unless a channel is already saturated.
+pub(crate) fn brighten(rgb: (u8, u8, u8)) -> (u8, u8, u8) {
+    let channel = |v: u8| v + ((255 - u16::from(v)) * 12).div_ceil(100) as u8;
+    (channel(rgb.0), channel(rgb.1), channel(rgb.2))
+}
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Paint {
+    pub outer: (u8, u8, u8),
+    pub bg: (u8, u8, u8),
+    pub fg: (u8, u8, u8),
+    pub active: bool,
+    pub filled: bool,
+}
+pub(crate) fn color(rgb: (u8, u8, u8)) -> Color {
+    crate::terminal_palette::best_color(rgb)
+}
+impl Paint {
+    pub(crate) fn body(self) -> Style {
+        if self.filled {
+            Style::default().bg(color(self.bg)).fg(color(self.fg))
+        } else {
+            let style = Style::default().fg(Color::Reset).bg(Color::Reset);
+            if self.active {
+                style.add_modifier(Modifier::BOLD)
+            } else {
+                style
+            }
+        }
+    }
+}
+pub(crate) fn parse_hex(text: &str) -> anyhow::Result<Background> {
+    let value = text.trim().strip_prefix('#').unwrap_or("");
+    anyhow::ensure!(
+        value.len() == 6 && value.bytes().all(|v| v.is_ascii_hexdigit()),
+        "Enter a color as #RRGGBB"
+    );
+    let value = u32::from_str_radix(value, 16)?;
+    Ok(Background::Rgb(
+        (value >> 16) as u8,
+        (value >> 8) as u8,
+        value as u8,
+    ))
+}
+pub(crate) fn background_name(value: Background) -> String {
+    if let Some((name, _)) = COLORS.iter().find(|(_, bg)| *bg == value) {
+        return (*name).into();
+    }
+    match value {
+        Background::Rgb(r, g, b) => format!("#{r:02X}{g:02X}{b:02X}"),
+        _ => unreachable!(),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn codux_adaptive_surfaces_follow_light_dark_and_unknown_palettes() {
+        for outer in [
+            (12, 12, 12),
+            (248, 248, 248),
+            (90, 110, 160),
+            (120, 120, 120),
+        ] {
+            crate::terminal_palette::with_test_default_colors(
+                crate::terminal_probe::DefaultColors {
+                    bg: outer,
+                    fg: (127, 127, 127),
+                },
+                || {
+                    let card = CardStyle::preview(0);
+                    assert_eq!(card.background, Background::Auto);
+                    assert_ne!(card.colors().bg, outer);
+                    for active in [false, true] {
+                        let paint = card.colors_for(active);
+                        assert!(paint.filled);
+                        assert!(super::super::theme::contrast(paint.fg, paint.bg) >= 4.5);
+                    }
+                },
+            );
+        }
+        crate::terminal_palette::with_test_default_colors(None, || {
+            for background in [Background::Auto, Background::None] {
+                let mut card = CardStyle::preview(0);
+                card.background = background;
+                for active in [false, true] {
+                    let paint = card.colors_for(active);
+                    assert!(!paint.filled);
+                    assert_eq!(paint.body().bg, Some(Color::Reset));
+                    assert_eq!(paint.body().fg, Some(Color::Reset));
+                }
+            }
+        });
+    }
+
+    #[test]
+    fn focus_brightens_the_resting_background_on_light_and_dark_terminals() {
+        for outer in [(20, 20, 20), (240, 240, 240)] {
+            crate::terminal_palette::with_test_default_colors(
+                crate::terminal_probe::DefaultColors {
+                    bg: outer,
+                    fg: (127, 127, 127),
+                },
+                || {
+                    for normal in [
+                        Background::Auto,
+                        Background::None,
+                        Background::Rgb(49, 65, 82),
+                    ] {
+                        let mut card = CardStyle::preview(0);
+                        card.background = normal;
+                        let resting = card.colors();
+                        let active = card.colors_for(true);
+                        assert!(active.filled);
+                        assert!(active.bg.0 > resting.bg.0);
+                        assert!(active.bg.1 > resting.bg.1);
+                        assert!(active.bg.2 > resting.bg.2);
+                        assert_eq!(active.bg, brighten(resting.bg));
+                        assert_eq!(card.colors().bg, resting.bg);
+                    }
+                },
+            );
+        }
+        assert_eq!(brighten((254, 255, 0)), (255, 255, 31));
+        assert_eq!(brighten((255, 255, 255)), (255, 255, 255));
+    }
+}
