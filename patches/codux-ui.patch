+fn codux_drag_selection_paints_the_whole_right_aligned_question() {
+    use ratatui::style::Modifier;
+
+    crate::mycodx_ui::with_settings(Settings::default(), || {
+        let source = "select this text";
+        let cells = vec![user(source)];
+        for width in [40, 80] {
+            for reverse in [false, true] {
+                let area = Rect::new(5, 3, width, 12);
+                let mut view = TranscriptView::default();
+                let mut actual = Buffer::empty(area);
+                view.render(area, &mut actual, &cells);
+                let (y, row) = view
+                    .visible
+                    .iter()
+                    .enumerate()
+                    .find(|(_, row)| row.row == row.layout.row_for_offset(0))
+                    .unwrap();
+                let left = area.x + row.layout.column_for_offset(0);
+                let right = left + source.len() as u16;
+                let y = view.area.y + y as u16;
+                let (start, end) = if reverse {
+                    (right, left)
+                } else {
+                    (left, right)
+                };
