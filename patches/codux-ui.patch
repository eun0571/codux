+#[test]
+fn mycodx_navigation_keeps_the_card_heading_at_the_anchor() {
+    let cells = vec![user("question"), answer("first line\nsecond line")];
+    let mut view = TranscriptView::default();
+    view.area = Rect::new(0, 0, 60, 6);
+    view.jump_to_entry(&cells, 1);
+    view.disclosure.focused = Some(view.activity_ids(&cells, 1));
+    for _ in 0..3 {
